+import re
+
+# "45m", "1h", "1h30", "1h 30m"; a bare number is only valid after an hours part
+_DURATION = re.compile(r"(?:(?P<h>[0-9]+)h\s*(?:(?P<hm>[0-9]+)m?)?|(?P<m>[0-9]+)m)")
+
+
+def parse_duration(text):
+    """Return the number of minutes in a duration string such as '45m', '1h', '1h30' or '1h 30m'."""
+    match = _DURATION.fullmatch(text.strip())
+    if match is None:
+        raise ValueError(f"invalid duration: {text!r}")
+    minutes = 60 * int(match["h"] or 0) + int(match["hm"] or 0) + int(match["m"] or 0)
+    if minutes == 0:
+        raise ValueError(f"duration must be positive: {text!r}")
+    return minutes
diff --git a/tests/test_intervals.py b/tests/test_intervals.py
