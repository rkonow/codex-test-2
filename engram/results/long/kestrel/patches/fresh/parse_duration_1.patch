@@ -0,0 +1,24 @@
+"""Appointment intervals."""
+
+import re
+
+_DURATION = re.compile(r"(?:(\d+)m|(\d+)h(?:\s*(\d+)m?)?)", re.ASCII)
+
+
+def parse_duration(text):
+    """Return the number of minutes in a duration string.
+
+    Accepts '45m', '1h', '1h30', '1h 30m' and similar. Minutes after an hour
+    must be under 60. Raises ValueError for anything else.
+    """
+    if not isinstance(text, str):
+        raise ValueError(f"not a duration: {text!r}")
+    match = _DURATION.fullmatch(text.strip())
+    if match is None:
+        raise ValueError(f"not a duration: {text!r}")
+    minutes_only, hours, minutes = match.groups()
+    if minutes_only is not None:
+        return int(minutes_only)
+    if minutes is not None and int(minutes) >= 60:
+        raise ValueError(f"minutes must be under 60: {text!r}")
+    return int(hours) * 60 + int(minutes or 0)
diff --git a/tests/test_intervals.py b/tests/test_intervals.py
