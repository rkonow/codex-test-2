+"""Helpers for working with time intervals as (start, end) pairs."""
+
+
+def merge_busy(intervals):
+    """Return the (start, end) pairs merged into sorted, non-overlapping pairs.
+
+    Input may be in any order. Pairs that overlap or touch are merged, so
+    [(9, 10), (10, 11)] becomes [(9, 11)].
+    """
+    merged = []
+    for start, end in sorted(intervals):
+        if merged and start <= merged[-1][1]:
+            merged[-1] = (merged[-1][0], max(merged[-1][1], end))
+        else:
+            merged.append((start, end))
+    return merged
