+def next_invoice_number(clinic: str, year: int, existing: Iterable[str]) -> str:
+    """Return the next number in the INV-<clinic>-<year>-<sequence> scheme.
+
+    `existing` is every invoice number issued so far, for any clinic and year; only numbers
+    for this clinic and year count. The sequence starts at 1 and is zero-padded to five digits.
+    """
+    prefix = f"INV-{clinic}-{year}-"
+    last = 0
+    for number in existing:
+        if number.startswith(prefix) and _SEQUENCE_RE.fullmatch(number[len(prefix):]):
+            last = max(last, int(number[len(prefix):]))
+    return f"{prefix}{last + 1:05d}"
+
