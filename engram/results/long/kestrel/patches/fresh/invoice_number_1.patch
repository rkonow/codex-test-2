+def next_invoice_number(clinic: str, year: int, existing: Iterable[str]) -> str:
+    """Return the next number in the INV-<clinic>-<year>-<sequence> scheme.
+
+    The sequence is one more than the highest already issued for this clinic and year, so
+    numbers issued for other clinics or years are ignored, and gaps are never reused.
+    Strings that do not follow the scheme are ignored too.
+    """
+    pattern = re.compile(rf"INV-{re.escape(clinic)}-{year}-([0-9]+)")
+    highest = 0
+    for number in existing:
+        match = pattern.fullmatch(number)
+        if match is not None:
+            highest = max(highest, int(match.group(1)))
+    return f"INV-{clinic}-{year}-{highest + 1:05d}"
+
+
