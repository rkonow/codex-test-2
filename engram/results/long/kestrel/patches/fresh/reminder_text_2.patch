+"""Appointment reminder texts."""
+
+from .calendar import CLINIC_TZ
+from .models import CLINICS, Appointment
+
+
+def reminder_text(appointment: Appointment) -> str:
+    """The SMS sent two days before an appointment.
+
+    Privacy rules: the text gives only the date, time and clinic. It never includes
+    the patient's name or what the appointment is for.
+    """
+    local = appointment.start.astimezone(CLINIC_TZ)
+    hour = local.hour % 12 or 12
+    meridiem = "am" if local.hour < 12 else "pm"
+    when = f"{local:%A} {local.day} {local:%B} at {hour}:{local:%M}{meridiem}"
+    clinic = CLINICS[appointment.clinic].name
+    return (
+        f"Kia ora! This is a friendly reminder of your appointment at {clinic} "
+        f"on {when}. We look forward to seeing you. "
+        "If you can't make it, please let us know as soon as you can so we can offer the time to someone else."
+    )
