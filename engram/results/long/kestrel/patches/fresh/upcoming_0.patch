diff --git a/CHANGELOG.md b/CHANGELOG.md
index c8ee399..dae7669 100644
--- a/CHANGELOG.md
+++ b/CHANGELOG.md
@@ -8,6 +8,7 @@
 - `import_legacy(path)` reads the old booking system's CSV export into appointments.
 - `make_invoice(appointment, patient, number, amount_cents)` builds an `Invoice` dated the appointment's local date, with the patient name left blank.
 - `Calendar.move(appointment_id, new_start)` reschedules a booked appointment; cancelled, attended and no-show appointments are refused.
+- `Calendar.upcoming(patient_id, now)` lists a patient's booked appointments starting after `now`, soonest first; `now` must be timezone-aware.
 - `Calendar.cancel(appointment_id, at)` cancels a booked appointment and records `cancelled_at`; `at` must be timezone-aware.
 - Patients have a `csc` flag, stored in the JSON file (defaults to off for existing records).
 - Patient IDs are normalised (`ids.py`).
diff --git a/src/kestrel/calendar.py b/src/kestrel/calendar.py
index ecf082d..c76eb68 100644
--- a/src/kestrel/calendar.py
+++ b/src/kestrel/calendar.py
@@ -62,5 +62,11 @@ class Calendar:
     def booked(self):
         return [a for a in self.all() if a.status == BOOKED]
 
+    def upcoming(self, patient_id, now):
+        """A patient's booked appointments starting after `now`, soonest first."""
+        if now.tzinfo is None:
+            raise ValueError("now must be timezone-aware")
+        return [a for a in self.for_patient(patient_id) if a.status == BOOKED and a.start > now]
+
     def __len__(self):
         return len(self._appointments)
