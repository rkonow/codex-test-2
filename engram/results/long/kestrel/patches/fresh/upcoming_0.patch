+    def test_upcoming_soonest_first_after_now(self):
+        cal = Calendar([
+            appt("late", utc(2027, 3, 9, 9), patient="KP-000001"),
+            appt("soon", utc(2027, 3, 3, 9), patient="KP-000001"),
+            appt("past", utc(2027, 3, 1, 9), patient="KP-000001"),
+            appt("other", utc(2027, 3, 4, 9), patient="KP-000002"),
+        ])
+        self.assertEqual([a.id for a in cal.upcoming("KP-000001", utc(2027, 3, 2, 12))], ["soon", "late"])
+
+    def test_upcoming_excludes_start_equal_to_now(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 2, 12), patient="KP-000001")])
+        self.assertEqual(cal.upcoming("KP-000001", utc(2027, 3, 2, 12)), [])
+
+    def test_upcoming_only_booked(self):
+        cal = Calendar([
+            appt("booked", utc(2027, 3, 3, 9), patient="KP-000001"),
+            appt("cancelled", utc(2027, 3, 4, 9), patient="KP-000001", status="cancelled", cancelled_at=utc(2027, 3, 1)),
+            appt("no_show", utc(2027, 3, 5, 9), patient="KP-000001", status="no_show"),
+        ])
+        self.assertEqual([a.id for a in cal.upcoming("KP-000001", utc(2027, 3, 2))], ["booked"])
+
+    def test_upcoming_accepts_messy_patient_id(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 3, 9), patient="KP-004211")])
+        self.assertEqual([a.id for a in cal.upcoming("kp4211", utc(2027, 3, 2))], ["a1"])
+
+    def test_upcoming_empty(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 3, 9), patient="KP-000001")])
+        self.assertEqual(cal.upcoming("KP-000002", utc(2027, 3, 2)), [])
+
+    def test_upcoming_requires_aware_now(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 3, 9), patient="KP-000001")])
+        with self.assertRaises(ValueError):
+            cal.upcoming("KP-000001", datetime.datetime(2027, 3, 2))
+
 
 if __name__ == "__main__":
