@@ -0,0 +1,43 @@
+"""Exports for the accountants."""
+
+import csv
+import io
+import os
+
+from .storage import _write_atomic
+
+HEADER = ["Invoice Number", "Date", "Patient ID", "Clinic", "Description", "Amount"]
+
+
+def _dollars(cents):
+    """Format cents as dollars with two decimals, e.g. 9500 -> "95.00", -250 -> "-2.50"."""
+    sign = "-" if cents < 0 else ""
+    cents = abs(cents)
+    return f"{sign}{cents // 100}.{cents % 100:02d}"
+
+
+def export_invoices(invoices, year, month, out_dir):
+    """Write the invoices issued in year-month to out_dir as CSV, and return the file's path.
+
+    Patient names are never written, only patient IDs, as the privacy rules require.
+    The file is written even when no invoices fall in the month (it then has just the header).
+    """
+    rows = sorted(
+        (i for i in invoices if i.issued.year == year and i.issued.month == month),
+        key=lambda i: (i.issued, i.number),
+    )
+    buffer = io.StringIO()
+    writer = csv.writer(buffer, lineterminator="\n")
+    writer.writerow(HEADER)
+    for invoice in rows:
+        writer.writerow([
+            invoice.number,
+            invoice.issued.strftime("%d/%m/%Y"),
+            invoice.patient_id,
+            invoice.clinic,
+            invoice.description,
+            _dollars(invoice.amount_cents),
+        ])
+    path = os.path.join(out_dir, f"kestrel-invoices-{year:04d}-{month:02d}.csv")
+    _write_atomic(path, buffer.getvalue())
+    return path
