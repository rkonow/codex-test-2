@@ -58,6 +58,25 @@ class CalendarTest(unittest.TestCase):
                 with self.assertRaises(ValueError):
                     cal.for_patient(typed)
 
+    def test_upcoming_booked_after_now_soonest_first(self):
+        cal = Calendar([
+            appt("a1", utc(2027, 3, 3, 9), patient="KP-004211"),
+            appt("a2", utc(2027, 3, 1, 9), patient="KP-004211"),   # in the past
+            appt("a3", utc(2027, 3, 2, 9), patient="KP-004211", status="cancelled", cancelled_at=utc(2027, 2, 20)),
+            appt("a4", utc(2027, 3, 2, 10), patient="KP-000007"),  # other patient
+            appt("a5", utc(2027, 3, 2, 8), patient="KP-004211"),
+        ])
+        self.assertEqual([a.id for a in cal.upcoming("kp4211", utc(2027, 3, 1, 12))], ["a5", "a1"])
+
+    def test_upcoming_excludes_start_equal_to_now(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 2, 8), patient="KP-004211")])
+        self.assertEqual(cal.upcoming("KP-004211", utc(2027, 3, 2, 8)), [])
+
+    def test_upcoming_requires_aware_now(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 2, 8), patient="KP-004211")])
+        with self.assertRaises(ValueError):
+            cal.upcoming("KP-004211", datetime.datetime(2027, 3, 1, 12))
+
     def test_booked(self):
         cal = Calendar([appt("a1", utc(2027, 3, 1, 20)), appt("a2", utc(2027, 3, 1, 21), status="cancelled")])
         self.assertEqual([a.id for a in cal.booked()], ["a1"])
