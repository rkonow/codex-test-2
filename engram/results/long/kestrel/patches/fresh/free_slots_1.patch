+"""Finding the start times at which a therapist can take a new appointment."""
+
+import datetime
+
+from .calendar import CLINIC_TZ
+from .models import ASSESSMENT, ATTENDED, BOOKED, FOLLOWUP, KINDS
+
+# Appointment length and the note gap that follows it, in minutes.
+DURATION_MINUTES = {ASSESSMENT: 45, FOLLOWUP: 30}
+NOTE_GAP_MINUTES = {ASSESSMENT: 15, FOLLOWUP: 0}
+
+# Therapists' union agreement: at most this many patient appointments per therapist per day.
+MAX_PATIENTS_PER_DAY = 8
+
+# Clinic day window (local time). ASSUMPTION: placeholder values, not confirmed clinic hours.
+OPEN_TIME = datetime.time(7, 0)
+CLOSE_TIME = datetime.time(18, 0)
+
+START_STEP = datetime.timedelta(minutes=15)  # appointments start on a quarter hour
+
+# Statuses that hold a patient appointment. Cancelled and no-show slots are free.
+_OCCUPYING = (BOOKED, ATTENDED)
+
+
+def _block(kind):
+    """The full time an appointment of this kind takes, including its note gap."""
+    return datetime.timedelta(minutes=DURATION_MINUTES[kind] + NOTE_GAP_MINUTES[kind])
+
+
+def free_slots(calendar, therapist, day, kind):
+    """Local start times (sorted datetime.time) at which a new appointment of `kind` could be booked.
+
+    `day` is a local (Auckland) date. A slot must fit between OPEN_TIME and CLOSE_TIME with its
+    full block (including the note gap after an assessment) free of other appointments for this
+    therapist. Returns [] if the therapist already has MAX_PATIENTS_PER_DAY patient appointments.
+
+    Raises ValueError for an unknown kind.
+    """
+    if kind not in KINDS:
+        raise ValueError(f"unknown kind {kind!r}")
+
+    booked = [a for a in calendar.for_day(therapist.id, day) if a.status in _OCCUPYING]
+    if len(booked) >= MAX_PATIENTS_PER_DAY:
+        return []
+
+    busy = [(a.start, a.start + _block(a.kind)) for a in booked]
+    block = _block(kind)
+    start = datetime.datetime.combine(day, OPEN_TIME, tzinfo=CLINIC_TZ)
+    close = datetime.datetime.combine(day, CLOSE_TIME, tzinfo=CLINIC_TZ)
+
+    slots = []
+    while start + block <= close:
+        end = start + block
+        if all(end <= busy_start or busy_end <= start for busy_start, busy_end in busy):
+            slots.append(start.time())
+        start += START_STEP
+    return slots
diff --git a/tests/test_slots.py b/tests/test_slots.py
new file mode 100644
index 0000000..b52ff8c
--- /dev/null
+++ b/tests/test_slots.py
@@ -0,0 +1,97 @@
+import datetime
+import unittest
+
+from helpers import appt
+from kestrel.calendar import CLINIC_TZ, Calendar
+from kestrel.models import ASSESSMENT, ATTENDED, CANCELLED, FOLLOWUP, NO_SHOW, Therapist
+from kestrel.slots import free_slots
+
+NZ_DAY = datetime.date(2027, 3, 2)  # Auckland is on NZDT (+13) here
+THERAPIST = Therapist("T1", "Ann Example", "HB")
+
+
+def nz(hh, mm=0):
+    return datetime.datetime(2027, 3, 2, hh, mm, tzinfo=CLINIC_TZ)
+
+
+def t(hh, mm=0):
+    return datetime.time(hh, mm)
+
+
+class FreeSlotsTest(unittest.TestCase):
+    def test_empty_day_followup_starts_every_quarter_hour_until_it_must_end_by_close(self):
+        slots = free_slots(Calendar(), THERAPIST, NZ_DAY, FOLLOWUP)
+        self.assertEqual(slots[0], t(7))
+        self.assertEqual(slots[-1], t(17, 30))
+        self.assertEqual(len(slots), 43)
+
+    def test_empty_day_assessment_last_start_leaves_room_for_the_full_block(self):
+        slots = free_slots(Calendar(), THERAPIST, NZ_DAY, ASSESSMENT)
+        self.assertEqual(slots[0], t(7))
+        self.assertEqual(slots[-1], t(17))
+        self.assertEqual(len(slots), 41)
+
+    def test_results_are_sorted_local_times(self):
+        slots = free_slots(Calendar(), THERAPIST, NZ_DAY, FOLLOWUP)
+        self.assertEqual(slots, sorted(slots))
+        self.assertTrue(all(isinstance(s, datetime.time) and s.tzinfo is None for s in slots))
+
+    def test_followup_blocks_only_overlapping_starts(self):
+        cal = Calendar([appt("a1", nz(10), kind=FOLLOWUP, therapist="T1")])  # 10:00-10:30
+        slots = free_slots(cal, THERAPIST, NZ_DAY, FOLLOWUP)
+        self.assertNotIn(t(9, 45), slots)
+        self.assertNotIn(t(10), slots)
+        self.assertNotIn(t(10, 15), slots)
+        self.assertIn(t(9, 30), slots)  # ends exactly when the booking starts
+        self.assertIn(t(10, 30), slots)  # starts exactly when the booking ends
+
+    def test_assessment_note_gap_blocks_the_next_start(self):
+        cal = Calendar([appt("a1", nz(10), kind=ASSESSMENT, therapist="T1")])  # 10:00-10:45, gap to 11:00
+        slots = free_slots(cal, THERAPIST, NZ_DAY, FOLLOWUP)
+        self.assertNotIn(t(10, 15), slots)  # inside the appointment
+        self.assertNotIn(t(10, 45), slots)  # the appointment ends at 10:45, the note gap runs to 11:00
+        self.assertIn(t(11), slots)  # first start after the note gap
+
+    def test_new_assessment_must_leave_its_own_note_gap_free(self):
+        cal = Calendar([appt("a1", nz(11), kind=FOLLOWUP, therapist="T1")])  # 11:00-11:30
+        slots = free_slots(cal, THERAPIST, NZ_DAY, ASSESSMENT)
+        self.assertIn(t(10), slots)  # 10:00-11:00 incl. gap ends exactly when the followup starts
+        self.assertNotIn(t(10, 15), slots)  # 10:15-11:15 incl. gap runs into 11:00
+        self.assertNotIn(t(10, 30), slots)
+
+    def test_cancelled_and_no_show_slots_are_free(self):
+        cal = Calendar([
+            appt("a1", nz(10), kind=FOLLOWUP, therapist="T1", status=CANCELLED),
+            appt("a2", nz(11), kind=FOLLOWUP, therapist="T1", status=NO_SHOW),
+        ])
+        slots = free_slots(cal, THERAPIST, NZ_DAY, FOLLOWUP)
+        self.assertIn(t(10), slots)
+        self.assertIn(t(11), slots)
+
+    def test_attended_appointment_holds_its_slot(self):
+        cal = Calendar([appt("a1", nz(10), kind=FOLLOWUP, therapist="T1", status=ATTENDED)])
+        self.assertNotIn(t(10), free_slots(cal, THERAPIST, NZ_DAY, FOLLOWUP))
+
+    def test_other_therapists_do_not_block(self):
+        cal = Calendar([appt("a1", nz(10), kind=FOLLOWUP, therapist="T2")])
+        self.assertIn(t(10), free_slots(cal, THERAPIST, NZ_DAY, FOLLOWUP))
+
+    def test_cap_of_eight_patient_appointments_leaves_no_slots(self):
+        cal = Calendar([appt(f"a{i}", nz(7) + datetime.timedelta(minutes=30 * i), kind=FOLLOWUP, therapist="T1") for i in range(8)])
+        self.assertEqual(free_slots(cal, THERAPIST, NZ_DAY, FOLLOWUP), [])
+
+    def test_seven_patient_appointments_still_leave_slots(self):
+        cal = Calendar([appt(f"a{i}", nz(7) + datetime.timedelta(minutes=30 * i), kind=FOLLOWUP, therapist="T1") for i in range(7)])
+        self.assertIn(t(16), free_slots(cal, THERAPIST, NZ_DAY, FOLLOWUP))
+
+    def test_cancelled_appointments_do_not_count_towards_the_cap(self):
+        cal = Calendar([appt(f"a{i}", nz(7) + datetime.timedelta(minutes=30 * i), kind=FOLLOWUP, therapist="T1", status=CANCELLED) for i in range(8)])
+        self.assertIn(t(7), free_slots(cal, THERAPIST, NZ_DAY, FOLLOWUP))
+
+    def test_unknown_kind(self):
+        with self.assertRaises(ValueError):
+            free_slots(Calendar(), THERAPIST, NZ_DAY, "massage")
+
+
+if __name__ == "__main__":
+    unittest.main()
