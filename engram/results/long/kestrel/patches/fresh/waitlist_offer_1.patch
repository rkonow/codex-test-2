diff --git a/src/kestrel/waitlist.py b/src/kestrel/waitlist.py
index ba8c156..7d82601 100644
--- a/src/kestrel/waitlist.py
+++ b/src/kestrel/waitlist.py
@@ -38,3 +38,10 @@ class Waitlist:
     def entries(self):
         """Urgent entries first, then everyone else, each in the order they asked."""
         return sorted(self._entries.values(), key=lambda e: (not e.urgent, e.requested_at))
+
+    def next_for(self, kind):
+        """The entry to offer a freed slot of this kind to, or None if nobody is waiting for it."""
+        for entry in self.entries():
+            if entry.kind == kind:
+                return entry
+        return None
diff --git a/tests/test_waitlist.py b/tests/test_waitlist.py
index 6caf1e2..99e9cb8 100644
--- a/tests/test_waitlist.py
+++ b/tests/test_waitlist.py
@@ -68,6 +68,20 @@ class WaitlistTest(unittest.TestCase):
         with self.assertRaises(KeyError):
             Waitlist().remove("KP-000001")
 
+    def test_next_for_returns_first_entry_of_kind(self):
+        wl = Waitlist()
+        wl.add(entry("KP-000001", day=1, kind="assessment"))
+        wl.add(entry("KP-000002", day=2, kind="followup"))
+        wl.add(entry("KP-000003", day=3, kind="followup", urgent=True))
+        self.assertEqual(wl.next_for("followup").patient_id, "KP-000003")
+        self.assertEqual(wl.next_for("assessment").patient_id, "KP-000001")
+
+    def test_next_for_none_when_nobody_waiting_for_kind(self):
+        wl = Waitlist()
+        wl.add(entry("KP-000001", kind="followup"))
+        self.assertIsNone(wl.next_for("assessment"))
+        self.assertIsNone(Waitlist().next_for("followup"))
+
     def test_patient_can_rejoin_after_removal(self):
         wl = Waitlist()
         wl.add(entry("KP-000001", day=1))
