@@ -0,0 +1,30 @@
+import unittest
+
+from helpers import appt, utc
+from kestrel.reminders import reminder_text
+
+
+class ReminderTextTest(unittest.TestCase):
+    def test_gives_local_date_time_and_clinic(self):
+        # 22:30 UTC on 13 Oct is 11:30 on 14 Oct in Auckland (NZDT)
+        a = appt("a1", utc(2026, 10, 13, 22, 30), clinic="HB")
+        text = reminder_text(a)
+        self.assertIn("Kestrel Physio Harbour", text)
+        self.assertIn("Wednesday 14 October at 11:30 AM", text)
+
+    def test_no_leading_zero_on_day_or_hour(self):
+        a = appt("a1", utc(2026, 10, 4, 20, 5), clinic="NG")  # 9:05 on 5 Oct
+        text = reminder_text(a)
+        self.assertIn("Monday 5 October at 9:05 AM", text)
+
+    def test_does_not_mention_treatment_or_patient(self):
+        a = appt("a1", utc(2026, 10, 13, 22, 30), patient="KP-000001", clinic="WK", kind="followup")
+        a.treatment = "lower back pain"
+        text = reminder_text(a)
+        self.assertNotIn("lower back pain", text)
+        self.assertNotIn("KP-000001", text)
+        self.assertNotIn("followup", text)
+
+
+if __name__ == "__main__":
+    unittest.main()
