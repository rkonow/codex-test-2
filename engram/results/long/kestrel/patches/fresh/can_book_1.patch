@@ -0,0 +1,85 @@
+import datetime
+import unittest
+
+from helpers import appt
+from kestrel.booking import can_book
+from kestrel.calendar import CLINIC_TZ, Calendar
+from kestrel.models import ASSESSMENT, CANCELLED, FOLLOWUP, Therapist
+
+
+def nz(hh, mm=0, day=2):
+    """A timezone-aware Auckland time on March `day` 2027 (NZDT, +13)."""
+    return datetime.datetime(2027, 3, day, hh, mm, tzinfo=CLINIC_TZ)
+
+
+class CanBookTest(unittest.TestCase):
+    def test_free_slot(self):
+        self.assertTrue(can_book(Calendar(), "T1", appt("new", nz(9), therapist="T1")))
+
+    def test_overlapping_followup_refused(self):
+        cal = Calendar([appt("a1", nz(9), kind=FOLLOWUP, therapist="T1")])
+        self.assertFalse(can_book(cal, "T1", appt("new", nz(9, 15), kind=FOLLOWUP, therapist="T1")))
+
+    def test_back_to_back_followups_allowed(self):
+        cal = Calendar([appt("a1", nz(9), kind=FOLLOWUP, therapist="T1")])
+        self.assertTrue(can_book(cal, "T1", appt("new", nz(9, 30), kind=FOLLOWUP, therapist="T1")))
+
+    def test_note_gap_after_assessment_blocks_next_start(self):
+        # Assessment runs 9:00-9:45, then notes until 10:00.
+        cal = Calendar([appt("a1", nz(9), kind=ASSESSMENT, therapist="T1")])
+        self.assertFalse(can_book(cal, "T1", appt("new", nz(9, 45), kind=FOLLOWUP, therapist="T1")))
+        self.assertTrue(can_book(cal, "T1", appt("new", nz(10), kind=FOLLOWUP, therapist="T1")))
+
+    def test_no_gap_after_followup(self):
+        cal = Calendar([appt("a1", nz(9), kind=FOLLOWUP, therapist="T1")])
+        self.assertTrue(can_book(cal, "T1", appt("new", nz(9, 30), kind=ASSESSMENT, therapist="T1")))
+
+    def test_new_assessment_includes_its_note_gap(self):
+        # New assessment 9:00-9:45 plus notes to 10:00 would run into a 9:45 follow-up.
+        cal = Calendar([appt("a1", nz(9, 45), kind=FOLLOWUP, therapist="T1")])
+        self.assertFalse(can_book(cal, "T1", appt("new", nz(9), kind=ASSESSMENT, therapist="T1")))
+
+    def test_other_therapist_not_blocked(self):
+        cal = Calendar([appt("a1", nz(9), kind=FOLLOWUP, therapist="T2")])
+        self.assertTrue(can_book(cal, "T1", appt("new", nz(9), kind=FOLLOWUP, therapist="T1")))
+
+    def test_cancelled_appointment_does_not_block(self):
+        cal = Calendar([appt("a1", nz(9), kind=FOLLOWUP, therapist="T1", status=CANCELLED)])
+        self.assertTrue(can_book(cal, "T1", appt("new", nz(9), kind=FOLLOWUP, therapist="T1")))
+
+    def test_appointment_does_not_block_itself(self):
+        existing = appt("a1", nz(9), kind=FOLLOWUP, therapist="T1")
+        cal = Calendar([existing])
+        self.assertTrue(can_book(cal, "T1", existing))
+
+    def test_must_start_on_quarter_hour(self):
+        self.assertFalse(can_book(Calendar(), "T1", appt("new", nz(9, 10), kind=FOLLOWUP, therapist="T1")))
+        self.assertTrue(can_book(Calendar(), "T1", appt("new", nz(9, 45), kind=FOLLOWUP, therapist="T1")))
+
+    def test_daily_cap_of_eight(self):
+        seven = [appt(f"a{i}", nz(8 + i // 2, 30 * (i % 2)), kind=FOLLOWUP, therapist="T1") for i in range(7)]
+        new = appt("new", nz(14), kind=FOLLOWUP, therapist="T1")
+        self.assertTrue(can_book(Calendar(seven), "T1", new))
+
+        eighth = appt("a7", nz(12), kind=FOLLOWUP, therapist="T1")
+        full = Calendar(seven + [eighth])
+        self.assertFalse(can_book(full, "T1", new))
+
+    def test_daily_cap_counts_only_that_therapist_and_day(self):
+        cal = Calendar(
+            [appt(f"a{i}", nz(8 + i // 2, 30 * (i % 2)), kind=FOLLOWUP, therapist="T2") for i in range(8)]
+            + [appt("b1", nz(8, day=1), kind=FOLLOWUP, therapist="T1")]
+        )
+        self.assertTrue(can_book(cal, "T1", appt("new", nz(14), kind=FOLLOWUP, therapist="T1")))
+
+    def test_therapist_object_accepted(self):
+        therapist = Therapist("T1", "Dr Test", "HB")
+        self.assertTrue(can_book(Calendar(), therapist, appt("new", nz(9), kind=FOLLOWUP, therapist="T1")))
+
+    def test_appointment_for_another_therapist_raises(self):
+        with self.assertRaises(ValueError):
+            can_book(Calendar(), "T1", appt("new", nz(9), kind=FOLLOWUP, therapist="T2"))
+
+
+if __name__ == "__main__":
+    unittest.main()
