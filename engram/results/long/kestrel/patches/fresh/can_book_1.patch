+"""Booking rules for the appointment form.
+
+`can_book` is the check the form runs before it saves an appointment.
+"""
+
+import datetime
+
+from .calendar import CLINIC_TZ
+from .models import ASSESSMENT, BOOKED, FOLLOWUP, Therapist
+
+LENGTH = {
+    ASSESSMENT: datetime.timedelta(minutes=45),
+    FOLLOWUP: datetime.timedelta(minutes=30),
+}
+NOTE_GAP = datetime.timedelta(minutes=15)  # after an assessment, for the therapist's notes
+DAILY_CAP = 8  # therapists' union agreement: patient appointments per therapist per day
+
+
+def slot_end(appointment):
+    """When the appointment's slot ends, including the note gap after an assessment."""
+    end = appointment.start + LENGTH[appointment.kind]
+    if appointment.kind == ASSESSMENT:
+        end += NOTE_GAP
+    return end
+
+
+def can_book(calendar, therapist, appointment):
+    """True if `appointment` can be added to the calendar for `therapist`.
+
+    `therapist` is a Therapist or a therapist id. The appointment must be for that therapist.
+    """
+    therapist_id = therapist.id if isinstance(therapist, Therapist) else therapist
+    if appointment.therapist_id != therapist_id:
+        raise ValueError(f"appointment {appointment.id} is for therapist {appointment.therapist_id}, not {therapist_id}")
+
+    local_start = appointment.start.astimezone(CLINIC_TZ)
+    if local_start.minute % 15 or local_start.second or local_start.microsecond:
+        return False  # appointments start on a quarter hour
+
+    others = [a for a in calendar.for_therapist(therapist_id) if a.status == BOOKED and a.id != appointment.id]
+
+    same_day = [a for a in others if a.start.astimezone(CLINIC_TZ).date() == local_start.date()]
+    if len(same_day) >= DAILY_CAP:
+        return False
+
+    # Overlap uses the full slot on both sides, so a note gap blocks the next booking.
+    new_end = slot_end(appointment)
+    for other in others:
+        if other.start < new_end and appointment.start < slot_end(other):
+            return False
+    return True
