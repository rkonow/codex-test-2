@@ -0,0 +1,67 @@
+import csv
+import datetime
+import os
+import tempfile
+import unittest
+
+from kestrel.export import export_invoices
+from kestrel.invoices import Invoice
+
+
+def invoice(number, issued, amount_cents, patient_id="KP-000001", clinic="HB", description="Physiotherapy follow-up"):
+    return Invoice(number=number, clinic=clinic, patient_id=patient_id, patient_name="", issued=issued,
+                   amount_cents=amount_cents, description=description)
+
+
+class ExportInvoicesTest(unittest.TestCase):
+    def setUp(self):
+        self._tmp = tempfile.TemporaryDirectory()
+        self.out_dir = self._tmp.name
+
+    def tearDown(self):
+        self._tmp.cleanup()
+
+    def read_rows(self, path):
+        with open(path, newline="", encoding="utf-8") as f:
+            return list(csv.reader(f))
+
+    def test_file_name_and_path(self):
+        path = export_invoices([], 2027, 3, self.out_dir)
+        self.assertEqual(path, os.path.join(self.out_dir, "kestrel-invoices-2027-03.csv"))
+        self.assertTrue(os.path.exists(path))
+
+    def test_header_row_and_layout(self):
+        invoices = [invoice("INV-HB-2027-00001", datetime.date(2027, 3, 2), 9500, description="Physiotherapy assessment")]
+        rows = self.read_rows(export_invoices(invoices, 2027, 3, self.out_dir))
+        self.assertEqual(rows[0], ["InvoiceNumber", "Clinic", "PatientID", "Date", "Description", "Amount"])
+        self.assertEqual(rows[1], ["INV-HB-2027-00001", "HB", "KP-000001", "02/03/2027", "Physiotherapy assessment", "95.00"])
+
+    def test_amounts_have_two_decimals(self):
+        invoices = [invoice("N1", datetime.date(2027, 3, 1), 7000), invoice("N2", datetime.date(2027, 3, 1), 5)]
+        rows = self.read_rows(export_invoices(invoices, 2027, 3, self.out_dir))
+        self.assertEqual([r[5] for r in rows[1:]], ["70.00", "0.05"])
+
+    def test_only_invoices_from_the_given_month(self):
+        invoices = [
+            invoice("N-feb", datetime.date(2027, 2, 28), 7000),
+            invoice("N-mar", datetime.date(2027, 3, 15), 7000),
+            invoice("N-apr", datetime.date(2027, 4, 1), 7000),
+            invoice("N-mar-2026", datetime.date(2026, 3, 15), 7000),
+        ]
+        rows = self.read_rows(export_invoices(invoices, 2027, 3, self.out_dir))
+        self.assertEqual([r[0] for r in rows[1:]], ["N-mar"])
+
+    def test_no_patient_names_in_output(self):
+        inv = invoice("N1", datetime.date(2027, 3, 1), 7000)
+        inv.patient_name = "Jane Example"
+        path = export_invoices([inv], 2027, 3, self.out_dir)
+        with open(path, encoding="utf-8") as f:
+            self.assertNotIn("Jane Example", f.read())
+
+    def test_empty_month_writes_header_only(self):
+        rows = self.read_rows(export_invoices([], 2027, 3, self.out_dir))
+        self.assertEqual(len(rows), 1)
+
+
+if __name__ == "__main__":
+    unittest.main()
