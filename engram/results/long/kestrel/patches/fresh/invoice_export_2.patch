+"""Monthly invoice export for the accountants (Mere, for import into Xero)."""
+
+import csv
+import datetime
+import io
+import os
+
+from .invoices import Invoice
+from .storage import _write_atomic
+
+# Mere's import layout: header row, DD/MM/YYYY dates, plain two-decimal amounts. Patient IDs only, never names.
+HEADER = ["InvoiceNumber", "Clinic", "PatientID", "Date", "Description", "Amount"]
+
+
+def export_invoices(invoices, year, month, out_dir):
+    """Write the invoices issued in year-month to kestrel-invoices-YYYY-MM.csv in out_dir and return its path."""
+    rows = [i for i in invoices if i.issued.year == year and i.issued.month == month]
+    rows.sort(key=lambda i: (i.issued, i.number))
+
+    buf = io.StringIO()
+    writer = csv.writer(buf, lineterminator="\n")
+    writer.writerow(HEADER)
+    for invoice in rows:
+        writer.writerow(_row(invoice))
+
+    path = os.path.join(out_dir, f"kestrel-invoices-{year:04d}-{month:02d}.csv")
+    _write_atomic(path, buf.getvalue())
+    return path
+
+
+def _row(invoice: Invoice):
+    return [
+        invoice.number,
+        invoice.clinic,
+        invoice.patient_id,
+        invoice.issued.strftime("%d/%m/%Y"),
+        invoice.description,
+        f"{invoice.amount_cents / 100:.2f}",
+    ]
