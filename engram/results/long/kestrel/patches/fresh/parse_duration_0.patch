+"""Durations of appointments."""
+
+import re
+
+_MINUTES = re.compile(r"([0-9]+)m")
+_HOURS = re.compile(r"([0-9]+)h")
+_HOURS_AND_MINUTES = re.compile(r"([0-9]+)h\s*([0-9]+)m?")
+
+
+def parse_duration(text):
+    """Return the number of minutes in a duration such as '45m', '1h', '1h30' or '1h 30m'.
+
+    Raises ValueError for anything else, including bare numbers and zero.
+    """
+    minutes = _minutes(text)
+    if minutes == 0:
+        raise ValueError(f"duration must be positive: {text!r}")
+    return minutes
+
+
+def _minutes(text):
+    if not isinstance(text, str):
+        raise ValueError(f"not a duration: {text!r}")
+
+    if match := _MINUTES.fullmatch(text):
+        return int(match[1])
+    if match := _HOURS.fullmatch(text):
+        return int(match[1]) * 60
+    if match := _HOURS_AND_MINUTES.fullmatch(text):
+        hours, minutes = int(match[1]), int(match[2])
+        if minutes >= 60:
+            raise ValueError(f"minutes must be under 60: {text!r}")
+        return hours * 60 + minutes
+    raise ValueError(f"not a duration: {text!r}")
diff --git a/tests/test_intervals.py b/tests/test_intervals.py
new file mode 100644
