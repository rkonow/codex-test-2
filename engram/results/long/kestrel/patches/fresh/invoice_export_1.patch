+"""Monthly invoice export for the accountants (Mere, Tui Accounting, imports it into Xero)."""
+
+import csv
+import datetime
+import io
+import os
+from decimal import Decimal
+
+from .storage import _write_atomic
+
+HEADER = ["*ContactName", "*InvoiceNumber", "*InvoiceDate", "*Description", "*UnitAmount"]
+
+
+def export_invoices(invoices, year, month, out_dir):
+    """Write the invoices issued in year-month to out_dir as CSV, and return the file's path.
+
+    Only patient IDs are written, never patient names, because the file leaves the system.
+    Dates are DD/MM/YYYY and amounts are dollars with two decimals, as Xero's import expects.
+    """
+    issued_this_month = [i for i in invoices if i.issued.year == year and i.issued.month == month]
+    issued_this_month.sort(key=lambda i: (i.issued, i.number))
+
+    out = io.StringIO()
+    writer = csv.writer(out)
+    writer.writerow(HEADER)
+    for invoice in issued_this_month:
+        writer.writerow([
+            invoice.patient_id,
+            invoice.number,
+            invoice.issued.strftime("%d/%m/%Y"),
+            invoice.description,
+            f"{Decimal(invoice.amount_cents) / 100:.2f}",
+        ])
+
+    path = os.path.join(out_dir, f"kestrel-invoices-{year:04d}-{month:02d}.csv")
+    _write_atomic(path, out.getvalue())
+    return path
