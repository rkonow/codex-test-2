@@ -0,0 +1,56 @@
+import datetime
+import os
+import tempfile
+import unittest
+
+from kestrel.export import export_invoices
+from kestrel.invoices import Invoice
+
+
+def invoice(number, issued, amount_cents, patient="KP-000001", description="Physiotherapy assessment"):
+    return Invoice(number=number, clinic="HB", patient_id=patient, patient_name="",
+                   issued=issued, amount_cents=amount_cents, description=description)
+
+
+class ExportInvoicesTest(unittest.TestCase):
+    def setUp(self):
+        self.dir = tempfile.TemporaryDirectory()
+        self.addCleanup(self.dir.cleanup)
+
+    def read(self, path):
+        with open(path, encoding="utf-8") as f:
+            return f.read()
+
+    def test_writes_header_and_rows_for_the_month(self):
+        invoices = [
+            invoice("INV-HB-2027-00002", datetime.date(2027, 3, 20), 7000, description="Physiotherapy follow-up"),
+            invoice("INV-HB-2027-00001", datetime.date(2027, 3, 2), 9500),
+            invoice("INV-HB-2027-00003", datetime.date(2027, 4, 1), 9500),
+            invoice("INV-HB-2026-00004", datetime.date(2026, 3, 9), 9500),
+        ]
+        path = export_invoices(invoices, 2027, 3, self.dir.name)
+        self.assertEqual(os.path.basename(path), "kestrel-invoices-2027-03.csv")
+        self.assertEqual(os.path.dirname(path), self.dir.name)
+        self.assertEqual(self.read(path).splitlines(), [
+            "*ContactName,*InvoiceNumber,*InvoiceDate,*Description,*UnitAmount",
+            "KP-000001,INV-HB-2027-00001,02/03/2027,Physiotherapy assessment,95.00",
+            "KP-000001,INV-HB-2027-00002,20/03/2027,Physiotherapy follow-up,70.00",
+        ])
+
+    def test_amounts_have_two_decimals(self):
+        path = export_invoices([invoice("N1", datetime.date(2027, 3, 2), 9505)], 2027, 3, self.dir.name)
+        self.assertEqual(self.read(path).splitlines()[1].split(",")[-1], "95.05")
+
+    def test_patient_name_is_never_written(self):
+        leaky = Invoice(number="N1", clinic="HB", patient_id="KP-000001", patient_name="Jane Example",
+                        issued=datetime.date(2027, 3, 2), amount_cents=9500, description="Physiotherapy assessment")
+        path = export_invoices([leaky], 2027, 3, self.dir.name)
+        self.assertNotIn("Jane", self.read(path))
+
+    def test_empty_month_writes_header_only(self):
+        path = export_invoices([], 2027, 3, self.dir.name)
+        self.assertEqual(self.read(path).splitlines(), ["*ContactName,*InvoiceNumber,*InvoiceDate,*Description,*UnitAmount"])
+
+
+if __name__ == "__main__":
+    unittest.main()
