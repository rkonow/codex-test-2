+"""Booking rules for the booking form."""
+
+import datetime
+
+from .calendar import CLINIC_TZ
+from .models import ASSESSMENT, CANCELLED, FOLLOWUP
+
+# Appointment length, plus the note gap an assessment leaves before the next patient.
+SLOT_MINUTES = {ASSESSMENT: 45, FOLLOWUP: 30}
+NOTE_GAP_MINUTES = {ASSESSMENT: 15, FOLLOWUP: 0}
+
+# Union agreement: at most this many patient appointments per therapist per day.
+DAILY_CAP = 8
+
+
+def slot_end(appointment):
+    """When the appointment's slot is free again, including any note gap."""
+    minutes = SLOT_MINUTES[appointment.kind] + NOTE_GAP_MINUTES[appointment.kind]
+    return appointment.start + datetime.timedelta(minutes=minutes)
+
+
+def can_book(calendar, therapist, appointment):
+    """True if `appointment` can be added to `calendar` for `therapist`.
+
+    Checks that it is for this therapist, starts on a quarter hour, does not
+    overlap another live appointment (including its note gap), and keeps the
+    therapist within the daily cap.
+    """
+    if appointment.therapist_id != therapist.id:
+        return False
+
+    local_start = appointment.start.astimezone(CLINIC_TZ)
+    if local_start.minute % 15 != 0 or local_start.second or local_start.microsecond:
+        return False
+
+    new_end = slot_end(appointment)
+    for other in calendar.for_therapist(therapist.id):
+        if other.status == CANCELLED:
+            continue
+        if appointment.start < slot_end(other) and other.start < new_end:
+            return False
+
+    same_day = [a for a in calendar.for_day(therapist.id, local_start.date()) if a.status != CANCELLED]
+    return len(same_day) < DAILY_CAP
