@@ -0,0 +1,71 @@
+import datetime
+import unittest
+
+from helpers import appt, utc
+from kestrel.booking import can_book
+from kestrel.calendar import Calendar
+from kestrel.models import CANCELLED, Therapist
+
+T1 = Therapist(id="T1", name="Ana", clinic="HB")
+
+
+class CanBookTest(unittest.TestCase):
+    def test_empty_calendar(self):
+        self.assertTrue(can_book(Calendar(), T1, appt("new", utc(2027, 3, 2, 1))))
+
+    def test_overlap_with_existing_followup(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 2, 1))])  # 30 min follow-up, 01:00-01:30 UTC
+        self.assertFalse(can_book(cal, T1, appt("new", utc(2027, 3, 2, 1, 15))))
+
+    def test_back_to_back_followups_allowed(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 2, 1))])
+        self.assertTrue(can_book(cal, T1, appt("new", utc(2027, 3, 2, 1, 30))))
+
+    def test_assessment_note_gap_blocks_next_slot(self):
+        # Assessment 01:00 UTC runs 45 min plus 15 min of notes, so it is busy until 02:00.
+        cal = Calendar([appt("a1", utc(2027, 3, 2, 1), kind="assessment")])
+        self.assertFalse(can_book(cal, T1, appt("new", utc(2027, 3, 2, 1, 45))))
+        self.assertTrue(can_book(cal, T1, appt("new", utc(2027, 3, 2, 2))))
+
+    def test_new_assessment_includes_its_own_gap(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 2, 1, 45))])
+        self.assertFalse(can_book(cal, T1, appt("new", utc(2027, 3, 2, 1), kind="assessment")))
+        self.assertTrue(can_book(cal, T1, appt("new", utc(2027, 3, 2, 1), kind="followup")))
+
+    def test_other_therapist_does_not_block(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 2, 1), therapist="T2")])
+        self.assertTrue(can_book(cal, T1, appt("new", utc(2027, 3, 2, 1))))
+
+    def test_cancelled_does_not_block(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 2, 1), status=CANCELLED)])
+        self.assertTrue(can_book(cal, T1, appt("new", utc(2027, 3, 2, 1))))
+
+    def test_appointment_for_another_therapist_rejected(self):
+        self.assertFalse(can_book(Calendar(), T1, appt("new", utc(2027, 3, 2, 1), therapist="T2")))
+
+    def test_must_start_on_quarter_hour(self):
+        self.assertFalse(can_book(Calendar(), T1, appt("new", utc(2027, 3, 2, 1, 10))))
+        self.assertTrue(can_book(Calendar(), T1, appt("new", utc(2027, 3, 2, 1, 45))))
+
+    def test_overlap_from_previous_day_caught(self):
+        # Follow-up 23:45 UTC on 1 Mar runs to 00:15 UTC on 2 Mar, into the new slot.
+        cal = Calendar([appt("a1", utc(2027, 3, 1, 23, 45), kind="followup")])
+        self.assertFalse(can_book(cal, T1, appt("new", utc(2027, 3, 1, 23, 45) + datetime.timedelta(minutes=15))))
+
+    def test_daily_cap_of_eight(self):
+        # Eight follow-ups from 13:00 NZ (00:00 UTC) every 30 min, all on 2 Mar NZ.
+        cal = Calendar([appt(f"a{i}", utc(2027, 3, 2, 0) + datetime.timedelta(minutes=30 * i)) for i in range(8)])
+        self.assertFalse(can_book(cal, T1, appt("new", utc(2027, 3, 2, 5))))
+
+    def test_daily_cap_seven_still_allows(self):
+        cal = Calendar([appt(f"a{i}", utc(2027, 3, 2, 0) + datetime.timedelta(minutes=30 * i)) for i in range(7)])
+        self.assertTrue(can_book(cal, T1, appt("new", utc(2027, 3, 2, 5))))
+
+    def test_cancelled_does_not_count_toward_cap(self):
+        cal = Calendar([appt(f"a{i}", utc(2027, 3, 2, 0) + datetime.timedelta(minutes=30 * i)) for i in range(7)])
+        cal.add(appt("gone", utc(2027, 3, 2, 8), status=CANCELLED))
+        self.assertTrue(can_book(cal, T1, appt("new", utc(2027, 3, 2, 5))))
+
+
+if __name__ == "__main__":
+    unittest.main()
