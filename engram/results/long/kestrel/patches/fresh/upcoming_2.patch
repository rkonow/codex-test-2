diff --git a/src/kestrel/calendar.py b/src/kestrel/calendar.py
index ecf082d..c76eb68 100644
--- a/src/kestrel/calendar.py
+++ b/src/kestrel/calendar.py
@@ -62,5 +62,11 @@ class Calendar:
     def booked(self):
         return [a for a in self.all() if a.status == BOOKED]
 
+    def upcoming(self, patient_id, now):
+        """A patient's booked appointments starting after `now`, soonest first."""
+        if now.tzinfo is None:
+            raise ValueError("now must be timezone-aware")
+        return [a for a in self.for_patient(patient_id) if a.status == BOOKED and a.start > now]
+
     def __len__(self):
         return len(self._appointments)
diff --git a/tests/test_calendar.py b/tests/test_calendar.py
index 5732096..f0b9f6c 100644
--- a/tests/test_calendar.py
+++ b/tests/test_calendar.py
@@ -62,6 +62,27 @@ class CalendarTest(unittest.TestCase):
         cal = Calendar([appt("a1", utc(2027, 3, 1, 20)), appt("a2", utc(2027, 3, 1, 21), status="cancelled")])
         self.assertEqual([a.id for a in cal.booked()], ["a1"])
 
+    def test_upcoming_booked_after_now_soonest_first(self):
+        now = utc(2027, 3, 2, 0)
+        cal = Calendar([
+            appt("late", utc(2027, 3, 3, 9), patient="KP-004211"),
+            appt("soon", utc(2027, 3, 2, 1), patient="KP-004211"),
+            appt("past", utc(2027, 3, 1, 23), patient="KP-004211"),
+            appt("at_now", utc(2027, 3, 2, 0), patient="KP-004211"),
+            appt("cancelled", utc(2027, 3, 2, 5), patient="KP-004211", status="cancelled"),
+            appt("other", utc(2027, 3, 2, 2), patient="KP-000007"),
+        ])
+        self.assertEqual([a.id for a in cal.upcoming("kp4211", now)], ["soon", "late"])
+
+    def test_upcoming_empty_for_unknown_patient(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 2, 1), patient="KP-004211")])
+        self.assertEqual(cal.upcoming("KP-000007", utc(2027, 3, 2, 0)), [])
+
+    def test_upcoming_requires_aware_now(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 2, 1), patient="KP-004211")])
+        with self.assertRaises(ValueError):
+            cal.upcoming("KP-004211", datetime.datetime(2027, 3, 2, 0))
+
     def test_cancel_sets_status_and_time(self):
         cal = Calendar([appt("a1", utc(2027, 3, 1, 20))])
         returned = cal.cancel("a1", utc(2027, 2, 28, 9, 30))
