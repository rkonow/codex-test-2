+from kestrel.invoices import make_invoice, next_invoice_number
 from kestrel.models import Patient
 
 PATIENT = Patient(id="KP-000001", name="Jane Example", phone="+64211234567")
 
 
+class NextInvoiceNumberTest(unittest.TestCase):
+    def test_first_invoice_of_the_year_is_one(self):
+        self.assertEqual(next_invoice_number("HB", 2027, []), "INV-HB-2027-00001")
+
+    def test_follows_highest_number_for_clinic_and_year(self):
+        existing = ["INV-HB-2027-00041", "INV-HB-2027-00042", "INV-HB-2027-00007"]
+        self.assertEqual(next_invoice_number("HB", 2027, existing), "INV-HB-2027-00043")
+
+    def test_ignores_other_clinics_and_years(self):
+        existing = ["INV-HB-2026-00900", "INV-AK-2027-00500", "INV-HB-2028-00100"]
+        self.assertEqual(next_invoice_number("HB", 2027, existing), "INV-HB-2027-00001")
+
+    def test_ignores_numbers_not_in_the_format(self):
+        existing = ["INV-HB-2027-00003", "INV-HB-2027-X", "INV-HB-2027-"]
+        self.assertEqual(next_invoice_number("HB", 2027, existing), "INV-HB-2027-00004")
+
+    def test_accepts_any_iterable(self):
+        existing = (n for n in ["INV-HB-2027-00002"])
+        self.assertEqual(next_invoice_number("HB", 2027, existing), "INV-HB-2027-00003")
+
+
