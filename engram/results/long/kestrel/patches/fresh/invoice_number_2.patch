+def next_invoice_number(clinic: str, year: int, existing: Iterable[str]) -> str:
+    """Return the next number for a clinic's invoices in a year, like INV-HB-2027-00043.
+
+    `existing` holds every invoice number issued so far, for any clinic and year.
+    Numbers are counted per clinic and year; anything not in that format is ignored.
+    """
+    prefix = f"INV-{clinic}-{year}-"
+    sequences = [
+        int(number[len(prefix):])
+        for number in existing
+        if number.startswith(prefix) and number[len(prefix):].isdigit()
+    ]
+    return f"{prefix}{max(sequences, default=0) + 1:05d}"
+
