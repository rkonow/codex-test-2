 """Session prices."""
 
-from kestrel.models import ASSESSMENT, FOLLOWUP
+import datetime
+
+from kestrel.models import ASSESSMENT, CANCELLED, FOLLOWUP, NO_SHOW
 
 _PRICES_CENTS = {
     ASSESSMENT: 9500,
     FOLLOWUP: 7000,
 }
 
+# A cancellation this close to the appointment is "late" (board decision, 2026-10-11).
+LATE_CANCELLATION_WINDOW = datetime.timedelta(hours=48)
+LATE_CANCELLATION_PERCENT = 50
+
 
 def session_price(kind):
     """Return the price of a session of the given kind, in cents.
@@ -17,3 +23,29 @@ def session_price(kind):
         return _PRICES_CENTS[kind]
     except KeyError:
         raise ValueError(f"unknown session kind: {kind!r}") from None
+
+
+def appointment_price(appointment, patient):
+    """Return what the patient pays for the appointment, in cents.
+
+    A no-show pays the full session price. A booking cancelled less than
+    48 hours before its start pays 50% of it. Anything else pays the full
+    session price.
+
+    Raises NotImplementedError for Community Services Card holders: their
+    rate has not been set yet, and charging full price would overcharge them.
+    """
+    if patient.csc:
+        raise NotImplementedError("Community Services Card rate is not set")
+    price = session_price(appointment.kind)
+    if appointment.status == NO_SHOW:
+        return price
+    if appointment.status == CANCELLED and _is_late(appointment):
+        return price * LATE_CANCELLATION_PERCENT // 100
+    return price
+
+
+def _is_late(appointment):
+    if appointment.cancelled_at is None:
+        raise ValueError(f"appointment {appointment.id!r} is cancelled but has no cancelled_at")
+    return appointment.start - appointment.cancelled_at < LATE_CANCELLATION_WINDOW
