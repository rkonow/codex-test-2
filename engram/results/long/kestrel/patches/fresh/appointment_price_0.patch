+class AppointmentPriceTest(unittest.TestCase):
+    START = utc(2027, 3, 10, 9)
+
+    def test_booked_pays_full_session_price(self):
+        a = appt("a1", self.START, kind=ASSESSMENT)
+        self.assertEqual(appointment_price(a, PATIENT), 9500)
+
+    def test_attended_followup_pays_full_price(self):
+        a = appt("a1", self.START, kind=FOLLOWUP, status=ATTENDED)
+        self.assertEqual(appointment_price(a, PATIENT), 7000)
+
+    def test_no_show_pays_full_price(self):
+        a = appt("a1", self.START, kind=ASSESSMENT, status=NO_SHOW)
+        self.assertEqual(appointment_price(a, PATIENT), 9500)
+
+    def test_cancelled_within_48_hours_pays_half(self):
+        at = self.START - datetime.timedelta(hours=47, minutes=59)
+        a = appt("a1", self.START, kind=ASSESSMENT, status=CANCELLED, cancelled_at=at)
+        self.assertEqual(appointment_price(a, PATIENT), 4750)
+
+    def test_cancelled_exactly_48_hours_before_is_not_late(self):
+        at = self.START - datetime.timedelta(hours=48)
+        a = appt("a1", self.START, kind=FOLLOWUP, status=CANCELLED, cancelled_at=at)
+        self.assertEqual(appointment_price(a, PATIENT), 7000)
+
+    def test_cancelled_well_ahead_pays_nothing_extra(self):
+        at = self.START - datetime.timedelta(days=7)
+        a = appt("a1", self.START, kind=FOLLOWUP, status=CANCELLED, cancelled_at=at)
+        self.assertEqual(appointment_price(a, PATIENT), 7000)
+
+    def test_cancelled_without_cancelled_at_is_refused(self):
+        a = appt("a1", self.START, status=CANCELLED)
+        with self.assertRaises(ValueError):
+            appointment_price(a, PATIENT)
+
+    def test_csc_patient_is_refused_until_rate_is_set(self):
+        a = appt("a1", self.START, kind=ASSESSMENT)
+        with self.assertRaises(NotImplementedError):
+            appointment_price(a, CSC_PATIENT)
+
+
 if __name__ == "__main__":
