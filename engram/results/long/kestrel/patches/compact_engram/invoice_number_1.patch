+def next_invoice_number(clinic, year, existing):
+    """Return the next invoice number for a clinic in a year, given every number issued so far.
+
+    Numbers for other clinics or years, and anything not in the INV-<clinic>-<year>-<sequence> form, are ignored.
+    """
+    highest = 0
+    for number in existing:
+        match = NUMBER_PATTERN.fullmatch(number)
+        if match and match.group(1) == clinic and int(match.group(2)) == year:
+            highest = max(highest, int(match.group(3)))
+    if highest >= 99999:
+        raise ValueError(f"no invoice numbers left for {clinic} {year}")
+    return f"INV-{clinic}-{year:04d}-{highest + 1:05d}"
