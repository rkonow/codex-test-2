+"""Parsing of appointment durations written by reception, such as '45m', '1h' or '1h 30m'."""
+
+import re
+
+# Either hours with optional minutes ("1h", "1h30", "1h 30m"), or minutes alone ("45m").
+_DURATION = re.compile(r"(?:([0-9]+)h\s*(?:([0-9]+)m?)?|([0-9]+)m)")
+
+
+def parse_duration(text):
+    """Return the duration in minutes. Raises ValueError for anything that is not a positive duration."""
+    match = _DURATION.fullmatch(text.strip())
+    if match is None:
+        raise ValueError(f"not a duration: {text!r}")
+    hours, minutes_after_hours, minutes_alone = match.groups()
+    if minutes_alone is not None:
+        total = int(minutes_alone)
+    else:
+        minutes = int(minutes_after_hours or 0)
+        if minutes >= 60:
+            raise ValueError(f"minutes must be under 60 after hours: {text!r}")
+        total = int(hours) * 60 + minutes
+    if total == 0:
+        raise ValueError(f"duration must be positive: {text!r}")
+    return total
diff --git a/tests/test_intervals.py b/tests/test_intervals.py
