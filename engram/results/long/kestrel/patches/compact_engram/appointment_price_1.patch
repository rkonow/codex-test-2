+"""Session prices and what each patient pays, in cents."""
 
-from .models import ASSESSMENT, FOLLOWUP
+import datetime
 
-PRICES_CENTS = {
+from .calendar import CLINIC_TZ
+from .ids import normalize_patient_id
+from .models import ASSESSMENT, CANCELLED, FOLLOWUP, NO_SHOW
+
+# From this Auckland date the board's new prices apply. Earlier appointments keep the old prices.
+PRICE_CHANGE_DATE = datetime.date(2027, 4, 1)
+OLD_PRICES_CENTS = {
     ASSESSMENT: 9500,  # $95
     FOLLOWUP: 7000,  # $70
 }
+NEW_PRICES_CENTS = {
+    ASSESSMENT: 10500,  # $105
+    FOLLOWUP: 7800,  # $78
+}
+CSC_FOLLOWUP_DISCOUNT_PERCENT = 20  # Community Services Card holders, follow-ups only
+LATE_CANCEL_WINDOW = datetime.timedelta(hours=48)
+LATE_CANCEL_FEE_PERCENT = 50
 
 
-def session_price(kind):
-    """The price of one session of `kind`, in cents."""
-    if kind not in PRICES_CENTS:
+def session_price(kind, date):
+    """The price of one session of `kind` on the Auckland date `date`, in cents."""
+    if kind not in OLD_PRICES_CENTS:
         raise ValueError(f"unknown kind {kind!r}")
-    return PRICES_CENTS[kind]
+    prices = NEW_PRICES_CENTS if date >= PRICE_CHANGE_DATE else OLD_PRICES_CENTS
+    return prices[kind]
+
+
+def appointment_price(appointment, patient):
+    """What the patient pays for the appointment, in cents.
+
+    The session price for the appointment's Auckland date, less the CSC discount on follow-ups.
+    A no-show pays that full price. Cancelling less than 48 hours before the start costs 50% of it;
+    earlier cancellations cost nothing.
+    """
+    if normalize_patient_id(patient.id) != normalize_patient_id(appointment.patient_id):
+        raise ValueError(f"appointment is for {appointment.patient_id}, not {patient.id}")
+    local_date = appointment.start.astimezone(CLINIC_TZ).date()
+    price = session_price(appointment.kind, local_date)
+    if patient.csc and appointment.kind == FOLLOWUP:
+        price = price * (100 - CSC_FOLLOWUP_DISCOUNT_PERCENT) // 100
+    if appointment.status == CANCELLED:
+        if appointment.cancelled_at is None:
+            raise ValueError("cancelled appointment has no cancelled_at")
+        if appointment.start - appointment.cancelled_at < LATE_CANCEL_WINDOW:
+            return price * LATE_CANCEL_FEE_PERCENT // 100
+        return 0
+    return price
