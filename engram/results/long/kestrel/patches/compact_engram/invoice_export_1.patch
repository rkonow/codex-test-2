+"""Monthly invoice export for the accountants: a CSV file per month, patient IDs only."""
+
+import csv
+import datetime
+import os
+
+HEADER = ["Invoice number", "Clinic", "Patient ID", "Date", "Description", "Amount"]
+
+
+def export_invoices(invoices, year, month, out_dir):
+    """Write the invoices issued in that month to kestrel-invoices-YYYY-MM.csv in out_dir and return its path."""
+    chosen = sorted(
+        (i for i in invoices if i.issued.year == year and i.issued.month == month),
+        key=lambda i: i.number,
+    )
+    path = os.path.join(out_dir, f"kestrel-invoices-{year:04d}-{month:02d}.csv")
+    with open(path, "w", encoding="utf-8", newline="") as f:
+        writer = csv.writer(f)
+        writer.writerow(HEADER)
+        for i in chosen:
+            writer.writerow([
+                i.number, i.clinic, i.patient_id, i.issued.strftime("%d/%m/%Y"), i.description,
+                f"{i.amount_cents / 100:.2f}",
+            ])
+    return path
