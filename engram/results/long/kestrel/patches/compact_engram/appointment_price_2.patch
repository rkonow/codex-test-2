+class AppointmentPriceTest(unittest.TestCase):
+    def test_assessment_before_the_change_is_95_dollars(self):
+        # 12 Oct 2026 in Auckland.
+        self.assertEqual(appointment_price(appt("a1", utc(2026, 10, 12, 1), kind=ASSESSMENT), patient()), 9500)
+
+    def test_assessment_after_the_change_is_105_dollars(self):
