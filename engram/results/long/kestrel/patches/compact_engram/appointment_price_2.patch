 """Session prices, in cents."""
 
-from .models import ASSESSMENT, FOLLOWUP
+import datetime
 
-PRICES_CENTS = {
+from .calendar import CLINIC_TZ
+from .models import ASSESSMENT, FOLLOWUP, KINDS
+
+# Appointments dated on or after this Auckland date use the new prices.
+PRICE_CHANGE_DATE = datetime.date(2027, 4, 1)
+
+OLD_PRICES_CENTS = {
     ASSESSMENT: 9500,  # $95
     FOLLOWUP: 7000,  # $70
 }
 
+NEW_PRICES_CENTS = {
+    ASSESSMENT: 10500,  # $105
+    FOLLOWUP: 7800,  # $78
+}
+
+CSC_FOLLOWUP_DISCOUNT_PERCENT = 20  # Community Services Card holders, follow-ups only
 
-def session_price(kind):
-    """The price of one session of `kind`, in cents."""
-    if kind not in PRICES_CENTS:
+
+def session_price(kind, on_date):
+    """The list price of one session of `kind` on the Auckland date `on_date`, in cents."""
+    if kind not in KINDS:
         raise ValueError(f"unknown kind {kind!r}")
-    return PRICES_CENTS[kind]
+    prices = NEW_PRICES_CENTS if on_date >= PRICE_CHANGE_DATE else OLD_PRICES_CENTS
+    return prices[kind]
+
+
+def appointment_price(appointment, patient):
+    """What `patient` pays for `appointment`, in cents."""
+    if appointment.patient_id != patient.id:
+        raise ValueError(f"appointment {appointment.id} is not for patient {patient.id}")
+    local_date = appointment.start.astimezone(CLINIC_TZ).date()
+    price = session_price(appointment.kind, local_date)
+    if patient.csc and appointment.kind == FOLLOWUP:
+        price = price * (100 - CSC_FOLLOWUP_DISCOUNT_PERCENT) // 100
+    return price
