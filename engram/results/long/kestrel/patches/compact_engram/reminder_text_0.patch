@@ -0,0 +1,21 @@
+"""Text of the SMS reminder sent two days before an appointment."""
+
+from .calendar import CLINIC_TZ
+from .models import CLINICS
+
+# Names are spelled out here rather than taken from strftime, so the text does not depend on the PC's locale.
+WEEKDAYS = ("Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday")
+MONTHS = ("January", "February", "March", "April", "May", "June",
+          "July", "August", "September", "October", "November", "December")
+
+
+def reminder_text(appointment):
+    """A friendly reminder with the date, time and clinic name only. No treatment, no patient name."""
+    local = appointment.start.astimezone(CLINIC_TZ)
+    hour12 = local.hour % 12 or 12
+    meridiem = "am" if local.hour < 12 else "pm"
+    when = (f"{WEEKDAYS[local.weekday()]} {local.day} {MONTHS[local.month - 1]} "
+            f"at {hour12}:{local.minute:02d}{meridiem}")
+    clinic = CLINICS[appointment.clinic].name
+    return (f"Hi, this is a reminder of your appointment at {clinic} on {when}. "
+            f"We look forward to seeing you! If you need to change it, please contact the clinic.")
diff --git a/tests/test_reminders.py b/tests/test_reminders.py
new file mode 100644
index 0000000..9e440eb
--- /dev/null
+++ b/tests/test_reminders.py
@@ -0,0 +1,32 @@
+import unittest
+
+from helpers import appt, utc
+from kestrel.reminders import reminder_text
+
+
+class ReminderTextTest(unittest.TestCase):
+    def test_gives_local_date_time_and_clinic_name(self):
+        # 13 Oct 2026 20:30 UTC is 14 Oct 2026 09:30 in Auckland (NZDT, UTC+13).
+        text = reminder_text(appt("a1", utc(2026, 10, 13, 20, 30), clinic="HB"))
+        self.assertIn("Kestrel Physio Harbour", text)
+        self.assertIn("Wednesday 14 October at 9:30am", text)
+
+    def test_afternoon_time_uses_pm(self):
+        # 14 Oct 2026 03:00 UTC is 16:00 in Auckland.
+        text = reminder_text(appt("a1", utc(2026, 10, 14, 3, 0), clinic="NG"))
+        self.assertIn("Kestrel Physio Northgate", text)
+        self.assertIn("at 4:00pm", text)
+
+    def test_midnight_and_noon_are_twelve_hour_times(self):
+        # 13 Oct 2026 11:00 UTC is 00:00 on 14 Oct in Auckland; 14 Oct 2026 23:00 UTC is 12:00 on 15 Oct.
+        self.assertIn("at 12:00am", reminder_text(appt("a1", utc(2026, 10, 13, 11, 0))))
+        self.assertIn("at 12:00pm", reminder_text(appt("a2", utc(2026, 10, 14, 23, 0))))
+
+    def test_leaves_out_treatment_and_patient_name(self):
+        text = reminder_text(appt("a1", utc(2026, 10, 14, 3), treatment="ankle sprain", patient="KP-004211"))
+        self.assertNotIn("ankle sprain", text)
+        self.assertNotIn("KP-004211", text)
+
+
+if __name__ == "__main__":
+    unittest.main()
