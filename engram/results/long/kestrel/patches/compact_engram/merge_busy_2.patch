+import unittest
+
+from helpers import utc
+from kestrel.intervals import merge_busy
+
+
+class MergeBusyTest(unittest.TestCase):
+    def test_empty(self):
+        self.assertEqual(merge_busy([]), [])
+
+    def test_disjoint_pairs_are_sorted_and_kept(self):
+        self.assertEqual(merge_busy([(utc(2026, 10, 12, 5), utc(2026, 10, 12, 6)),
+                                     (utc(2026, 10, 12, 1), utc(2026, 10, 12, 2))]),
+                         [(utc(2026, 10, 12, 1), utc(2026, 10, 12, 2)),
+                          (utc(2026, 10, 12, 5), utc(2026, 10, 12, 6))])
+
+    def test_overlapping_pairs_merge(self):
+        self.assertEqual(merge_busy([(1, 4), (3, 6)]), [(1, 6)])
+
+    def test_touching_pairs_merge(self):
+        self.assertEqual(merge_busy([(1, 3), (3, 5)]), [(1, 5)])
+
+    def test_contained_pair_does_not_shorten_the_outer_one(self):
+        self.assertEqual(merge_busy([(1, 10), (3, 4)]), [(1, 10)])
+
+    def test_any_order_gives_the_same_result(self):
+        pairs = [(8, 9), (1, 2), (2, 4), (6, 7), (3, 5)]
+        self.assertEqual(merge_busy(pairs), [(1, 5), (6, 7), (8, 9)])
+        self.assertEqual(merge_busy(list(reversed(pairs))), [(1, 5), (6, 7), (8, 9)])
+
+
+if __name__ == "__main__":
+    unittest.main()
