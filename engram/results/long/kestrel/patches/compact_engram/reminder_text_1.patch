+"""Text of the SMS reminder sent two days before an appointment."""
+
+from .calendar import CLINIC_TZ
+from .models import CLINICS
+
+
+def reminder_text(appointment):
+    """The reminder for one appointment: date, time and clinic name only, never the treatment."""
+    local = appointment.start.astimezone(CLINIC_TZ)
+    clinic = CLINICS[appointment.clinic].name
+    when = f"{local:%A} {local.day} {local:%B} at {_clock(local)}"
+    return (
+        f"Hi from {clinic}. This is a reminder of your appointment on {when}. "
+        "We look forward to seeing you. If you need to change it, please contact the clinic."
+    )
+
+
+def _clock(local):
+    """Twelve-hour time without a leading zero, e.g. 9:30am or 2:00pm."""
+    hour = local.hour % 12 or 12
+    suffix = "am" if local.hour < 12 else "pm"
+    return f"{hour}:{local.minute:02d}{suffix}"
diff --git a/tests/test_reminders.py b/tests/test_reminders.py
