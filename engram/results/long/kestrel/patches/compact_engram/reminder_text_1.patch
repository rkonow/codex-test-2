+++ b/tests/test_reminders.py
@@ -0,0 +1,32 @@
+import unittest
+
+from helpers import appt, utc
+from kestrel.reminders import reminder_text
+
+
+class ReminderTextTest(unittest.TestCase):
+    def test_gives_local_date_and_time_and_clinic_name(self):
+        # 13 Oct 2026 20:30 UTC is 14 Oct 2026 09:30 in Auckland (NZDT, UTC+13).
+        text = reminder_text(appt("a1", utc(2026, 10, 13, 20, 30), clinic="HB"))
+        self.assertIn("Kestrel Physio Harbour", text)
+        self.assertIn("Wednesday 14 October at 9:30am", text)
+
+    def test_afternoon_time_is_twelve_hour(self):
+        text = reminder_text(appt("a1", utc(2026, 10, 12, 3, 0), clinic="NG"))
+        self.assertIn("Kestrel Physio Northgate", text)
+        self.assertIn("Monday 12 October at 4:00pm", text)
+
+    def test_midday_and_midnight_are_twelve_not_zero(self):
+        # 11 Oct 2026 23:15 UTC is 12 Oct 12:15 in Auckland; 11 Oct 11:00 UTC is 12 Oct 00:00.
+        self.assertIn("at 12:15pm", reminder_text(appt("a1", utc(2026, 10, 11, 23, 15), clinic="WK")))
+        self.assertIn("at 12:00am", reminder_text(appt("a2", utc(2026, 10, 11, 11, 0), clinic="WK")))
+
+    def test_never_mentions_treatment_or_kind(self):
+        text = reminder_text(appt("a1", utc(2026, 10, 12, 1), kind="assessment",
+                                  treatment="ankle sprain", clinic="HB"))
+        self.assertNotIn("ankle sprain", text)
+        self.assertNotIn("assessment", text)
+
+
+if __name__ == "__main__":
+    unittest.main()
