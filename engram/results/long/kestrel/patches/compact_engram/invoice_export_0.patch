+"""Monthly invoice export for the accountants (Xero import)."""
+
+import csv
+import datetime
+import os
+
+HEADER = ["Invoice Number", "Clinic", "Patient ID", "Date", "Description", "Amount"]
+
+
+def export_invoices(invoices, year, month, out_dir):
+    """Write one month's invoices to kestrel-invoices-YYYY-MM.csv in out_dir and return its path.
+
+    Only invoices issued in that month are included, ordered by date then invoice number.
+    The file holds patient IDs only, never names.
+    """
+    datetime.date(year, month, 1)  # raises ValueError for a month outside 1-12
+    path = os.path.join(out_dir, f"kestrel-invoices-{year}-{month:02d}.csv")
+    chosen = sorted(
+        (i for i in invoices if i.issued.year == year and i.issued.month == month),
+        key=lambda i: (i.issued, i.number),
+    )
+    with open(path, "w", encoding="utf-8", newline="") as f:
+        writer = csv.writer(f)
+        writer.writerow(HEADER)
+        for i in chosen:
+            writer.writerow([i.number, i.clinic, i.patient_id, f"{i.issued:%d/%m/%Y}", i.description, _amount(i.amount_cents)])
+    return path
+
+
+def _amount(cents):
+    """Dollars with two decimals and no dollar sign, e.g. 9500 -> 95.00."""
+    dollars, rest = divmod(cents, 100)
+    return f"{dollars}.{rest:02d}"
