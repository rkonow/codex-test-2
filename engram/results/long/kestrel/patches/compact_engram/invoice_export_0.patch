@@ -0,0 +1,79 @@
+import csv
+import datetime
+import os
+import tempfile
+import unittest
+
+from kestrel.export import export_invoices
+from kestrel.invoices import Invoice
+
+
+def invoice(number, issued, patient_id="KP-004211", clinic="HB", amount_cents=9500, description="Initial assessment"):
+    return Invoice(number=number, clinic=clinic, patient_id=patient_id, issued=issued,
+                   amount_cents=amount_cents, description=description)
+
+
+class ExportInvoicesTest(unittest.TestCase):
+    def setUp(self):
+        self.dir = tempfile.TemporaryDirectory()
+        self.addCleanup(self.dir.cleanup)
+
+    def export(self, invoices, year=2026, month=10):
+        path = export_invoices(invoices, year, month, self.dir.name)
+        with open(path, encoding="utf-8", newline="") as f:
+            rows = list(csv.reader(f))
+        return path, rows
+
+    def test_returns_path_named_for_the_month(self):
+        path, _ = self.export([])
+        self.assertEqual(path, os.path.join(self.dir.name, "kestrel-invoices-2026-10.csv"))
+        self.assertTrue(os.path.exists(path))
+
+    def test_first_row_is_header(self):
+        _, rows = self.export([])
+        self.assertEqual(rows, [["Invoice Number", "Clinic", "Patient ID", "Date", "Description", "Amount"]])
+
+    def test_writes_one_row_per_invoice_with_formatted_values(self):
+        _, rows = self.export([
+            invoice("INV-HB-2026-00001", datetime.date(2026, 10, 12), amount_cents=9500),
+            invoice("INV-NG-2026-00001", datetime.date(2026, 10, 3), clinic="NG", amount_cents=7000,
+                    description="Follow-up session", patient_id="KP-000007"),
+        ])
+        self.assertEqual(rows[1:], [
+            ["INV-NG-2026-00001", "NG", "KP-000007", "03/10/2026", "Follow-up session", "70.00"],
+            ["INV-HB-2026-00001", "HB", "KP-004211", "12/10/2026", "Initial assessment", "95.00"],
+        ])
+
+    def test_amount_under_a_dollar_has_two_decimals(self):
+        _, rows = self.export([invoice("N", datetime.date(2026, 10, 1), amount_cents=105)])
+        self.assertEqual(rows[1][5], "1.05")
+
+    def test_only_includes_invoices_issued_in_that_month(self):
+        _, rows = self.export([
+            invoice("Sep", datetime.date(2026, 9, 30)),
+            invoice("Oct", datetime.date(2026, 10, 1)),
+            invoice("Nov", datetime.date(2026, 11, 1)),
+            invoice("Oct 2025", datetime.date(2025, 10, 15)),
+        ])
+        self.assertEqual([r[0] for r in rows[1:]], ["Oct"])
+
+    def test_orders_by_date_then_number(self):
+        _, rows = self.export([
+            invoice("INV-B", datetime.date(2026, 10, 5)),
+            invoice("INV-A", datetime.date(2026, 10, 5)),
+            invoice("INV-C", datetime.date(2026, 10, 2)),
+        ])
+        self.assertEqual([r[0] for r in rows[1:]], ["INV-C", "INV-A", "INV-B"])
+
+    def test_has_no_patient_names(self):
+        path, _ = self.export([invoice("N", datetime.date(2026, 10, 1))])
+        with open(path, encoding="utf-8") as f:
+            self.assertNotIn("Aroha", f.read())
+
+    def test_rejects_month_outside_one_to_twelve(self):
+        with self.assertRaises(ValueError):
+            export_invoices([], 2026, 13, self.dir.name)
+
+
+if __name__ == "__main__":
+    unittest.main()
