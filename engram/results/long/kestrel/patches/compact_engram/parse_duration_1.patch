+"""Parse appointment durations written as '45m', '1h', '1h30' or '1h 30m'."""
+
+import re
+
+_DURATION = re.compile(r"(?:([0-9]+)h\s*(?:([0-9]+)m?)?|([0-9]+)m)")
+
+
+def parse_duration(text):
+    """Return the duration in minutes. Raises ValueError for anything that is not a duration."""
+    match = _DURATION.fullmatch(text.strip())
+    if match is None:
+        raise ValueError(f"unrecognised duration {text!r}; use forms like 45m, 1h, 1h30 or 1h 30m")
+    hours, minutes_after_hours, minutes_only = match.groups()
+    if minutes_only is not None:
+        total = int(minutes_only)
+    else:
+        minutes = int(minutes_after_hours or 0)
+        if minutes >= 60:
+            raise ValueError(f"minutes after the hour must be under 60 in {text!r}")
+        total = int(hours) * 60 + minutes
+    if total == 0:
+        raise ValueError(f"duration must be more than zero: {text!r}")
+    return total
