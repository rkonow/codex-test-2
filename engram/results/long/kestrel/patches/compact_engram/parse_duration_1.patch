@@ -0,0 +1,41 @@
+import unittest
+
+from kestrel.intervals import parse_duration
+
+
+class ParseDurationTest(unittest.TestCase):
+    def test_minutes(self):
+        self.assertEqual(parse_duration("45m"), 45)
+
+    def test_hours(self):
+        self.assertEqual(parse_duration("1h"), 60)
+
+    def test_hours_and_minutes_without_unit(self):
+        self.assertEqual(parse_duration("1h30"), 90)
+
+    def test_hours_and_minutes_with_space(self):
+        self.assertEqual(parse_duration("1h 30m"), 90)
+
+    def test_hours_and_minutes_with_unit(self):
+        self.assertEqual(parse_duration("2h15m"), 135)
+
+    def test_surrounding_spaces_are_ignored(self):
+        self.assertEqual(parse_duration(" 30m "), 30)
+
+    def test_rejects_other_text(self):
+        for text in ["", "45", "abc", "1.5h", "1x", "h30", "1hm", "45 m", "-30m"]:
+            with self.subTest(text=text):
+                with self.assertRaises(ValueError):
+                    parse_duration(text)
+
+    def test_rejects_minutes_of_sixty_or_more_after_hours(self):
+        with self.assertRaises(ValueError):
+            parse_duration("1h90")
+
+    def test_rejects_zero(self):
+        with self.assertRaises(ValueError):
+            parse_duration("0m")
+
+
+if __name__ == "__main__":
+    unittest.main()
