+"""Late-cancellation and no-show fees, in cents."""
+
+import datetime
+
+from .models import CANCELLED, NO_SHOW
+from .pricing import session_price
+
+LATE_CANCELLATION_WINDOW = datetime.timedelta(hours=48)
+LATE_CANCELLATION_PERCENT = 50
+
+
+def cancellation_fee(appointment, cancelled_at=None):
+    """The fee in cents for an appointment that is not attended.
+
+    A cancellation less than 48 hours before the start costs 50% of the session price; an earlier one costs nothing.
+    A no-show pays the full session price. `cancelled_at` is when the patient cancelled; if it is not given, the
+    appointment's own `cancelled_at` is used.
+    """
+    if appointment.status == NO_SHOW:
+        return session_price(appointment.kind)
+    if appointment.status != CANCELLED:
+        return 0
+    if cancelled_at is None:
+        cancelled_at = appointment.cancelled_at
+    if cancelled_at is None:
+        raise ValueError(f"appointment {appointment.id} is cancelled but has no cancellation time")
+    if cancelled_at.tzinfo is None:
+        raise ValueError("cancellation time must be timezone-aware")
+    if appointment.start - cancelled_at < LATE_CANCELLATION_WINDOW:
+        return session_price(appointment.kind) * LATE_CANCELLATION_PERCENT // 100
+    return 0
diff --git a/tests/test_fees.py b/tests/test_fees.py
new file mode 100644
index 0000000..4683b17
--- /dev/null
+++ b/tests/test_fees.py
@@ -0,0 +1,65 @@
+import datetime
+import unittest
+
+from helpers import appt, utc
+from kestrel.fees import cancellation_fee
+from kestrel.models import ASSESSMENT, ATTENDED, BOOKED, CANCELLED, FOLLOWUP, NO_SHOW
+
+START = utc(2026, 10, 20, 3)
+
+
+class LateCancellationTest(unittest.TestCase):
+    def test_under_48_hours_costs_half_the_assessment_price(self):
+        a = appt("a1", START, kind=ASSESSMENT, status=CANCELLED)
+        self.assertEqual(cancellation_fee(a, START - datetime.timedelta(hours=47)), 4750)
+
+    def test_under_48_hours_costs_half_the_followup_price(self):
+        a = appt("a1", START, kind=FOLLOWUP, status=CANCELLED)
+        self.assertEqual(cancellation_fee(a, START - datetime.timedelta(hours=47)), 3500)
+
+    def test_exactly_48_hours_before_is_free(self):
+        a = appt("a1", START, kind=FOLLOWUP, status=CANCELLED)
+        self.assertEqual(cancellation_fee(a, START - datetime.timedelta(hours=48)), 0)
+
+    def test_more_than_48_hours_before_is_free(self):
+        a = appt("a1", START, kind=ASSESSMENT, status=CANCELLED)
+        self.assertEqual(cancellation_fee(a, START - datetime.timedelta(hours=49)), 0)
+
+    def test_uses_the_appointment_cancelled_at_when_none_is_given(self):
+        a = appt("a1", START, kind=FOLLOWUP, status=CANCELLED)
+        a.cancelled_at = START - datetime.timedelta(hours=2)
+        self.assertEqual(cancellation_fee(a), 3500)
+
+    def test_cancelled_without_a_time_is_an_error(self):
+        a = appt("a1", START, kind=FOLLOWUP, status=CANCELLED)
+        with self.assertRaises(ValueError):
+            cancellation_fee(a)
+
+    def test_naive_cancellation_time_is_an_error(self):
+        a = appt("a1", START, kind=FOLLOWUP, status=CANCELLED)
+        with self.assertRaises(ValueError):
+            cancellation_fee(a, datetime.datetime(2026, 10, 18, 3))
+
+
+class NoShowTest(unittest.TestCase):
+    def test_no_show_pays_the_full_assessment_price(self):
+        self.assertEqual(cancellation_fee(appt("a1", START, kind=ASSESSMENT, status=NO_SHOW)), 9500)
+
+    def test_no_show_pays_the_full_followup_price(self):
+        self.assertEqual(cancellation_fee(appt("a1", START, kind=FOLLOWUP, status=NO_SHOW)), 7000)
+
+    def test_no_show_ignores_any_cancellation_time(self):
+        a = appt("a1", START, kind=FOLLOWUP, status=NO_SHOW)
+        self.assertEqual(cancellation_fee(a, START - datetime.timedelta(days=7)), 7000)
+
+
+class OtherStatusTest(unittest.TestCase):
+    def test_booked_appointment_costs_nothing(self):
+        self.assertEqual(cancellation_fee(appt("a1", START, status=BOOKED)), 0)
+
+    def test_attended_appointment_costs_nothing(self):
+        self.assertEqual(cancellation_fee(appt("a1", START, status=ATTENDED)), 0)
+
+
+if __name__ == "__main__":
+    unittest.main()
