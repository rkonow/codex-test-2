+"""Cancellation and no-show fees, in cents."""
+
+import datetime
+
+from .models import CANCELLED, NO_SHOW
+from .pricing import session_price
+
+LATE_CANCELLATION_WINDOW = datetime.timedelta(hours=48)
+
+
+def cancellation_fee(appointment, cancelled_at=None):
+    """The fee owed for an appointment, in cents.
+
+    A cancellation less than 48 hours before the start costs half the session price.
+    A no-show pays the full session price. Anything else costs nothing.
+    `cancelled_at` is when the patient cancelled; it defaults to the time recorded on the appointment.
+    """
+    if appointment.status == NO_SHOW:
+        return session_price(appointment.kind)
+    if appointment.status != CANCELLED:
+        return 0
+    if cancelled_at is None:
+        cancelled_at = appointment.cancelled_at
+    if cancelled_at is None:
+        raise ValueError("cancelled appointment needs a cancellation time")
+    if cancelled_at.tzinfo is None:
+        raise ValueError("cancellation time must be timezone-aware")
+    if appointment.start - cancelled_at < LATE_CANCELLATION_WINDOW:
+        return session_price(appointment.kind) // 2
+    return 0
diff --git a/tests/test_fees.py b/tests/test_fees.py
new file mode 100644
index 0000000..b4e1ce4
--- /dev/null
+++ b/tests/test_fees.py
@@ -0,0 +1,70 @@
+import datetime
+import unittest
+
+from helpers import appt, utc
+from kestrel.fees import cancellation_fee
+from kestrel.models import ASSESSMENT, ATTENDED, BOOKED, CANCELLED, FOLLOWUP, NO_SHOW
+
+START = utc(2026, 10, 20, 9)
+
+
+class CancellationFeeTest(unittest.TestCase):
+    def test_cancelled_less_than_48_hours_ahead_costs_half_the_session_price(self):
+        a = appt("a1", START, kind=ASSESSMENT, status=CANCELLED)
+        self.assertEqual(cancellation_fee(a, START - datetime.timedelta(hours=47, minutes=59)), 4750)
+
+    def test_follow_up_cancelled_late_costs_half_its_price(self):
+        a = appt("a1", START, kind=FOLLOWUP, status=CANCELLED)
+        self.assertEqual(cancellation_fee(a, START - datetime.timedelta(hours=2)), 3500)
+
+    def test_exactly_48_hours_ahead_is_free(self):
+        a = appt("a1", START, kind=ASSESSMENT, status=CANCELLED)
+        self.assertEqual(cancellation_fee(a, START - datetime.timedelta(hours=48)), 0)
+
+    def test_cancelled_after_the_start_costs_half_the_session_price(self):
+        a = appt("a1", START, kind=FOLLOWUP, status=CANCELLED)
+        self.assertEqual(cancellation_fee(a, START + datetime.timedelta(hours=1)), 3500)
+
+    def test_cancelled_well_ahead_is_free(self):
+        a = appt("a1", START, kind=ASSESSMENT, status=CANCELLED)
+        self.assertEqual(cancellation_fee(a, utc(2026, 10, 10, 9)), 0)
+
+    def test_defaults_to_the_recorded_cancellation_time(self):
+        a = appt("a1", START, kind=ASSESSMENT, status=CANCELLED, cancelled_at=START - datetime.timedelta(hours=1))
+        self.assertEqual(cancellation_fee(a), 4750)
+
+    def test_explicit_cancellation_time_overrides_the_recorded_one(self):
+        a = appt("a1", START, kind=ASSESSMENT, status=CANCELLED, cancelled_at=START - datetime.timedelta(hours=1))
+        self.assertEqual(cancellation_fee(a, START - datetime.timedelta(days=3)), 0)
+
+    def test_cancelled_without_any_time_is_an_error(self):
+        a = appt("a1", START, kind=ASSESSMENT, status=CANCELLED)
+        with self.assertRaises(ValueError):
+            cancellation_fee(a)
+
+    def test_naive_cancellation_time_is_an_error(self):
+        a = appt("a1", START, kind=ASSESSMENT, status=CANCELLED)
+        with self.assertRaises(ValueError):
+            cancellation_fee(a, datetime.datetime(2026, 10, 19, 9))
+
+
+class NoShowFeeTest(unittest.TestCase):
+    def test_no_show_pays_the_full_assessment_price(self):
+        a = appt("a1", START, kind=ASSESSMENT, status=NO_SHOW)
+        self.assertEqual(cancellation_fee(a), 9500)
+
+    def test_no_show_pays_the_full_follow_up_price(self):
+        a = appt("a1", START, kind=FOLLOWUP, status=NO_SHOW)
+        self.assertEqual(cancellation_fee(a), 7000)
+
+
+class NoFeeTest(unittest.TestCase):
+    def test_booked_appointment_costs_nothing(self):
+        self.assertEqual(cancellation_fee(appt("a1", START, status=BOOKED)), 0)
+
+    def test_attended_appointment_costs_nothing(self):
+        self.assertEqual(cancellation_fee(appt("a1", START, status=ATTENDED)), 0)
+
+
+if __name__ == "__main__":
+    unittest.main()
