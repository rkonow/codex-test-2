+import unittest
+
+from kestrel.intervals import merge_busy
+
+
+class MergeBusyTest(unittest.TestCase):
+    def test_empty(self):
+        self.assertEqual(merge_busy([]), [])
+
+    def test_sorts_disjoint_intervals(self):
+        self.assertEqual(merge_busy([(5, 6), (1, 2), (3, 4)]), [(1, 2), (3, 4), (5, 6)])
+
+    def test_merges_overlapping(self):
+        self.assertEqual(merge_busy([(1, 4), (3, 6), (2, 3)]), [(1, 6)])
+
+    def test_merges_touching(self):
+        self.assertEqual(merge_busy([(1, 3), (3, 5)]), [(1, 5)])
+
+    def test_contained_interval_does_not_shorten_merged_one(self):
+        self.assertEqual(merge_busy([(1, 10), (2, 3)]), [(1, 10)])
+
+    def test_rejects_interval_ending_before_it_starts(self):
+        with self.assertRaises(ValueError):
+            merge_busy([(5, 4)])
+
+
+if __name__ == "__main__":
+    unittest.main()
