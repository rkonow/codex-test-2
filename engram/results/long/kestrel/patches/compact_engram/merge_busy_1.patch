+"""Helpers for working with (start, end) time intervals."""
+
+
+def merge_busy(intervals):
+    """Merge (start, end) pairs given in any order into sorted, non-overlapping pairs. Touching pairs merge."""
+    merged = []
+    for start, end in sorted(intervals):
+        if end < start:
+            raise ValueError(f"interval ends before it starts: {start} to {end}")
+        if merged and start <= merged[-1][1]:
+            merged[-1] = (merged[-1][0], max(merged[-1][1], end))
+        else:
+            merged.append((start, end))
+    return merged
