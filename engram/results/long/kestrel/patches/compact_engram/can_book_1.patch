+"""Booking rules: can a new appointment go into a therapist's calendar?"""
+
+import datetime
+
+from .calendar import CLINIC_TZ
+from .models import ASSESSMENT, CANCELLED, FOLLOWUP
+
+DURATION = {ASSESSMENT: datetime.timedelta(minutes=45), FOLLOWUP: datetime.timedelta(minutes=30)}
+# Gap the therapist keeps free after an appointment of each kind, for writing notes.
+GAP_AFTER = {ASSESSMENT: datetime.timedelta(minutes=15), FOLLOWUP: datetime.timedelta(0)}
+MAX_PER_DAY = 8
+
+
+def can_book(calendar, therapist, appointment):
+    """True if `appointment` can be added to the calendar for `therapist`, else False.
+
+    Kestrel never overbooks, so nothing may overlap an existing booking, not even to cover no-shows.
+    Cancelled appointments do not count against the calendar.
+    """
+    if appointment.therapist_id != therapist.id:
+        return False
+    local_start = appointment.start.astimezone(CLINIC_TZ)
+    if local_start.minute % 15 or local_start.second or local_start.microsecond:
+        return False
+
+    others = [a for a in calendar.for_therapist(therapist.id) if a.status != CANCELLED and a.id != appointment.id]
+    for other in others:
+        if appointment.start <= other.start:
+            if not _has_room_between(appointment, other):
+                return False
+        elif not _has_room_between(other, appointment):
+            return False
+
+    same_day = [a for a in others if a.start.astimezone(CLINIC_TZ).date() == local_start.date()]
+    return len(same_day) < MAX_PER_DAY
+
+
+def _has_room_between(earlier, later):
+    """The later appointment starts after the earlier one ends and its gap has passed."""
+    free_from = earlier.start + DURATION[earlier.kind] + GAP_AFTER[earlier.kind]
+    return later.start >= free_from
diff --git a/tests/test_booking.py b/tests/test_booking.py
