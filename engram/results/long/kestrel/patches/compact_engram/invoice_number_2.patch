+def next_invoice_number(clinic, year, existing):
+    """Return the next number for a clinic in a year, given every number issued so far (any clinic, any year).
+
+    Sequences are counted per clinic and year, so only numbers for this clinic and year count.
+    Gaps are not refilled: the next number is one more than the highest sequence already issued.
+    """
+    pattern = re.compile(rf"INV-{re.escape(clinic)}-{year:04d}-(\d{{5}})")
+    highest = 0
+    for number in existing:
+        match = pattern.fullmatch(number)
+        if match:
+            highest = max(highest, int(match.group(1)))
+    if highest >= MAX_SEQUENCE:
+        raise ValueError(f"no invoice numbers left for {clinic} in {year}")
+    return f"INV-{clinic}-{year:04d}-{highest + 1:05d}"
