+# Number format for Tui Accounting: INV-<clinic code>-<year>-<sequence>, sequence five digits,
+# restarting at 00001 each year per clinic, e.g. INV-HB-2027-00042.
 
 DESCRIPTIONS = {ASSESSMENT: "Initial assessment", FOLLOWUP: "Follow-up session"}
+MAX_SEQUENCE = 99999
 
 
 @dataclass
@@ -34,3 +35,20 @@ def make_invoice(appointment, patient, number, amount_cents):
         amount_cents=amount_cents,
         description=DESCRIPTIONS[appointment.kind],
     )
+
