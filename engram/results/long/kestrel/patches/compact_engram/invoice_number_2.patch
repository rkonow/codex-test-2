+class NextInvoiceNumberTest(unittest.TestCase):
+    def test_first_invoice_of_the_year_is_00001(self):
+        self.assertEqual(next_invoice_number("HB", 2027, []), "INV-HB-2027-00001")
+
+    def test_continues_after_the_highest_sequence(self):
+        existing = ["INV-HB-2027-00001", "INV-HB-2027-00002", "INV-HB-2027-00041"]
+        self.assertEqual(next_invoice_number("HB", 2027, existing), "INV-HB-2027-00042")
+
+    def test_does_not_depend_on_the_order_of_existing_numbers(self):
+        existing = ["INV-HB-2027-00041", "INV-HB-2027-00001", "INV-HB-2027-00002"]
+        self.assertEqual(next_invoice_number("HB", 2027, existing), "INV-HB-2027-00042")
+
+    def test_counts_each_clinic_separately(self):
+        existing = ["INV-NG-2027-00007", "INV-WK-2027-00003"]
+        self.assertEqual(next_invoice_number("HB", 2027, existing), "INV-HB-2027-00001")
+        self.assertEqual(next_invoice_number("NG", 2027, existing), "INV-NG-2027-00008")
+
+    def test_restarts_at_00001_in_a_new_year(self):
+        existing = ["INV-HB-2026-00150"]
+        self.assertEqual(next_invoice_number("HB", 2027, existing), "INV-HB-2027-00001")
+
+    def test_accepts_any_iterable(self):
+        existing = (n for n in ["INV-HB-2027-00005"])
+        self.assertEqual(next_invoice_number("HB", 2027, existing), "INV-HB-2027-00006")
+
+    def test_ignores_numbers_that_are_not_in_the_format(self):
+        existing = ["INV-HB-2027-0009", "INV-HB-2027-00003x", "HB-2027-00008", "N"]
+        self.assertEqual(next_invoice_number("HB", 2027, existing), "INV-HB-2027-00001")
+
+    def test_does_not_refill_gaps(self):
+        existing = ["INV-HB-2027-00001", "INV-HB-2027-00004"]
+        self.assertEqual(next_invoice_number("HB", 2027, existing), "INV-HB-2027-00005")
+
+    def test_last_sequence_of_the_year_is_still_issued(self):
+        self.assertEqual(next_invoice_number("HB", 2027, ["INV-HB-2027-99998"]), "INV-HB-2027-99999")
+
+    def test_refuses_to_go_past_99999(self):
+        with self.assertRaises(ValueError):
+            next_invoice_number("HB", 2027, ["INV-HB-2027-99999"])
+
+
 if __name__ == "__main__":
     unittest.main()
