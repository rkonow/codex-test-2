 @dataclass
 class Invoice:
@@ -34,3 +37,19 @@ def make_invoice(appointment, patient, number, amount_cents):
         amount_cents=amount_cents,
         description=DESCRIPTIONS[appointment.kind],
     )
+
+
+def next_invoice_number(clinic, year, existing):
+    """Return the next INV-<clinic>-<year>-<sequence> number after the ones in `existing` for that clinic and year.
+
+    `existing` may hold numbers from any clinic and year; only exact matches for this clinic and year count.
+    """
+    sequences = []
+    for number in existing:
+        match = _NUMBER.fullmatch(number)
+        if match and match.group(1) == clinic and int(match.group(2)) == year:
+            sequences.append(int(match.group(3)))
+    next_sequence = max(sequences, default=0) + 1
+    if next_sequence > 99999:
+        raise ValueError(f"no invoice numbers left for {clinic} {year}")
+    return f"INV-{clinic}-{year:04d}-{next_sequence:05d}"
