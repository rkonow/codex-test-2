 """Session prices, in cents."""
 
+import datetime
+
+from .calendar import CLINIC_TZ
 from .models import ASSESSMENT, FOLLOWUP
 
+# Prices for appointments on or after PRICE_CHANGE_DATE (Auckland local date).
+PRICE_CHANGE_DATE = datetime.date(2027, 4, 1)
 PRICES_CENTS = {
     ASSESSMENT: 9500,  # $95
     FOLLOWUP: 7000,  # $70
 }
+NEW_PRICES_CENTS = {
+    ASSESSMENT: 10500,  # $105
+    FOLLOWUP: 7800,  # $78
+}
 
 
-def session_price(kind):
-    """The price of one session of `kind`, in cents."""
-    if kind not in PRICES_CENTS:
+def session_price(kind, day):
+    """The price of one session of `kind` on the Auckland local date `day`, in cents."""
+    prices = NEW_PRICES_CENTS if day >= PRICE_CHANGE_DATE else PRICES_CENTS
+    if kind not in prices:
         raise ValueError(f"unknown kind {kind!r}")
-    return PRICES_CENTS[kind]
+    return prices[kind]
+
+
+def appointment_price(appointment, patient):
+    """What the patient pays for this appointment, in cents.
+
+    The price is set by the appointment's Auckland local date, not when it was booked.
+    CSC holders get 20% off follow-ups but not assessments.
+    """
+    day = appointment.start.astimezone(CLINIC_TZ).date()
+    price = session_price(appointment.kind, day)
+    if patient.csc and appointment.kind == FOLLOWUP:
+        price = price * 80 // 100  # whole cents, so this is exact for these prices
+    return price
