+class AppointmentPriceTest(unittest.TestCase):
+    def test_assessment_price(self):
+        self.assertEqual(appointment_price(appt("a1", utc(2027, 1, 5, 1), kind=ASSESSMENT), patient()), 9500)
+
+    def test_follow_up_price(self):
+        self.assertEqual(appointment_price(appt("a1", utc(2027, 1, 5, 1), kind=FOLLOWUP), patient()), 7000)
+
+    def test_price_is_set_by_appointment_date_not_booking_date(self):
+        # Booked any time, but on 31 March Auckland time, so it keeps the old price.
+        self.assertEqual(appointment_price(appt("a1", utc(2027, 3, 31, 10), kind=FOLLOWUP), patient()), 7000)
+
+    def test_switches_at_midnight_auckland_time_on_1_april(self):
+        # 31 Mar 11:00 UTC is 1 Apr 00:00 in Auckland (NZDT, UTC+13).
+        self.assertEqual(appointment_price(appt("a1", utc(2027, 3, 31, 11), kind=ASSESSMENT), patient()), 10500)
+        self.assertEqual(appointment_price(appt("a2", utc(2027, 3, 31, 10), kind=ASSESSMENT), patient()), 9500)
+
+    def test_new_prices_apply_on_later_dates(self):
+        self.assertEqual(appointment_price(appt("a1", utc(2027, 6, 1, 1), kind=FOLLOWUP), patient()), 7800)
+
+    def test_csc_follow_up_gets_20_percent_off(self):
