+"""Monthly invoice export for the accountants (Xero import)."""
+
+import csv
+import datetime
+import os
+
+from .invoices import Invoice
+
+HEADER = ["Invoice Number", "Clinic", "Patient ID", "Date", "Amount", "Description"]
+
+
+def export_invoices(invoices, year, month, out_dir):
+    """Write the invoices issued in the given month to kestrel-invoices-YYYY-MM.csv in out_dir. Returns the path."""
+    chosen = sorted(
+        (i for i in invoices if i.issued.year == year and i.issued.month == month),
+        key=lambda i: (i.issued, i.number),
+    )
+    path = os.path.join(out_dir, f"kestrel-invoices-{year:04d}-{month:02d}.csv")
+    with open(path, "w", encoding="utf-8", newline="") as f:
+        writer = csv.writer(f)
+        writer.writerow(HEADER)
+        for invoice in chosen:
+            writer.writerow(_row(invoice))
+    return path
+
+
+def _row(invoice):
+    return [
+        invoice.number,
+        invoice.clinic,
+        invoice.patient_id,
+        _date(invoice.issued),
+        _amount(invoice.amount_cents),
+        invoice.description,
+    ]
+
+
+def _date(day):
+    return day.strftime("%d/%m/%Y")
+
+
+def _amount(cents):
+    """Plain dollars with two decimals and no dollar sign, e.g. 9500 -> 95.00, 7 -> 0.07."""
+    return f"{cents // 100}.{cents % 100:02d}"
