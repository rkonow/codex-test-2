+import unittest
+
+from kestrel.intervals import merge_busy
+
+
+class MergeBusyTest(unittest.TestCase):
+    def test_empty(self):
+        self.assertEqual(merge_busy([]), [])
+
+    def test_single_pair(self):
+        self.assertEqual(merge_busy([(1, 2)]), [(1, 2)])
+
+    def test_sorts_unordered_pairs(self):
+        self.assertEqual(merge_busy([(5, 6), (1, 2), (3, 4)]), [(1, 2), (3, 4), (5, 6)])
+
+    def test_merges_overlapping_pairs(self):
+        self.assertEqual(merge_busy([(1, 4), (3, 6), (8, 9)]), [(1, 6), (8, 9)])
+
+    def test_merges_touching_pairs(self):
+        self.assertEqual(merge_busy([(1, 3), (3, 5)]), [(1, 5)])
+
+    def test_contained_pair_does_not_shorten_merged_pair(self):
+        self.assertEqual(merge_busy([(1, 10), (2, 3)]), [(1, 10)])
+
+    def test_merges_chain_in_any_order(self):
+        self.assertEqual(merge_busy([(5, 7), (1, 2), (2, 5)]), [(1, 7)])
+
+
+if __name__ == "__main__":
+    unittest.main()
