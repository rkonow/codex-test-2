+"""Cancellation fees, in cents."""
+
+import datetime
+
+from .models import CANCELLED, NO_SHOW
+from .pricing import session_price
+
+LATE_CANCELLATION_WINDOW = datetime.timedelta(hours=48)
+LATE_CANCELLATION_PERCENT = 50
+
+
+def cancellation_fee(appointment, cancelled_at=None):
+    """The fee for a cancelled or no-show appointment, in cents.
+
+    Cancelling less than 48 hours before the start costs 50% of the session price; earlier is free.
+    A no-show pays the full session price. `cancelled_at` is when the patient cancelled and is only
+    used for cancelled appointments; it defaults to the time recorded on the appointment.
+    """
+    price = session_price(appointment.kind)
+    if appointment.status == NO_SHOW:
+        return price
+    if appointment.status != CANCELLED:
+        raise ValueError(f"no cancellation fee for status {appointment.status!r}")
+    if cancelled_at is None:
+        cancelled_at = appointment.cancelled_at
+    if cancelled_at is None:
+        raise ValueError("cancelled appointment needs a cancellation time")
+    if cancelled_at.tzinfo is None:
+        raise ValueError("cancellation time must be timezone-aware")
+    if appointment.start - cancelled_at < LATE_CANCELLATION_WINDOW:
+        return price * LATE_CANCELLATION_PERCENT // 100
+    return 0
diff --git a/tests/test_fees.py b/tests/test_fees.py
new file mode 100644
index 0000000..5571668
--- /dev/null
+++ b/tests/test_fees.py
@@ -0,0 +1,70 @@
+import datetime
+import unittest
+
+from helpers import appt, utc
+from kestrel.fees import cancellation_fee
+from kestrel.models import ASSESSMENT, ATTENDED, BOOKED, CANCELLED, FOLLOWUP, NO_SHOW
+
+START = utc(2026, 10, 20, 9)
+
+
+class CancellationFeeTest(unittest.TestCase):
+    def test_cancelled_more_than_48_hours_ahead_is_free(self):
+        a = appt("a1", START, kind=ASSESSMENT, status=CANCELLED)
+        self.assertEqual(cancellation_fee(a, utc(2026, 10, 18, 8, 59)), 0)
+
+    def test_cancelled_exactly_48_hours_ahead_is_free(self):
+        a = appt("a1", START, kind=ASSESSMENT, status=CANCELLED)
+        self.assertEqual(cancellation_fee(a, utc(2026, 10, 18, 9)), 0)
+
+    def test_cancelled_less_than_48_hours_ahead_is_half_the_price(self):
+        a = appt("a1", START, kind=ASSESSMENT, status=CANCELLED)
+        self.assertEqual(cancellation_fee(a, utc(2026, 10, 18, 9, 1)), 4750)
+
+    def test_late_cancellation_of_follow_up_is_half_its_price(self):
+        a = appt("a1", START, kind=FOLLOWUP, status=CANCELLED)
+        self.assertEqual(cancellation_fee(a, utc(2026, 10, 19, 9)), 3500)
+
+    def test_late_cancellation_uses_the_passed_time_over_the_recorded_one(self):
+        a = appt("a1", START, kind=FOLLOWUP, status=CANCELLED, cancelled_at=utc(2026, 10, 10, 9))
+        self.assertEqual(cancellation_fee(a, utc(2026, 10, 19, 9)), 3500)
+
+    def test_cancelled_uses_recorded_time_when_none_passed(self):
+        a = appt("a1", START, kind=FOLLOWUP, status=CANCELLED, cancelled_at=utc(2026, 10, 19, 9))
+        self.assertEqual(cancellation_fee(a), 3500)
+
+    def test_cancelled_without_any_time_is_an_error(self):
+        a = appt("a1", START, kind=FOLLOWUP, status=CANCELLED)
+        with self.assertRaises(ValueError):
+            cancellation_fee(a)
+
+    def test_naive_cancellation_time_is_an_error(self):
+        a = appt("a1", START, kind=FOLLOWUP, status=CANCELLED)
+        with self.assertRaises(ValueError):
+            cancellation_fee(a, datetime.datetime(2026, 10, 19, 9))
+
+    def test_no_show_pays_full_price_for_assessment(self):
+        a = appt("a1", START, kind=ASSESSMENT, status=NO_SHOW)
+        self.assertEqual(cancellation_fee(a), 9500)
+
+    def test_no_show_pays_full_price_for_follow_up(self):
+        a = appt("a1", START, kind=FOLLOWUP, status=NO_SHOW)
+        self.assertEqual(cancellation_fee(a), 7000)
+
+    def test_no_show_ignores_any_cancellation_time(self):
+        a = appt("a1", START, kind=FOLLOWUP, status=NO_SHOW)
+        self.assertEqual(cancellation_fee(a, utc(2026, 10, 1)), 7000)
+
+    def test_booked_has_no_cancellation_fee(self):
+        a = appt("a1", START, kind=FOLLOWUP, status=BOOKED)
+        with self.assertRaises(ValueError):
+            cancellation_fee(a)
+
+    def test_attended_has_no_cancellation_fee(self):
+        a = appt("a1", START, kind=FOLLOWUP, status=ATTENDED)
+        with self.assertRaises(ValueError):
+            cancellation_fee(a)
+
+
+if __name__ == "__main__":
+    unittest.main()
