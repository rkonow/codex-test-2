diff --git a/src/kestrel/waitlist.py b/src/kestrel/waitlist.py
index 479b6a7..afd73d7 100644
--- a/src/kestrel/waitlist.py
+++ b/src/kestrel/waitlist.py
@@ -42,3 +42,15 @@ class Waitlist:
     def entries(self):
         """Urgent entries first, then everyone else; each group in the order they asked."""
         return sorted(self._entries.values(), key=lambda e: (not e.urgent, e.requested_at))
+
+    def next_for(self, kind):
+        """The entry to offer a freed slot of this kind to, or None if nobody is waiting for that kind.
+
+        Does not remove the entry: the patient may decline, and the entry stays until removed.
+        """
+        if kind not in KINDS:
+            raise ValueError(f"unknown kind {kind!r}")
+        for entry in self.entries():
+            if entry.kind == kind:
+                return entry
+        return None
diff --git a/tests/test_waitlist.py b/tests/test_waitlist.py
index 8986335..b6fdb36 100644
--- a/tests/test_waitlist.py
+++ b/tests/test_waitlist.py
@@ -99,5 +99,44 @@ class WaitlistTest(unittest.TestCase):
         self.assertEqual(dataclasses.replace(original, patient_id="KP-000001"), waitlist.entries()[0])
 
 
+class NextForTest(unittest.TestCase):
+    def test_none_when_waitlist_is_empty(self):
+        self.assertIsNone(Waitlist().next_for(FOLLOWUP))
+
+    def test_none_when_nobody_waits_for_that_kind(self):
+        waitlist = Waitlist()
+        waitlist.add(entry("KP-000001", kind=ASSESSMENT))
+        self.assertIsNone(waitlist.next_for(FOLLOWUP))
+
+    def test_returns_earliest_request_of_that_kind(self):
+        waitlist = Waitlist()
+        waitlist.add(entry("KP-000001", requested=utc(2026, 10, 12, 5)))
+        waitlist.add(entry("KP-000002", requested=utc(2026, 10, 12, 1)))
+        self.assertEqual(waitlist.next_for(FOLLOWUP).patient_id, "KP-000002")
+
+    def test_urgent_entry_of_that_kind_beats_earlier_routine_one(self):
+        waitlist = Waitlist()
+        waitlist.add(entry("KP-000001", requested=utc(2026, 10, 12, 1)))
+        waitlist.add(entry("KP-000002", requested=utc(2026, 10, 12, 5), urgent=True))
+        self.assertEqual(waitlist.next_for(FOLLOWUP).patient_id, "KP-000002")
+
+    def test_ignores_entries_of_other_kinds(self):
+        waitlist = Waitlist()
+        waitlist.add(entry("KP-000001", kind=ASSESSMENT, requested=utc(2026, 10, 12, 1), urgent=True))
+        waitlist.add(entry("KP-000002", kind=FOLLOWUP, requested=utc(2026, 10, 12, 5)))
+        self.assertEqual(waitlist.next_for(FOLLOWUP).patient_id, "KP-000002")
+        self.assertEqual(waitlist.next_for(ASSESSMENT).patient_id, "KP-000001")
+
+    def test_does_not_remove_the_entry(self):
+        waitlist = Waitlist()
+        waitlist.add(entry("KP-000001"))
+        waitlist.next_for(FOLLOWUP)
+        self.assertEqual(len(waitlist.entries()), 1)
+
+    def test_unknown_kind_is_an_error(self):
+        with self.assertRaises(ValueError):
+            Waitlist().next_for("massage")
+
+
 if __name__ == "__main__":
     unittest.main()
