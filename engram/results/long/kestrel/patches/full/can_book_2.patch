+"""Checks the booking form runs before an appointment is saved."""
+
+import datetime
+
+from .models import ASSESSMENT, CANCELLED, FOLLOWUP
+
+# How long each kind of session takes.
+DURATIONS = {
+    ASSESSMENT: datetime.timedelta(minutes=45),
+    FOLLOWUP: datetime.timedelta(minutes=30),
+}
+
+# Time the therapist needs after a session before the next patient: 15 minutes
+# for notes after an assessment, none after a follow-up.
+NOTES_GAPS = {
+    ASSESSMENT: datetime.timedelta(minutes=15),
+    FOLLOWUP: datetime.timedelta(0),
+}
+
+
+def _occupied(appointment):
+    """The time window the therapist is busy for this appointment, including any notes gap."""
+    end = appointment.start + DURATIONS[appointment.kind] + NOTES_GAPS[appointment.kind]
+    return appointment.start, end
+
+
+def can_book(calendar, therapist, appointment):
+    """True if `appointment` can be added to `calendar` for `therapist` without overlapping anything.
+
+    Cancelled appointments do not block a slot. Windows that only touch (one ends
+    exactly when the next starts) do not overlap.
+    """
+    if appointment.therapist_id != therapist.id:
+        return False
+    if appointment.id in calendar:
+        return False
+    new_start, new_end = _occupied(appointment)
+    for other in calendar.for_therapist(therapist.id):
+        if other.status == CANCELLED:
+            continue
+        other_start, other_end = _occupied(other)
+        if new_start < other_end and other_start < new_end:
+            return False
+    return True
