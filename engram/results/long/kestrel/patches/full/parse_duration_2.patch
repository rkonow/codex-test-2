@@ -0,0 +1,27 @@
+"""Durations written the way reception types them."""
+
+import re
+
+_MINUTES = re.compile(r"(\d+)m")
+_HOURS = re.compile(r"(\d+)h")
+_HOURS_MINUTES = re.compile(r"(\d+)h\s*(\d{1,2})m?")
+
+
+def parse_duration(text):
+    """Turn '45m', '1h', '1h30' or '1h 30m' into a number of minutes.
+
+    Raises ValueError for anything else, including zero and minutes of 60 or more after hours.
+    """
+    value = text.strip().lower()
+    minutes = None
+    if _MINUTES.fullmatch(value):
+        minutes = int(value[:-1])
+    elif _HOURS.fullmatch(value):
+        minutes = int(value[:-1]) * 60
+    else:
+        match = _HOURS_MINUTES.fullmatch(value)
+        if match and int(match.group(2)) < 60:
+            minutes = int(match.group(1)) * 60 + int(match.group(2))
+    if not minutes:
+        raise ValueError(f"not a duration: {text!r}")
+    return minutes
diff --git a/tests/test_intervals.py b/tests/test_intervals.py
