@@ -0,0 +1,61 @@
+import datetime
+import unittest
+
+from helpers import appt, utc
+from kestrel.fees import cancellation_fee
+from kestrel.models import ASSESSMENT, FOLLOWUP
+
+
+START = utc(2027, 3, 10, 20)  # 09:00 on 11 March, Auckland
+
+
+class CancellationFeeTest(unittest.TestCase):
+    def cancelled(self, kind=FOLLOWUP):
+        return appt("a1", START, kind=kind, status="cancelled")
+
+    def test_late_cancellation_costs_half(self):
+        fee = cancellation_fee(self.cancelled(), utc(2027, 3, 9, 21))  # 23 hours before
+        self.assertEqual(fee, 3500)
+
+    def test_late_cancellation_assessment_costs_half(self):
+        fee = cancellation_fee(self.cancelled(kind=ASSESSMENT), utc(2027, 3, 10, 1))
+        self.assertEqual(fee, 4750)
+
+    def test_cancellation_at_48_hours_is_free(self):
+        self.assertEqual(cancellation_fee(self.cancelled(), START - datetime.timedelta(hours=48)), 0)
+
+    def test_just_inside_48_hours_is_half(self):
+        at = START - datetime.timedelta(hours=48) + datetime.timedelta(minutes=1)
+        self.assertEqual(cancellation_fee(self.cancelled(), at), 3500)
+
+    def test_early_cancellation_is_free(self):
+        self.assertEqual(cancellation_fee(self.cancelled(), utc(2027, 3, 1, 0)), 0)
+
+    def test_compares_instants_across_time_zones(self):
+        # Same instant as 2027-03-09 21:00 UTC, written with a +02:00 offset.
+        at = datetime.datetime(2027, 3, 10, 0, 0, tzinfo=datetime.timezone(datetime.timedelta(hours=2)))
+        self.assertEqual(cancellation_fee(self.cancelled(), at), 3500)
+
+    def test_cancelled_needs_a_time(self):
+        with self.assertRaises(ValueError):
+            cancellation_fee(self.cancelled(), None)
+
+    def test_cancelled_time_must_be_aware(self):
+        with self.assertRaises(ValueError):
+            cancellation_fee(self.cancelled(), datetime.datetime(2027, 3, 9, 21))
+
+    def test_no_show_pays_full_price(self):
+        self.assertEqual(cancellation_fee(appt("a1", START, kind=FOLLOWUP, status="no_show")), 7000)
+        self.assertEqual(cancellation_fee(appt("a1", START, kind=ASSESSMENT, status="no_show")), 9500)
+
+    def test_no_show_takes_no_cancellation_time(self):
+        with self.assertRaises(ValueError):
+            cancellation_fee(appt("a1", START, status="no_show"), utc(2027, 3, 9, 21))
+
+    def test_other_statuses_have_no_fee(self):
+        self.assertEqual(cancellation_fee(appt("a1", START, status="booked")), 0)
+        self.assertEqual(cancellation_fee(appt("a1", START, status="attended")), 0)
+
+
+if __name__ == "__main__":
+    unittest.main()
