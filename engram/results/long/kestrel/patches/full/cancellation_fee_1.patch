+"""Cancellation and no-show fees."""
+
+import datetime
+
+from .models import CANCELLED, NO_SHOW
+from .pricing import session_price
+
+# A cancellation less than this long before the start costs half the session price.
+LATE_CANCELLATION_WINDOW = datetime.timedelta(hours=48)
+
+
+def cancellation_fee(appointment, cancelled_at=None):
+    """The fee in cents for `appointment`.
+
+    A cancelled appointment costs 50% of the session price if it was cancelled
+    less than 48 hours before the start, and nothing otherwise. `cancelled_at`
+    is when the patient cancelled, and is required for a cancelled appointment.
+
+    A no-show pays the full session price; `cancelled_at` must be None for it.
+    Any other status has no fee.
+    """
+    price = session_price(appointment.kind)
+    if appointment.status == NO_SHOW:
+        if cancelled_at is not None:
+            raise ValueError("a no-show has no cancellation time")
+        return price
+    if appointment.status == CANCELLED:
+        if cancelled_at is None:
+            raise ValueError("a cancelled appointment needs its cancellation time")
+        if cancelled_at.tzinfo is None:
+            raise ValueError("cancelled_at must be timezone-aware")
+        notice = appointment.start - cancelled_at
+        return price // 2 if notice < LATE_CANCELLATION_WINDOW else 0
+    return 0
diff --git a/tests/test_fees.py b/tests/test_fees.py
