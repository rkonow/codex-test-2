+"""Time intervals."""
+
+
+def merge_busy(intervals):
+    """Merge (start, end) pairs into sorted, non-overlapping pairs.
+
+    Input can be in any order. Pairs that overlap or touch (one ends where the
+    next starts) become one pair. Raises ValueError if any end is before its start.
+    """
+    pairs = sorted(intervals)
+    merged = []
+    for start, end in pairs:
+        if end < start:
+            raise ValueError(f"interval ends before it starts: {(start, end)!r}")
+        if merged and start <= merged[-1][1]:
+            merged[-1] = (merged[-1][0], max(merged[-1][1], end))
+        else:
+            merged.append((start, end))
+    return merged
