@@ -0,0 +1,49 @@
+import unittest
+
+from helpers import utc
+from kestrel.intervals import merge_busy
+
+
+def t(hour, minute=0):
+    return utc(2027, 3, 1, hour, minute)
+
+
+class MergeBusyTest(unittest.TestCase):
+    def test_empty(self):
+        self.assertEqual(merge_busy([]), [])
+
+    def test_sorts_out_of_order_pairs(self):
+        self.assertEqual(merge_busy([(t(14), t(15)), (t(9), t(10))]), [(t(9), t(10)), (t(14), t(15))])
+
+    def test_keeps_disjoint_pairs_apart(self):
+        pairs = [(t(9), t(9, 45)), (t(10), t(10, 30))]
+        self.assertEqual(merge_busy(pairs), pairs)
+
+    def test_merges_overlapping_pairs(self):
+        self.assertEqual(merge_busy([(t(9), t(10)), (t(9, 30), t(11))]), [(t(9), t(11))])
+
+    def test_merges_touching_pairs(self):
+        self.assertEqual(merge_busy([(t(9), t(10)), (t(10), t(11))]), [(t(9), t(11))])
+
+    def test_one_pair_containing_others(self):
+        self.assertEqual(merge_busy([(t(9), t(17)), (t(10), t(11)), (t(12), t(13))]), [(t(9), t(17))])
+
+    def test_chain_of_overlaps(self):
+        pairs = [(t(9), t(9, 30)), (t(9, 20), t(10)), (t(9, 50), t(11))]
+        self.assertEqual(merge_busy(pairs), [(t(9), t(11))])
+
+    def test_zero_length_pair(self):
+        self.assertEqual(merge_busy([(t(9), t(9))]), [(t(9), t(9))])
+
+    def test_rejects_pair_ending_before_start(self):
+        with self.assertRaises(ValueError):
+            merge_busy([(t(10), t(9))])
+
+    def test_does_not_modify_input(self):
+        pairs = [(t(14), t(15)), (t(9), t(10))]
+        merge_busy(pairs)
+        self.assertEqual(pairs, [(t(14), t(15)), (t(9), t(10))])
+
+
+if __name__ == "__main__":
+    unittest.main()
