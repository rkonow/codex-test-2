+"""Busy time as (start, end) intervals."""
+
+
+def merge_busy(intervals):
+    """Merge (start, end) pairs given in any order into sorted, non-overlapping pairs.
+
+    Pairs that touch (one ends exactly where the next starts) are merged too.
+    Raises ValueError if any pair ends before it starts.
+    """
+    pairs = sorted(intervals)
+    merged = []
+    for start, end in pairs:
+        if end < start:
+            raise ValueError(f"interval ends before it starts: {(start, end)!r}")
+        if merged and start <= merged[-1][1]:
+            if end > merged[-1][1]:
+                merged[-1] = (merged[-1][0], end)
+        else:
+            merged.append((start, end))
+    return merged
diff --git a/tests/test_intervals.py b/tests/test_intervals.py
