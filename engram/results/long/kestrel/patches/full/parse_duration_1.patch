@@ -0,0 +1,27 @@
+"""Durations such as '45m', '1h' and '1h30' in minutes."""
+
+import re
+
+_DURATION = re.compile(r"(?:(\d+)\s*h\s*(?:(\d+)\s*m?)?|(\d+)\s*m)")
+
+
+def parse_duration(text):
+    """Turn '45m', '1h', '1h30' or '1h 30m' into minutes.
+
+    Raises ValueError for anything else, including a bare number like '45' and a
+    zero-length duration.
+    """
+    match = _DURATION.fullmatch(text.strip().lower())
+    if match is None:
+        raise ValueError(f"not a duration: {text!r}")
+    hours, minutes_after_hours, minutes_alone = match.groups()
+    if hours is None:
+        minutes = int(minutes_alone)
+    else:
+        minutes = int(minutes_after_hours or 0)
+        if minutes >= 60:
+            raise ValueError(f"minutes must be under 60 when hours are given: {text!r}")
+        minutes += 60 * int(hours)
+    if minutes == 0:
+        raise ValueError(f"duration must be more than zero: {text!r}")
+    return minutes
diff --git a/tests/test_intervals.py b/tests/test_intervals.py
new file mode 100644
index 0000000..fd62364
--- /dev/null
+++ b/tests/test_intervals.py
@@ -0,0 +1,26 @@
+import unittest
+
+from kestrel.intervals import parse_duration
+
+
+class ParseDurationTest(unittest.TestCase):
+    def test_minutes(self):
+        self.assertEqual(parse_duration("45m"), 45)
+
+    def test_hours(self):
+        self.assertEqual(parse_duration("1h"), 60)
+
+    def test_hours_and_minutes(self):
+        for text in ["1h30", "1h30m", "1h 30m", "1h 30", "1H30M", " 1h30 "]:
+            with self.subTest(text=text):
+                self.assertEqual(parse_duration(text), 90)
+
+    def test_rejects_everything_else(self):
+        for text in ["", "45", "h", "m", "1.5h", "-30m", "1h60", "1h90m", "30s", "0m", "0h", "1d", "45 minutes", "1h m"]:
+            with self.subTest(text=text):
+                with self.assertRaises(ValueError):
+                    parse_duration(text)
+
+
+if __name__ == "__main__":
+    unittest.main()
