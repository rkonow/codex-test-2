diff --git a/src/kestrel/calendar.py b/src/kestrel/calendar.py
index a27a3b2..c49e49d 100644
--- a/src/kestrel/calendar.py
+++ b/src/kestrel/calendar.py
@@ -60,6 +60,12 @@ class Calendar:
         patient_id = normalize_patient_id(patient_id)
         return [a for a in self.all() if a.patient_id == patient_id]
 
+    def upcoming(self, patient_id, now):
+        """A patient's booked appointments starting after `now` (timezone-aware), soonest first."""
+        if now.tzinfo is None:
+            raise ValueError("now must be timezone-aware")
+        return [a for a in self.for_patient(patient_id) if a.status == BOOKED and a.start > now]
+
     def booked(self):
         return [a for a in self.all() if a.status == BOOKED]
 
diff --git a/tests/test_calendar.py b/tests/test_calendar.py
index 7af7626..daebd66 100644
--- a/tests/test_calendar.py
+++ b/tests/test_calendar.py
@@ -113,6 +113,42 @@ class CalendarTest(unittest.TestCase):
         with self.assertRaises(KeyError):
             Calendar().move("nope", utc(2027, 3, 2, 9))
 
+    def test_upcoming_soonest_first(self):
+        cal = Calendar([
+            appt("a2", utc(2027, 3, 3, 9), patient="KP-000001"),
+            appt("a1", utc(2027, 3, 2, 9), patient="KP-000001"),
+        ])
+        self.assertEqual([a.id for a in cal.upcoming("KP-000001", utc(2027, 3, 1, 0))], ["a1", "a2"])
+
+    def test_upcoming_excludes_past_and_exact_now(self):
+        cal = Calendar([
+            appt("past", utc(2027, 2, 28, 9), patient="KP-000001"),
+            appt("now", utc(2027, 3, 1, 9), patient="KP-000001"),
+            appt("later", utc(2027, 3, 1, 10), patient="KP-000001"),
+        ])
+        self.assertEqual([a.id for a in cal.upcoming("KP-000001", utc(2027, 3, 1, 9))], ["later"])
+
+    def test_upcoming_only_booked(self):
+        cal = Calendar([
+            appt("cancelled", utc(2027, 3, 2, 9), patient="KP-000001", status="cancelled"),
+            appt("attended", utc(2027, 3, 2, 10), patient="KP-000001", status="attended"),
+            appt("no_show", utc(2027, 3, 2, 11), patient="KP-000001", status="no_show"),
+            appt("booked", utc(2027, 3, 2, 12), patient="KP-000001"),
+        ])
+        self.assertEqual([a.id for a in cal.upcoming("KP-000001", utc(2027, 3, 1, 0))], ["booked"])
+
+    def test_upcoming_only_that_patient(self):
+        cal = Calendar([
+            appt("mine", utc(2027, 3, 2, 9), patient="KP-004211"),
+            appt("theirs", utc(2027, 3, 2, 10), patient="KP-000007"),
+        ])
+        self.assertEqual([a.id for a in cal.upcoming("kp4211", utc(2027, 3, 1, 0))], ["mine"])
+
+    def test_upcoming_rejects_naive_now(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 2, 9), patient="KP-000001")])
+        with self.assertRaises(ValueError):
+            cal.upcoming("KP-000001", datetime.datetime(2027, 3, 1, 0))
+
     def test_booked(self):
         cal = Calendar([appt("a1", utc(2027, 3, 1, 20)), appt("a2", utc(2027, 3, 1, 21), status="cancelled")])
         self.assertEqual([a.id for a in cal.booked()], ["a1"])
