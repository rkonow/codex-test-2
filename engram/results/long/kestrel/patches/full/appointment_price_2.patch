+class AppointmentPriceTest(unittest.TestCase):
+    def test_assessment_before_change(self):
+        a = appt("a1", utc(2027, 3, 1, 20), kind=ASSESSMENT)
+        self.assertEqual(appointment_price(a, PATIENT), 9500)
+
+    def test_followup_after_change(self):
+        a = appt("a1", utc(2027, 4, 5, 1), kind=FOLLOWUP)  # 14:00 on 5 Apr, Auckland
+        self.assertEqual(appointment_price(a, PATIENT), 7800)
+
+    def test_change_is_on_local_date_not_utc(self):
+        # 31 Mar 23:00 local is 10:00 UTC on 31 Mar: still the old price.
+        before = appt("a1", utc(2027, 3, 31, 10), kind=FOLLOWUP)
+        # 1 Apr 01:00 local is 12:00 UTC on 31 Mar: already the new price.
+        after = appt("a2", utc(2027, 3, 31, 12), kind=FOLLOWUP)
+        self.assertEqual(appointment_price(before, PATIENT), 7000)
+        self.assertEqual(appointment_price(after, PATIENT), 7800)
+
+    def test_csc_followup_gets_20_percent_off(self):
+        before = appt("a1", utc(2027, 3, 1, 20), kind=FOLLOWUP)
+        after = appt("a2", utc(2027, 4, 5, 1), kind=FOLLOWUP)
+        self.assertEqual(appointment_price(before, CSC_PATIENT), 5600)
+        self.assertEqual(appointment_price(after, CSC_PATIENT), 6240)
+
+    def test_csc_assessment_gets_no_discount(self):
+        a = appt("a1", utc(2027, 4, 5, 1), kind=ASSESSMENT)
+        self.assertEqual(appointment_price(a, CSC_PATIENT), 10500)
+
+    def test_patient_must_match_appointment(self):
+        a = appt("a1", utc(2027, 4, 5, 1), patient="KP-000002")
+        with self.assertRaises(ValueError):
+            appointment_price(a, PATIENT)
+
+    def test_patient_id_is_normalized_for_matching(self):
