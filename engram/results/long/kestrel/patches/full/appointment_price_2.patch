 """Session prices, in cents (NZD)."""
 
+import datetime
+
+from .calendar import LOCAL_TZ
+from .ids import normalize_patient_id
 from .models import ASSESSMENT, FOLLOWUP
 
-PRICES_CENTS = {
+# Appointments on or after this local (Auckland) date pay the new prices.
+PRICE_CHANGE_DATE = datetime.date(2027, 4, 1)
+
+PRICES_BEFORE_CHANGE_CENTS = {
     ASSESSMENT: 9500,
     FOLLOWUP: 7000,
 }
 
+PRICES_FROM_CHANGE_CENTS = {
+    ASSESSMENT: 10500,
+    FOLLOWUP: 7800,
+}
+
+# Community Services Card holders get this percentage off follow-ups, not assessments.
+CSC_FOLLOWUP_DISCOUNT_PERCENT = 20
+
 
-def session_price(kind):
-    """The full price of a session of `kind`, in cents. CSC discounts are not applied here."""
+def session_price(kind, day):
+    """The full price of a session of `kind` on the local date `day`, in cents.
+
+    CSC discounts are not applied here; see appointment_price.
+    """
+    prices = PRICES_FROM_CHANGE_CENTS if day >= PRICE_CHANGE_DATE else PRICES_BEFORE_CHANGE_CENTS
     try:
-        return PRICES_CENTS[kind]
+        return prices[kind]
     except KeyError:
         raise ValueError(f"unknown kind {kind!r}") from None
+
+
+def appointment_price(appointment, patient):
+    """What `patient` pays for `appointment`, in cents.
+
+    Priced on the appointment's local (Auckland) date. CSC holders get 20% off
+    follow-ups. This is the session price only: late-cancellation and no-show
+    fees are not included.
+    """
+    if normalize_patient_id(patient.id) != appointment.patient_id:
+        raise ValueError(f"appointment is for {appointment.patient_id}, not {patient.id}")
+    day = appointment.start.astimezone(LOCAL_TZ).date()
+    price = session_price(appointment.kind, day)
+    if patient.csc and appointment.kind == FOLLOWUP:
+        price = price * (100 - CSC_FOLLOWUP_DISCOUNT_PERCENT) // 100
+    return price
