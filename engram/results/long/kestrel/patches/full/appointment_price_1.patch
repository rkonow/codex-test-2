+import datetime
 
-PRICES_CENTS = {
+from .calendar import LOCAL_TZ
+from .models import ASSESSMENT, ATTENDED, BOOKED, CANCELLED, FOLLOWUP, NO_SHOW, KINDS
+
+# Prices from 1 April 2027 (local date). Appointments before that keep the old prices.
+PRICE_CHANGE = datetime.date(2027, 4, 1)
+PRICES_BEFORE_CHANGE_CENTS = {
     ASSESSMENT: 9500,
     FOLLOWUP: 7000,
 }
+PRICES_FROM_CHANGE_CENTS = {
+    ASSESSMENT: 10500,
+    FOLLOWUP: 7800,
+}
+
+CSC_FOLLOWUP_PERCENT_OFF = 20  # Community Services Card holders; follow-ups only
+LATE_CANCEL_WINDOW = datetime.timedelta(hours=48)
+LATE_CANCEL_PERCENT = 50  # of the price the patient would have paid
+
+
+def session_price(kind, day):
+    """The full price of a session of `kind` on the local date `day`, in cents. No CSC discount."""
+    if kind not in KINDS:
+        raise ValueError(f"unknown kind {kind!r}")
+    prices = PRICES_FROM_CHANGE_CENTS if day >= PRICE_CHANGE else PRICES_BEFORE_CHANGE_CENTS
+    return prices[kind]
+
+
+def appointment_price(appointment, patient):
+    """What `patient` pays for `appointment`, in cents.
 
+    The price depends on the appointment's local (Auckland) start date. A CSC
+    holder gets 20% off a follow-up. A no-show pays the full price. Cancelling
+    less than 48 hours before the start costs 50%; earlier cancellations cost
+    nothing. A cancelled appointment needs its cancelled_at time.
+    """
+    day = appointment.start.astimezone(LOCAL_TZ).date()
+    price = session_price(appointment.kind, day)
+    if patient.csc and appointment.kind == FOLLOWUP:
+        price = price * (100 - CSC_FOLLOWUP_PERCENT_OFF) // 100
 
-def session_price(kind):
