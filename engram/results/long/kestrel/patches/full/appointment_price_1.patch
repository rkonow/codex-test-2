-        raise ValueError(f"unknown kind {kind!r}") from None
+    if appointment.status in (BOOKED, ATTENDED, NO_SHOW):
+        return price
+    if appointment.status == CANCELLED:
+        if appointment.cancelled_at is None:
+            raise ValueError(f"appointment {appointment.id} is cancelled but has no cancelled_at")
+        notice = appointment.start - appointment.cancelled_at
+        if notice < LATE_CANCEL_WINDOW:
