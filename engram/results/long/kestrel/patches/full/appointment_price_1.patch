+class AppointmentPriceTest(unittest.TestCase):
+    def test_booked_before_change_keeps_old_price(self):
+        # 31 Mar 2027 10:30 UTC is 23:30 on 31 Mar in Auckland (NZDT, +13).
+        a = appt("a1", utc(2027, 3, 31, 10, 30), kind=ASSESSMENT)
+        self.assertEqual(appointment_price(a, NO_CSC), 9500)
+
+    def test_booked_after_change_uses_new_price(self):
+        # 31 Mar 2027 11:30 UTC is 00:30 on 1 Apr in Auckland, so it is on the new price.
+        a = appt("a1", utc(2027, 3, 31, 11, 30), kind=ASSESSMENT)
+        self.assertEqual(appointment_price(a, NO_CSC), 10500)
+
+    def test_followup_prices(self):
+        before = appt("a1", utc(2027, 3, 1, 9), kind=FOLLOWUP)
+        after = appt("a2", utc(2027, 4, 20, 9), kind=FOLLOWUP)
+        self.assertEqual(appointment_price(before, NO_CSC), 7000)
+        self.assertEqual(appointment_price(after, NO_CSC), 7800)
+
+    def test_csc_gets_twenty_percent_off_followups(self):
+        before = appt("a1", utc(2027, 3, 1, 9), kind=FOLLOWUP)
+        after = appt("a2", utc(2027, 4, 20, 9), kind=FOLLOWUP)
+        self.assertEqual(appointment_price(before, CSC), 5600)
+        self.assertEqual(appointment_price(after, CSC), 6240)
+
+    def test_csc_gets_no_discount_on_assessments(self):
+        a = appt("a1", utc(2027, 4, 20, 9), kind=ASSESSMENT)
+        self.assertEqual(appointment_price(a, CSC), 10500)
+
+    def test_attended_pays_full_price(self):
+        a = appt("a1", utc(2027, 3, 1, 9), kind=FOLLOWUP, status="attended")
+        self.assertEqual(appointment_price(a, NO_CSC), 7000)
+
+    def test_no_show_pays_full_price(self):
+        a = appt("a1", utc(2027, 3, 1, 9), kind=ASSESSMENT, status="no_show")
+        self.assertEqual(appointment_price(a, NO_CSC), 9500)
+
+    def test_cancelled_under_48_hours_costs_half(self):
+        start = utc(2027, 4, 20, 9)
+        a = appt("a1", start, kind=FOLLOWUP, status="cancelled",
+                 cancelled_at=start - datetime.timedelta(hours=47))
+        self.assertEqual(appointment_price(a, NO_CSC), 3900)
+
+    def test_cancelled_exactly_48_hours_is_free(self):
+        start = utc(2027, 4, 20, 9)
+        a = appt("a1", start, kind=FOLLOWUP, status="cancelled",
+                 cancelled_at=start - datetime.timedelta(hours=48))
