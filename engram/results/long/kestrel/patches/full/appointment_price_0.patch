 """Session prices, in cents (NZD)."""
 
-from .models import ASSESSMENT, FOLLOWUP
+import datetime
 
-PRICES_CENTS = {
+from .calendar import LOCAL_TZ
+from .models import ASSESSMENT, CANCELLED, FOLLOWUP
+
+# Prices from 1 April 2027 (local date). Appointments before that keep the old prices.
+PRICE_CHANGE_DAY = datetime.date(2027, 4, 1)
+PRICES_BEFORE_CENTS = {
     ASSESSMENT: 9500,
     FOLLOWUP: 7000,
 }
+PRICES_FROM_CENTS = {
+    ASSESSMENT: 10500,
+    FOLLOWUP: 7800,
+}
+
+# Community Services Card holders get this much off follow-ups, not assessments.
+CSC_FOLLOWUP_DISCOUNT_PERCENT = 20
 
 
-def session_price(kind):
-    """The full price of a session of `kind`, in cents. CSC discounts are not applied here."""
+def session_price(kind, day):
+    """The full price in cents of a session of `kind` on the local (Auckland) date `day`."""
+    prices = PRICES_FROM_CENTS if day >= PRICE_CHANGE_DAY else PRICES_BEFORE_CENTS
     try:
-        return PRICES_CENTS[kind]
+        return prices[kind]
     except KeyError:
         raise ValueError(f"unknown kind {kind!r}") from None
+
+
+def appointment_price(appointment, patient):
+    """What `patient` pays for `appointment`, in cents.
+
+    The price depends on the appointment's local date, and CSC holders get the
+    follow-up discount. Cancelled appointments are not priced: their fee policy
+    is not built yet.
+    """
+    if appointment.patient_id != patient.id:
+        raise ValueError(f"appointment is for {appointment.patient_id}, not {patient.id}")
+    if appointment.status == CANCELLED:
+        raise ValueError(f"appointment {appointment.id} is cancelled; cancellation fees are not priced yet")
+    day = appointment.start.astimezone(LOCAL_TZ).date()
+    price = session_price(appointment.kind, day)
+    if patient.csc and appointment.kind == FOLLOWUP:
+        price = price * (100 - CSC_FOLLOWUP_DISCOUNT_PERCENT) // 100
+    return price
