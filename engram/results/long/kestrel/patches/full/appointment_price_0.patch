+class AppointmentPriceTest(unittest.TestCase):
+    def test_plain_patient_pays_full_price(self):
+        self.assertEqual(appointment_price(appt("a1", utc(2027, 2, 1, 1), kind=ASSESSMENT), PLAIN), 9500)
+        self.assertEqual(appointment_price(appt("a2", utc(2027, 2, 1, 1), kind=FOLLOWUP), PLAIN), 7000)
+
+    def test_price_depends_on_appointment_date(self):
+        before = appt("a1", utc(2027, 3, 31, 1), kind=FOLLOWUP)  # 14:00 on 31 Mar, Auckland
+        after = appt("a2", utc(2027, 4, 2, 1), kind=FOLLOWUP)  # 14:00 on 2 Apr, Auckland
+        self.assertEqual(appointment_price(before, PLAIN), 7000)
+        self.assertEqual(appointment_price(after, PLAIN), 7800)
+
+    def test_change_uses_local_date_not_utc(self):
+        # 31 Mar 12:30 UTC is 01:30 on 1 Apr in Auckland (still NZDT, +13), so it gets the new price.
+        a = appt("a1", utc(2027, 3, 31, 12, 30), kind=FOLLOWUP)
+        self.assertEqual(appointment_price(a, PLAIN), 7800)
+
+    def test_csc_follow_up_gets_twenty_percent_off(self):
+        self.assertEqual(appointment_price(appt("a1", utc(2027, 2, 1, 1), kind=FOLLOWUP), CSC), 5600)
+        self.assertEqual(appointment_price(appt("a2", utc(2027, 4, 2, 1), kind=FOLLOWUP), CSC), 6240)
+
+    def test_csc_assessment_gets_no_discount(self):
+        self.assertEqual(appointment_price(appt("a1", utc(2027, 2, 1, 1), kind=ASSESSMENT), CSC), 9500)
+        self.assertEqual(appointment_price(appt("a2", utc(2027, 4, 2, 1), kind=ASSESSMENT), CSC), 10500)
+
+    def test_no_show_and_attended_pay_full_price(self):
+        self.assertEqual(appointment_price(appt("a1", utc(2027, 2, 1, 1), kind=FOLLOWUP, status=NO_SHOW), PLAIN), 7000)
+        self.assertEqual(appointment_price(appt("a2", utc(2027, 2, 1, 1), kind=FOLLOWUP, status=ATTENDED), CSC), 5600)
+
+    def test_cancelled_is_not_priced(self):
+        with self.assertRaises(ValueError):
