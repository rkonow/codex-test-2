+"""Durations written the way reception types them, such as '45m', '1h' or '1h 30m'."""
+
+import re
+
+_DURATION = re.compile(r"(?:(\d+)h\s*(?:(\d+)m?)?|(\d+)m)")
+
+
+def parse_duration(text):
+    """Return the number of minutes in `text`.
+
+    Accepts '45m', '1h', '1h30', '1h30m' and '1h 30m'. Case and surrounding
+    spaces are ignored. Anything else, including a bare number like '45', or a zero
+    duration, raises ValueError.
+    """
+    match = _DURATION.fullmatch(text.strip().lower())
+    if match is None:
+        raise ValueError(f"not a duration: {text!r}")
+    hours, minutes, minutes_only = match.groups()
+    if minutes_only is not None:
+        total = int(minutes_only)
+    else:
+        total = int(hours) * 60 + int(minutes or 0)
+    if total == 0:
+        raise ValueError(f"duration must be more than zero: {text!r}")
+    return total
diff --git a/tests/test_intervals.py b/tests/test_intervals.py
