+"""Cancellation and no-show fees, in cents."""
+
+import datetime
+
+from .models import CANCELLED, NO_SHOW
+from .pricing import session_price
+
+# Cancelling with less notice than this costs half the session price.
+LATE_CANCELLATION_WINDOW = datetime.timedelta(hours=48)
+
+
+def cancellation_fee(appointment, cancelled_at=None):
+    """The fee in cents for a cancelled or no-show appointment.
+
+    A cancelled appointment costs 50% of the session price if it was cancelled
+    less than 48 hours before the start, and nothing otherwise. The time is
+    `cancelled_at` if given, else the appointment's own cancelled_at.
+
+    A no-show pays the full session price. `cancelled_at` is not used for it.
+    """
+    price = session_price(appointment.kind)
+    if appointment.status == NO_SHOW:
+        return price
+    if appointment.status != CANCELLED:
+        raise ValueError(f"no cancellation fee applies to status {appointment.status!r}")
+    when = cancelled_at if cancelled_at is not None else appointment.cancelled_at
+    if when is None:
+        raise ValueError("a cancelled appointment needs a cancellation time")
+    if when.tzinfo is None:
+        raise ValueError("cancelled_at must be timezone-aware")
+    if appointment.start - when < LATE_CANCELLATION_WINDOW:
+        return price // 2
+    return 0
diff --git a/tests/test_fees.py b/tests/test_fees.py
new file mode 100644
index 0000000..0c54189
--- /dev/null
+++ b/tests/test_fees.py
@@ -0,0 +1,58 @@
+import datetime
+import unittest
+
+from helpers import appt, utc
+from kestrel.fees import cancellation_fee
+from kestrel.models import ASSESSMENT, FOLLOWUP
+
+START = utc(2027, 3, 10, 9)  # 09:00 UTC, the appointment start in each test
+
+
+class CancellationFeeTest(unittest.TestCase):
+    def test_cancelled_more_than_48_hours_ahead_is_free(self):
+        self.assertEqual(cancellation_fee(appt("a1", START, status="cancelled"), utc(2027, 3, 8, 8)), 0)
+
+    def test_exactly_48_hours_ahead_is_free(self):
+        # The window is "less than 48 hours", so exactly 48 hours is outside it.
+        self.assertEqual(cancellation_fee(appt("a1", START, status="cancelled"), utc(2027, 3, 8, 9)), 0)
+
+    def test_cancelled_under_48_hours_ahead_costs_half(self):
+        late = utc(2027, 3, 8, 9) + datetime.timedelta(minutes=1)
+        self.assertEqual(cancellation_fee(appt("a1", START, kind=ASSESSMENT, status="cancelled"), late), 4750)
+        self.assertEqual(cancellation_fee(appt("a2", START, kind=FOLLOWUP, status="cancelled"), late), 3500)
+
+    def test_cancelled_after_the_start_costs_half(self):
+        self.assertEqual(cancellation_fee(appt("a1", START, kind=FOLLOWUP, status="cancelled"), utc(2027, 3, 10, 10)), 3500)
+
+    def test_no_show_pays_full_price(self):
+        self.assertEqual(cancellation_fee(appt("a1", START, kind=ASSESSMENT, status="no_show")), 9500)
+        self.assertEqual(cancellation_fee(appt("a2", START, kind=FOLLOWUP, status="no_show")), 7000)
+
+    def test_no_show_ignores_any_cancellation_time(self):
+        self.assertEqual(cancellation_fee(appt("a1", START, kind=FOLLOWUP, status="no_show"), utc(2027, 3, 10, 8)), 7000)
+
+    def test_uses_the_appointment_cancelled_at_when_no_time_is_given(self):
+        cancelled = appt("a1", START, kind=FOLLOWUP, status="cancelled", cancelled_at=utc(2027, 3, 10, 8))
+        self.assertEqual(cancellation_fee(cancelled), 3500)
+
+    def test_argument_overrides_the_stored_time(self):
+        cancelled = appt("a1", START, kind=FOLLOWUP, status="cancelled", cancelled_at=utc(2027, 3, 8, 9))
+        self.assertEqual(cancellation_fee(cancelled, utc(2027, 3, 10, 8)), 3500)
+
+    def test_cancelled_without_any_time_is_an_error(self):
+        with self.assertRaises(ValueError):
+            cancellation_fee(appt("a1", START, status="cancelled"))
+
+    def test_naive_cancellation_time_is_an_error(self):
+        with self.assertRaises(ValueError):
+            cancellation_fee(appt("a1", START, status="cancelled"), datetime.datetime(2027, 3, 10, 8))
+
+    def test_no_fee_for_booked_or_attended(self):
+        for status in ["booked", "attended"]:
+            with self.subTest(status=status):
+                with self.assertRaises(ValueError):
+                    cancellation_fee(appt("a1", START, status=status))
+
+
+if __name__ == "__main__":
+    unittest.main()
