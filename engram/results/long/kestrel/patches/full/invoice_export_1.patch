+"""The monthly invoice export for the accountant (imported into Xero)."""
+
+import csv
+import os
+
+# Patient names are not exported; only the patient ID leaves the system.
+HEADER = ["Invoice Number", "Patient ID", "Clinic", "Date", "Description", "Amount"]
+
+
+def export_invoices(invoices, year, month, out_dir):
+    """Write the invoices issued in `year`-`month` to out_dir and return the file's path.
+
+    Rows are sorted by invoice number. Dates are DD/MM/YYYY and amounts are
+    plain numbers with two decimals, as Xero expects.
+    """
+    if not 1 <= month <= 12:
+        raise ValueError(f"month must be 1-12, not {month}")
+    chosen = sorted(
+        (i for i in invoices if i.issued.year == year and i.issued.month == month),
+        key=lambda i: i.number,
+    )
+    path = os.path.join(out_dir, f"kestrel-invoices-{year:04d}-{month:02d}.csv")
+    with open(path, "w", newline="", encoding="utf-8") as f:
+        writer = csv.writer(f)
+        writer.writerow(HEADER)
+        for invoice in chosen:
+            writer.writerow([
+                invoice.number,
+                invoice.patient_id,
+                invoice.clinic,
+                invoice.issued.strftime("%d/%m/%Y"),
+                invoice.description,
+                _amount(invoice.amount_cents),
+            ])
+    return path
+
+
+def _amount(cents):
+    return f"{cents // 100}.{cents % 100:02d}"
diff --git a/tests/test_export.py b/tests/test_export.py
