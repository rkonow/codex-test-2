+"""Text of the SMS reminder sent before an appointment."""
+
+from .calendar import LOCAL_TZ
+from .models import CLINICS
+
+
+def reminder_text(appointment):
+    """The reminder for `appointment`: its local date and time, and the clinic's name.
+
+    Deliberately says nothing about the treatment or the kind of session.
+    """
+    local = appointment.start.astimezone(LOCAL_TZ)
+    clinic = CLINICS[appointment.clinic].name
+    day = f"{local.strftime('%A')} {local.day} {local.strftime('%B')}"
+    return f"Hi from {clinic}. Just a reminder of your appointment on {day} at {_clock(local)}. See you then!"
+
+
+def _clock(local):
+    """12-hour time such as 1:00pm, built by hand so it works the same on every platform."""
+    hour = local.hour % 12 or 12
+    suffix = "am" if local.hour < 12 else "pm"
+    return f"{hour}:{local.minute:02d}{suffix}"
