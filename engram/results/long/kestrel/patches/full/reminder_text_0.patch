+import unittest
+
+from helpers import appt, utc
+from kestrel.reminders import reminder_text
+
+
+class ReminderTextTest(unittest.TestCase):
+    def test_gives_date_time_and_clinic(self):
+        # 2027-03-01 22:00 UTC is 11:00 on Tuesday 2 March in Auckland (NZDT, +13).
+        text = reminder_text(appt("a1", utc(2027, 3, 1, 22), clinic="HB"))
+        self.assertIn("Kestrel Physio Harbour", text)
+        self.assertIn("Tuesday 2 March", text)
+        self.assertIn("11:00am", text)
+
+    def test_afternoon_time_is_12_hour(self):
+        text = reminder_text(appt("a1", utc(2027, 3, 2, 0, 15), clinic="NG"))  # 13:15 local
+        self.assertIn("1:15pm", text)
+        self.assertIn("Kestrel Physio Northgate", text)
+
+    def test_noon_is_pm(self):
+        text = reminder_text(appt("a1", utc(2027, 3, 1, 23), clinic="WK"))  # 12:00 local
+        self.assertIn("12:00pm", text)
+
+    def test_uses_local_date_not_utc(self):
+        # 2027-03-01 11:30 UTC is 00:30 on Tuesday 2 March locally, not Monday.
+        text = reminder_text(appt("a1", utc(2027, 3, 1, 11, 30), clinic="HB"))
+        self.assertIn("Tuesday 2 March", text)
+        self.assertIn("12:30am", text)
+
+    def test_leaves_out_treatment_kind_and_patient(self):
+        a = appt("a1", utc(2027, 3, 1, 22), clinic="HB", kind="assessment", patient="KP-004211",
+                 treatment="lower back pain")
+        text = reminder_text(a).lower()
+        for secret in ["lower back pain", "assessment", "follow", "KP-004211", "back", "pain"]:
+            with self.subTest(secret=secret):
+                self.assertNotIn(secret.lower(), text)
+
+    def test_fits_in_one_sms(self):
+        for clinic in ["HB", "NG", "WK"]:
+            with self.subTest(clinic=clinic):
+                text = reminder_text(appt("a1", utc(2027, 12, 31, 3), clinic=clinic))
+                self.assertLessEqual(len(text), 160)
+
+
+if __name__ == "__main__":
+    unittest.main()
