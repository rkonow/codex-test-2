+"""Appointment reminders sent by SMS."""
+
+from .calendar import LOCAL_TZ
+from .models import BOOKED, CLINICS
+
+
+def reminder_text(appointment):
+    # Privacy rule: date, time and clinic name only. No patient name, no treatment.
+    start = appointment.start.astimezone(LOCAL_TZ)
+    clinic = CLINICS[appointment.clinic].name
+    return f"{clinic}: reminder of your appointment on {start:%a %d %b} at {start:%H:%M}."
+
+
+def send_reminders(appointments, patients, client):
+    """Text the patient of every booked appointment. Returns the number of messages sent.
+
+    patients maps patient ID to Patient. Every message is built before anything is
+    sent, so a missing patient raises KeyError without sending a partial batch.
+    """
+    messages = []
+    for appointment in appointments:
+        if appointment.status != BOOKED:
+            continue
+        patient = patients[appointment.patient_id]
+        messages.append((patient.phone, reminder_text(appointment)))
+    if messages:
+        client.send_batch(messages)
+    return len(messages)
diff --git a/tests/test_reminders.py b/tests/test_reminders.py
new file mode 100644
index 0000000..fc6ae16
--- /dev/null
+++ b/tests/test_reminders.py
@@ -0,0 +1,76 @@
+import unittest
+
+from helpers import appt, utc
+from kestrel.models import ASSESSMENT, CANCELLED, ATTENDED, Patient
+from kestrel.reminders import reminder_text, send_reminders
+
+
+class FakeClient:
+    def __init__(self):
+        self.batches = []
+
+    def send_batch(self, messages):
+        self.batches.append(list(messages))
+        return [{"accepted": len(messages)}]
+
+
+ANA = Patient("KP-000001", "Ana Silva", "+64211234567")
+BEN = Patient("KP-000002", "Ben Ito", "+64219999999")
+PATIENTS = {p.id: p for p in (ANA, BEN)}
+
+
+class SendRemindersTest(unittest.TestCase):
+    def test_sends_one_sms_per_booked_appointment_and_counts_them(self):
+        client = FakeClient()
+        appointments = [
+            appt("a1", utc(2027, 3, 1, 20), patient="KP-000001"),
+            appt("a2", utc(2027, 3, 1, 21), patient="KP-000002"),
+        ]
+        self.assertEqual(send_reminders(appointments, PATIENTS, client), 2)
+        self.assertEqual(len(client.batches), 1)
+        self.assertEqual([to for to, _ in client.batches[0]], ["+64211234567", "+64219999999"])
+
+    def test_skips_cancelled_and_attended(self):
+        client = FakeClient()
+        appointments = [
+            appt("a1", utc(2027, 3, 1, 20), patient="KP-000001", status=CANCELLED, cancelled_at=utc(2027, 2, 28)),
+            appt("a2", utc(2027, 3, 1, 21), patient="KP-000002", status=ATTENDED),
+        ]
+        self.assertEqual(send_reminders(appointments, PATIENTS, client), 0)
+        self.assertEqual(client.batches, [])
+
+    def test_no_appointments_sends_nothing(self):
+        client = FakeClient()
+        self.assertEqual(send_reminders([], PATIENTS, client), 0)
+        self.assertEqual(client.batches, [])
+
+    def test_missing_patient_raises_before_anything_is_sent(self):
+        client = FakeClient()
+        appointments = [
+            appt("a1", utc(2027, 3, 1, 20), patient="KP-000001"),
+            appt("a2", utc(2027, 3, 1, 21), patient="KP-999999"),
+        ]
+        with self.assertRaises(KeyError):
+            send_reminders(appointments, PATIENTS, client)
+        self.assertEqual(client.batches, [])
+
+    def test_message_has_no_name_or_treatment(self):
+        client = FakeClient()
+        send_reminders([appt("a1", utc(2027, 3, 1, 20), patient="KP-000001", treatment="lower back pain")],
+                       PATIENTS, client)
+        (_, text), = client.batches[0]
+        self.assertNotIn("Ana", text)
+        self.assertNotIn("Silva", text)
+        self.assertNotIn("back", text)
+        self.assertNotIn("KP-000001", text)
+
+
+class ReminderTextTest(unittest.TestCase):
+    def test_gives_local_date_time_and_clinic_name(self):
+        # 20:00 UTC on 1 Mar is 09:00 NZDT on 2 Mar, at Harbour.
+        text = reminder_text(appt("a1", utc(2027, 3, 1, 20), kind=ASSESSMENT, clinic="HB"))
+        self.assertEqual(text, "Kestrel Physio Harbour: reminder of your appointment on Tue 02 Mar at 09:00.")
+
+
+if __name__ == "__main__":
+    unittest.main()
