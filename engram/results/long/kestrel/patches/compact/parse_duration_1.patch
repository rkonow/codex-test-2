+"""Parsing of appointment lengths written as text, such as '45m', '1h' or '1h 30m'."""
+
+import re
+
+# Hours with optional minutes ('1h', '1h30', '1h 30m'), or minutes alone ('45m').
+_DURATION = re.compile(r"(?:(\d+)h\s*(?:(\d+)m?)?|(\d+)m)")
+
+
+def parse_duration(text):
+    """Return the duration in minutes. Raises ValueError for anything else."""
+    match = _DURATION.fullmatch(text)
+    if match is None:
+        raise ValueError(f"not a duration (use e.g. 45m, 1h or 1h30): {text!r}")
+    hours, minutes_after_hours, minutes_alone = match.groups()
+    if hours is None:
+        return int(minutes_alone)
+    minutes = int(minutes_after_hours or 0)
+    if minutes > 59:
+        raise ValueError(f"minutes must be under 60 when hours are given: {text!r}")
+    return int(hours) * 60 + minutes
diff --git a/tests/test_intervals.py b/tests/test_intervals.py
new file mode 100644
