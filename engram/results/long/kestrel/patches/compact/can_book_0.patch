+"""Booking checks: whether a new appointment can go into the calendar."""
+
+import datetime
+
+from .calendar import LOCAL_TZ
+from .models import ASSESSMENT, CANCELLED, FOLLOWUP
+
+DURATIONS = {
+    ASSESSMENT: datetime.timedelta(minutes=45),
+    FOLLOWUP: datetime.timedelta(minutes=30),
+}
+POST_ASSESSMENT_GAP = datetime.timedelta(minutes=15)  # for the therapist's notes
+DAILY_CAP = 8  # union agreement: patient appointments per therapist per day
+
+
+def _end(appointment):
+    return appointment.start + DURATIONS[appointment.kind]
+
+
+def _gap_after(appointment):
+    return POST_ASSESSMENT_GAP if appointment.kind == ASSESSMENT else datetime.timedelta(0)
+
+
+def _clashes(existing, new):
+    """True if the two appointments overlap, or the gap after the earlier one is not respected."""
+    first, second = (existing, new) if existing.start <= new.start else (new, existing)
+    return second.start < _end(first) + _gap_after(first)
+
+
+def _on_quarter_hour(start):
+    local = start.astimezone(LOCAL_TZ)
+    return local.minute % 15 == 0 and local.second == 0 and local.microsecond == 0
+
+
+def can_book(calendar, therapist, appointment):
+    """True if the appointment can be added to the calendar for this therapist, else False.
+
+    Never overbooks: the appointment must not overlap another live appointment for the therapist,
+    must respect the gap after an assessment, must start on a quarter hour (Auckland time), and must
+    not take the therapist past the daily cap. Cancelled appointments do not count.
+    """
+    if appointment.therapist_id != therapist.id:
+        return False
+    if any(a.id == appointment.id for a in calendar.all()):
+        return False
+    if not _on_quarter_hour(appointment.start):
+        return False
+
+    day = appointment.start.astimezone(LOCAL_TZ).date()
+    live = [a for a in calendar.for_therapist(therapist.id) if a.status != CANCELLED]
+    booked_that_day = [a for a in live if a.start.astimezone(LOCAL_TZ).date() == day]
+    if len(booked_that_day) >= DAILY_CAP:
+        return False
+    return not any(_clashes(existing, appointment) for existing in live)
diff --git a/tests/test_booking.py b/tests/test_booking.py
new file mode 100644
index 0000000..9bebb51
--- /dev/null
+++ b/tests/test_booking.py
@@ -0,0 +1,88 @@
+import datetime
+import unittest
+
+from helpers import appt
+from kestrel.booking import can_book
+from kestrel.calendar import LOCAL_TZ, Calendar
+from kestrel.models import ASSESSMENT, CANCELLED, FOLLOWUP, Therapist
+
+THERAPIST = Therapist("T1", "Jo Park", "HB")
+
+
+def nz(hh, mm=0, day=2):
+    """A local (Auckland) time on 2027-03-<day>, which is NZDT (UTC+13)."""
+    return datetime.datetime(2027, 3, day, hh, mm, tzinfo=LOCAL_TZ)
+
+
+class CanBookTest(unittest.TestCase):
+    def check(self, existing, new):
+        return can_book(Calendar(existing), THERAPIST, new)
+
+    def test_empty_calendar(self):
+        self.assertTrue(self.check([], appt("n", nz(9), kind=FOLLOWUP)))
+
+    def test_overlapping_followup_is_refused(self):
+        existing = [appt("a1", nz(9), kind=FOLLOWUP)]  # 09:00-09:30
+        self.assertFalse(self.check(existing, appt("n", nz(9, 15), kind=FOLLOWUP)))
+
+    def test_back_to_back_followups_are_allowed(self):
+        existing = [appt("a1", nz(9), kind=FOLLOWUP)]
+        self.assertTrue(self.check(existing, appt("n", nz(9, 30), kind=FOLLOWUP)))
+
+    def test_new_followup_before_existing_is_refused_when_it_overlaps(self):
+        existing = [appt("a1", nz(9, 30), kind=FOLLOWUP)]
+        self.assertFalse(self.check(existing, appt("n", nz(9, 15), kind=FOLLOWUP)))
+        self.assertTrue(self.check(existing, appt("n", nz(9), kind=FOLLOWUP)))
+
+    def test_assessment_needs_fifteen_minute_gap_after_it(self):
+        existing = [appt("a1", nz(9), kind=ASSESSMENT)]  # 09:00-09:45, then 15 minutes for notes
+        self.assertFalse(self.check(existing, appt("n", nz(9, 30), kind=FOLLOWUP)))  # inside the assessment
+        self.assertFalse(self.check(existing, appt("n", nz(9, 45), kind=FOLLOWUP)))  # straight after, no gap
+        self.assertTrue(self.check(existing, appt("n", nz(10), kind=FOLLOWUP)))
+
+    def test_new_assessment_needs_gap_before_next_patient(self):
+        existing = [appt("a1", nz(10), kind=FOLLOWUP)]
+        # New assessment 09:00-09:45 leaves its gap until 10:00, so 09:30 would clash.
+        self.assertFalse(self.check(existing, appt("n", nz(9, 30), kind=ASSESSMENT)))
+        self.assertTrue(self.check(existing, appt("n", nz(9), kind=ASSESSMENT)))
+
+    def test_no_gap_after_followup(self):
+        existing = [appt("a1", nz(9), kind=FOLLOWUP)]
+        self.assertTrue(self.check(existing, appt("n", nz(9, 30), kind=FOLLOWUP)))
+
+    def test_start_must_be_on_a_quarter_hour(self):
+        self.assertFalse(self.check([], appt("n", nz(9, 10), kind=FOLLOWUP)))
+        self.assertTrue(self.check([], appt("n", nz(9, 15), kind=FOLLOWUP)))
+
+    def test_start_must_not_have_seconds(self):
+        self.assertFalse(self.check([], appt("n", nz(9) + datetime.timedelta(seconds=1), kind=FOLLOWUP)))
+
+    def test_other_therapists_do_not_block(self):
+        existing = [appt("a1", nz(9), kind=FOLLOWUP, therapist="T2")]
+        self.assertTrue(self.check(existing, appt("n", nz(9), kind=FOLLOWUP)))
+
+    def test_cancelled_appointment_does_not_block(self):
+        existing = [appt("a1", nz(9), kind=FOLLOWUP, status=CANCELLED, cancelled_at=nz(8))]
+        self.assertTrue(self.check(existing, appt("n", nz(9), kind=FOLLOWUP)))
+
+    def test_daily_cap_of_eight(self):
+        eight = [appt(f"a{i}", nz(9) + datetime.timedelta(minutes=30 * i), kind=FOLLOWUP) for i in range(8)]
+        self.assertFalse(self.check(eight, appt("n", nz(13), kind=FOLLOWUP)))
+        self.assertTrue(self.check(eight[:7], appt("n", nz(13), kind=FOLLOWUP)))
+
+    def test_daily_cap_ignores_cancelled_and_other_days(self):
+        eight = [appt(f"a{i}", nz(9) + datetime.timedelta(minutes=30 * i), kind=FOLLOWUP) for i in range(8)]
+        eight[0].status = CANCELLED
+        eight[0].cancelled_at = nz(8)
+        self.assertTrue(self.check(eight, appt("n", nz(13), kind=FOLLOWUP)))
+        self.assertTrue(self.check(eight, appt("n", nz(9, day=3), kind=FOLLOWUP)))
+
+    def test_duplicate_id_is_refused(self):
+        self.assertFalse(self.check([appt("a1", nz(9), kind=FOLLOWUP)], appt("a1", nz(13), kind=FOLLOWUP)))
+
+    def test_wrong_therapist_is_refused(self):
+        self.assertFalse(can_book(Calendar(), THERAPIST, appt("n", nz(9), kind=FOLLOWUP, therapist="T2")))
+
+
+if __name__ == "__main__":
+    unittest.main()
