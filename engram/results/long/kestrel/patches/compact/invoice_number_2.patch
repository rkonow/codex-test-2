+
+
+class NextInvoiceNumberTest(unittest.TestCase):
+    def test_first_invoice_of_the_year_is_sequence_one(self):
+        self.assertEqual(next_invoice_number("HB", 2026, []), "INV-HB-2026-00001")
+
+    def test_follows_the_highest_existing_number(self):
+        existing = ["INV-HB-2026-00001", "INV-HB-2026-00002"]
+        self.assertEqual(next_invoice_number("HB", 2026, existing), "INV-HB-2026-00003")
+
+    def test_uses_highest_not_last_listed(self):
+        existing = ["INV-HB-2026-00007", "INV-HB-2026-00002"]
+        self.assertEqual(next_invoice_number("HB", 2026, existing), "INV-HB-2026-00008")
+
+    def test_other_clinics_do_not_count(self):
+        existing = ["INV-NG-2026-00009", "INV-WK-2026-00004"]
+        self.assertEqual(next_invoice_number("HB", 2026, existing), "INV-HB-2026-00001")
+
+    def test_other_years_do_not_count(self):
+        existing = ["INV-HB-2025-00040"]
+        self.assertEqual(next_invoice_number("HB", 2026, existing), "INV-HB-2026-00001")
+
+    def test_sequence_restarts_each_year(self):
+        existing = ["INV-HB-2025-00040", "INV-HB-2026-00002"]
+        self.assertEqual(next_invoice_number("HB", 2026, existing), "INV-HB-2026-00003")
+        self.assertEqual(next_invoice_number("HB", 2027, existing), "INV-HB-2027-00001")
+
+    def test_malformed_numbers_are_ignored(self):
+        existing = ["INV-HB-2026-7", "INV-HB-2026-00005-x", "HB-2026-00009", "inv-hb-2026-00009"]
+        self.assertEqual(next_invoice_number("HB", 2026, existing), "INV-HB-2026-00001")
+
+    def test_accepts_any_iterable(self):
+        existing = (n for n in ["INV-HB-2026-00003"])
+        self.assertEqual(next_invoice_number("HB", 2026, existing), "INV-HB-2026-00004")
+
+    def test_lower_case_clinic_is_rejected(self):
+        with self.assertRaises(ValueError):
+            next_invoice_number("hb", 2026, [])
+
+    def test_empty_clinic_is_rejected(self):
+        with self.assertRaises(ValueError):
+            next_invoice_number("", 2026, [])
+
+    def test_last_sequence_number_is_allowed(self):
+        existing = ["INV-HB-2026-99998"]
+        self.assertEqual(next_invoice_number("HB", 2026, existing), "INV-HB-2026-99999")
+
+    def test_running_out_of_numbers_raises(self):
+        existing = ["INV-HB-2026-99999"]
+        with self.assertRaises(ValueError):
+            next_invoice_number("HB", 2026, existing)
