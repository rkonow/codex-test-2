 from .calendar import LOCAL_TZ
 from .ids import normalize_patient_id
@@ -40,3 +41,25 @@ def make_invoice(appointment, patient, number, amount_cents):
         amount_cents=amount_cents,
         appointment_id=appointment.id,
     )
+
+
+INVOICE_NUMBER_RE = re.compile(r"^INV-([A-Z]+)-(\d{4})-(\d{5})$")
+
+
+def next_invoice_number(clinic, year, existing):
+    """Next invoice number for a clinic in a year, given every number issued so far.
+
+    Numbers are INV-<clinic>-<year>-<five-digit sequence>, counted per clinic and
+    restarting each year. Numbers for other clinics or years are ignored.
+    """
+    if not re.fullmatch(r"[A-Z]+", clinic):
+        raise ValueError(f"clinic code must be upper-case letters: {clinic!r}")
+    prefix = f"INV-{clinic}-{year:04d}-"
+    highest = 0
+    for number in existing:
+        match = INVOICE_NUMBER_RE.match(number)
+        if match and number.startswith(prefix):
+            highest = max(highest, int(match.group(3)))
+    if highest + 1 > 99999:
+        raise ValueError(f"no invoice numbers left for {clinic} in {year}")
+    return f"{prefix}{highest + 1:05d}"
