+"""Parsing of appointment lengths written as text, such as '45m', '1h' or '1h 30m'."""
+
+import re
+
+_MINUTES = re.compile(r"([0-9]+)m")
+_HOURS = re.compile(r"([0-9]+)h(?:\s*(?:([0-9]+)m?))?")
+
+
+def parse_duration(text):
+    """Return the number of minutes in text, or raise ValueError if it is not a duration."""
+    match = _MINUTES.fullmatch(text)
+    if match:
+        minutes = int(match.group(1))
+    else:
+        match = _HOURS.fullmatch(text)
+        if not match:
+            raise ValueError(f"not a duration (use e.g. 45m, 1h, 1h30 or 1h 30m): {text!r}")
+        minutes = int(match.group(1)) * 60 + int(match.group(2) or 0)
+    if minutes <= 0:
+        raise ValueError(f"duration must be more than zero: {text!r}")
+    return minutes
diff --git a/tests/test_intervals.py b/tests/test_intervals.py
