+"""Session prices, in cents (NZD), and what a patient pays for an appointment."""
 
+import datetime
+
+from .calendar import LOCAL_TZ
 from .models import ASSESSMENT, FOLLOWUP
 
-PRICES_CENTS = {
-    ASSESSMENT: 9500,  # $95
-    FOLLOWUP: 7000,  # $70
-}
+# Each entry applies from its date (local, Pacific/Auckland) until the next entry starts.
+PRICE_SCHEDULE = [
+    (datetime.date(1, 1, 1), {
+        ASSESSMENT: 9500,  # $95
+        FOLLOWUP: 7000,  # $70
+    }),
+    (datetime.date(2027, 4, 1), {
+        ASSESSMENT: 10500,  # $105
+        FOLLOWUP: 7800,  # $78
+    }),
+]
+
+CSC_FOLLOWUP_DISCOUNT_PERCENT = 20
 
 
-def session_price(kind):
-    """Standard price in cents for a session kind, before any discounts."""
+def session_price(kind, on_date):
+    """Standard price in cents for a session kind on a local date, before any discounts."""
+    prices = None
+    for start, table in PRICE_SCHEDULE:
+        if on_date >= start:
+            prices = table
     try:
-        return PRICES_CENTS[kind]
+        return prices[kind]
     except KeyError:
         raise ValueError(f"unknown kind {kind!r}") from None
+
+
+def appointment_price(appointment, patient):
+    """What the patient pays for this appointment, in cents.
+
+    The price is set by the appointment's local date, so bookings before 1 April 2027 keep the old prices.
+    """
+    local_date = appointment.start.astimezone(LOCAL_TZ).date()
+    price = session_price(appointment.kind, local_date)
+    if patient.csc and appointment.kind == FOLLOWUP:
+        price = price * (100 - CSC_FOLLOWUP_DISCOUNT_PERCENT) // 100
+    return price
