+class AppointmentPriceTest(unittest.TestCase):
+    def test_assessment_and_followup_at_standard_price(self):
+        self.assertEqual(appointment_price(appt("a1", utc(2026, 10, 12, 20), kind=ASSESSMENT), patient()), 9500)
