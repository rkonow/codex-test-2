+class NextInvoiceNumberTest(unittest.TestCase):
+    def test_first_invoice_of_the_year_is_sequence_one(self):
+        self.assertEqual(next_invoice_number("HB", 2026, []), "INV-HB-2026-00001")
+
+    def test_follows_the_highest_sequence_for_the_clinic_and_year(self):
+        existing = ["INV-HB-2026-00001", "INV-HB-2026-00007", "INV-HB-2026-00003"]
+        self.assertEqual(next_invoice_number("HB", 2026, existing), "INV-HB-2026-00008")
+
+    def test_other_clinics_do_not_count(self):
+        existing = ["INV-NG-2026-00005", "INV-WK-2026-00009"]
+        self.assertEqual(next_invoice_number("HB", 2026, existing), "INV-HB-2026-00001")
+
+    def test_other_years_do_not_count(self):
+        existing = ["INV-HB-2025-00042"]
+        self.assertEqual(next_invoice_number("HB", 2026, existing), "INV-HB-2026-00001")
+
+    def test_sequence_restarts_each_year(self):
+        existing = ["INV-HB-2025-00042"]
+        self.assertEqual(next_invoice_number("HB", 2025, existing), "INV-HB-2025-00043")
+
+    def test_accepts_any_iterable(self):
+        numbers = (n for n in ["INV-NG-2026-00002"])
+        self.assertEqual(next_invoice_number("NG", 2026, numbers), "INV-NG-2026-00003")
+
+    def test_unknown_clinic_is_rejected(self):
+        with self.assertRaises(ValueError):
+            next_invoice_number("XX", 2026, [])
+
+    def test_malformed_number_for_this_clinic_and_year_is_rejected(self):
+        with self.assertRaises(ValueError):
+            next_invoice_number("HB", 2026, ["INV-HB-2026-7"])
+
+    def test_last_number_of_the_year_is_refused_once_used(self):
+        with self.assertRaises(ValueError):
+            next_invoice_number("HB", 2026, ["INV-HB-2026-99999"])
+        self.assertEqual(next_invoice_number("HB", 2026, ["INV-HB-2026-99998"]), "INV-HB-2026-99999")
+
+
+if __name__ == "__main__":
+    unittest.main()
