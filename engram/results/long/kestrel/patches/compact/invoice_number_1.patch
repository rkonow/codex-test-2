+def next_invoice_number(clinic, year, existing):
+    """Next number in INV-<clinic>-<year>-<five digits>, counted per clinic and year.
+
+    `existing` is every invoice number issued so far, for any clinic and year;
+    only those for this clinic and year affect the result.
+    """
+    if clinic not in CLINICS:
+        raise ValueError(f"unknown clinic: {clinic!r}")
+    prefix = f"INV-{clinic}-{year}-"
+    last = 0
+    for number in existing:
+        if not number.startswith(prefix):
+            continue
+        digits = number[len(prefix):]
+        if not (digits.isdigit() and len(digits) == 5):
+            raise ValueError(f"malformed invoice number: {number!r}")
+        last = max(last, int(digits))
+    if last >= 99999:
+        raise ValueError(f"no invoice numbers left for {clinic} in {year}")
+    return f"{prefix}{last + 1:05d}"
