+"""Text of the SMS reminder sent two days before an appointment."""
+
+from .calendar import LOCAL_TZ
+from .models import CLINICS
+
+
+def reminder_text(appointment):
+    # Privacy rule: only the date, the time and the clinic's name. No patient name, no treatment.
+    local = appointment.start.astimezone(LOCAL_TZ)
+    date = f"{local.strftime('%A')} {local.day} {local.strftime('%B')}"
+    hour = local.hour % 12 or 12
+    meridiem = "am" if local.hour < 12 else "pm"
+    time = f"{hour}:{local.minute:02d}{meridiem}"
+    clinic = CLINICS[appointment.clinic].name
+    return (
+        f"Hi, this is a reminder of your appointment at {clinic} on {date} at {time}. "
+        "If you need to change it, please contact the clinic. See you soon!"
+    )
diff --git a/tests/test_reminders.py b/tests/test_reminders.py
new file mode 100644
index 0000000..94293aa
--- /dev/null
+++ b/tests/test_reminders.py
@@ -0,0 +1,35 @@
+import unittest
+
+from helpers import appt, utc
+from kestrel.models import ASSESSMENT
+from kestrel.reminders import reminder_text
+
+
+class ReminderTextTest(unittest.TestCase):
+    def test_gives_date_time_and_clinic_name(self):
+        # 20:00 UTC on 12 Oct is 09:00 NZDT on 13 Oct (Tuesday).
+        text = reminder_text(appt("a1", utc(2026, 10, 12, 20), clinic="HB"))
+        self.assertIn("Kestrel Physio Harbour", text)
+        self.assertIn("Tuesday 13 October at 9:00am", text)
+
+    def test_afternoon_time_uses_pm(self):
+        text = reminder_text(appt("a1", utc(2026, 10, 13, 4, 30), clinic="NG"))  # 17:30 local
+        self.assertIn("Kestrel Physio Northgate", text)
+        self.assertIn("at 5:30pm", text)
+
+    def test_midday_and_midnight_hours(self):
+        self.assertIn("at 12:15pm", reminder_text(appt("a1", utc(2026, 10, 12, 23, 15))))  # 12:15 local)
+        self.assertIn("at 12:00am", reminder_text(appt("a2", utc(2026, 10, 12, 11, 0))))  # 00:00 local)
+
+    def test_no_patient_name_or_treatment(self):
+        a = appt("a1", utc(2026, 10, 12, 20), kind=ASSESSMENT, patient="KP-004211",
+                 treatment="lower back pain")
+        text = reminder_text(a)
+        self.assertNotIn("KP-004211", text)
+        self.assertNotIn("lower back pain", text)
+        self.assertNotIn("assessment", text.lower())
+        self.assertNotIn("+64", text)
+
+
+if __name__ == "__main__":
+    unittest.main()
