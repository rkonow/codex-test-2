+class AppointmentPriceTest(unittest.TestCase):
+    def test_price_follows_the_local_date_not_utc(self):
+        # NZDT is UTC+13 in March: 10:00 UTC on 31 Mar is 23:00 that day, 11:00 UTC is 00:00 on 1 Apr.
+        before = appt("a1", utc(2027, 3, 31, 10), kind=FOLLOWUP, patient=BEN.id)
+        after = appt("a2", utc(2027, 3, 31, 11), kind=FOLLOWUP, patient=BEN.id)
+        self.assertEqual(appointment_price(before, BEN), 7000)
+        self.assertEqual(appointment_price(after, BEN), 7800)
+
+    def test_assessment_price(self):
+        self.assertEqual(appointment_price(appt("a1", utc(2027, 4, 2, 0), kind=ASSESSMENT, patient=BEN.id), BEN), 10500)
+
+    def test_csc_gets_20_percent_off_followups(self):
+        self.assertEqual(appointment_price(appt("a1", utc(2027, 4, 2, 0), kind=FOLLOWUP, patient=ANA_CSC.id), ANA_CSC), 6240)
+        self.assertEqual(appointment_price(appt("a2", utc(2027, 3, 2, 0), kind=FOLLOWUP, patient=ANA_CSC.id), ANA_CSC), 5600)
