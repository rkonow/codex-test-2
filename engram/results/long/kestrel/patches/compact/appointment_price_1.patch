+"""Session prices, in cents (NZD), by the appointment's local (Pacific/Auckland) date."""
 
+import datetime
+
+from .calendar import LOCAL_TZ
 from .models import ASSESSMENT, FOLLOWUP
 
-PRICES_CENTS = {
-    ASSESSMENT: 9500,  # $95
-    FOLLOWUP: 7000,  # $70
-}
+# (first local date the prices apply from, prices in cents), oldest first.
+PRICE_SCHEDULE = [
+    (datetime.date.min, {ASSESSMENT: 9500, FOLLOWUP: 7000}),  # $95, $70
+    (datetime.date(2027, 4, 1), {ASSESSMENT: 10500, FOLLOWUP: 7800}),  # $105, $78
+]
+
+CSC_FOLLOWUP_PERCENT = 20  # Community Services Card holders get 20% off follow-ups
+
+
+def session_price(kind, on):
+    """Standard price in cents for a session kind on a local date, before any discounts."""
+    for effective, prices in reversed(PRICE_SCHEDULE):
+        if on >= effective:
+            try:
+                return prices[kind]
+            except KeyError:
+                raise ValueError(f"unknown kind {kind!r}") from None
+    raise ValueError(f"no prices for {on}")
 
 
-def session_price(kind):
-    """Standard price in cents for a session kind, before any discounts."""
-    try:
-        return PRICES_CENTS[kind]
-    except KeyError:
-        raise ValueError(f"unknown kind {kind!r}") from None
+def appointment_price(appointment, patient):
+    """What the patient pays for this appointment, in cents (NZD)."""
+    if appointment.patient_id != patient.id:
+        raise ValueError(f"appointment {appointment.id} is not for patient {patient.id}")
+    on = appointment.start.astimezone(LOCAL_TZ).date()
+    price = session_price(appointment.kind, on)
+    if patient.csc and appointment.kind == FOLLOWUP:
+        price = price * (100 - CSC_FOLLOWUP_PERCENT) // 100
+    return price
