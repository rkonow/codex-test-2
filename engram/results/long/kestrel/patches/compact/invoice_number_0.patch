+# INV-<clinic code>-<year>-<five-digit sequence>, e.g. INV-HB-2026-00001
+INVOICE_NUMBER = re.compile(r"INV-([A-Z]+)-(\d{4})-(\d{5})")
+
 
 @dataclass
 class Invoice:
@@ -40,3 +44,21 @@ def make_invoice(appointment, patient, number, amount_cents):
         amount_cents=amount_cents,
         appointment_id=appointment.id,
     )
+
+
+def next_invoice_number(clinic, year, existing):
+    """Next invoice number for a clinic in a year, counting from 00001 each year.
+
+    `existing` is every invoice number issued so far, for any clinic and year.
+    Numbers that don't match the INV-<clinic>-<year>-<sequence> format are ignored.
+    """
+    if clinic not in CLINICS:
+        raise ValueError(f"unknown clinic: {clinic!r}")
+    highest = 0
+    for number in existing:
+        match = INVOICE_NUMBER.fullmatch(number)
+        if match and match.group(1) == clinic and int(match.group(2)) == year:
+            highest = max(highest, int(match.group(3)))
+    if highest >= 99999:
+        raise ValueError(f"no invoice numbers left for {clinic} {year}")
+    return f"INV-{clinic}-{year}-{highest + 1:05d}"
