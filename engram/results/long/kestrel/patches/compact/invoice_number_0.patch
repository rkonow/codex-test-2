+class NextInvoiceNumberTest(unittest.TestCase):
+    def test_first_invoice_of_the_year_is_sequence_one(self):
+        self.assertEqual(next_invoice_number("HB", 2026, []), "INV-HB-2026-00001")
+
+    def test_follows_highest_existing_number(self):
+        existing = ["INV-HB-2026-00001", "INV-HB-2026-00002", "INV-HB-2026-00007"]
+        self.assertEqual(next_invoice_number("HB", 2026, existing), "INV-HB-2026-00008")
+
+    def test_order_of_existing_numbers_does_not_matter(self):
+        existing = ["INV-HB-2026-00007", "INV-HB-2026-00002"]
+        self.assertEqual(next_invoice_number("HB", 2026, existing), "INV-HB-2026-00008")
+
+    def test_other_clinics_are_not_counted(self):
+        existing = ["INV-NG-2026-00050", "INV-WK-2026-00009"]
+        self.assertEqual(next_invoice_number("HB", 2026, existing), "INV-HB-2026-00001")
+
+    def test_previous_years_are_not_counted(self):
+        existing = ["INV-HB-2025-00300"]
+        self.assertEqual(next_invoice_number("HB", 2026, existing), "INV-HB-2026-00001")
+
+    def test_sequence_restarts_each_year(self):
+        existing = ["INV-HB-2025-00300", "INV-HB-2026-00002"]
+        self.assertEqual(next_invoice_number("HB", 2026, existing), "INV-HB-2026-00003")
+        self.assertEqual(next_invoice_number("HB", 2027, existing), "INV-HB-2027-00001")
+
+    def test_malformed_numbers_are_ignored(self):
+        existing = ["INV-HB-2026-7", "INV-HB-2026-00009x", "HB-2026-00020", "INV-HBX-2026-00030"]
+        self.assertEqual(next_invoice_number("HB", 2026, existing), "INV-HB-2026-00001")
+
+    def test_accepts_any_iterable(self):
+        existing = (n for n in ["INV-WK-2026-00004"])
+        self.assertEqual(next_invoice_number("WK", 2026, existing), "INV-WK-2026-00005")
+
+    def test_unknown_clinic_raises(self):
+        with self.assertRaises(ValueError):
+            next_invoice_number("XX", 2026, [])
+
+    def test_exhausted_sequence_raises(self):
+        with self.assertRaises(ValueError):
+            next_invoice_number("HB", 2026, ["INV-HB-2026-99999"])
+
+
+if __name__ == "__main__":
+    unittest.main()
