@@ -0,0 +1,96 @@
+import csv
+import datetime
+import os
+import tempfile
+import unittest
+
+from kestrel.export import export_invoices
+from kestrel.invoices import Invoice
+
+
+def invoice(number, date, patient_id="KP-004211", description="Initial assessment", amount_cents=9500):
+    return Invoice(number=number, patient_id=patient_id, clinic="HB", date=date,
+                   description=description, amount_cents=amount_cents, appointment_id="A-" + number)
+
+
+class ExportInvoicesTest(unittest.TestCase):
+    def setUp(self):
+        self._tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(self._tmp.cleanup)
+        self.out_dir = self._tmp.name
+
+    def read_rows(self, path):
+        with open(path, encoding="utf-8", newline="") as f:
+            return list(csv.reader(f))
+
+    def test_file_name_and_return_value(self):
+        path = export_invoices([], 2026, 10, self.out_dir)
+        self.assertEqual(path, os.path.join(self.out_dir, "kestrel-invoices-2026-10.csv"))
+        self.assertTrue(os.path.isfile(path))
+
+    def test_header_row_then_one_row_per_invoice(self):
+        path = export_invoices([invoice("INV-HB-2026-00001", datetime.date(2026, 10, 12))], 2026, 10, self.out_dir)
+        self.assertEqual(self.read_rows(path), [
+            ["ContactName", "InvoiceNumber", "InvoiceDate", "Description", "Quantity", "UnitAmount"],
+            ["KP-004211", "INV-HB-2026-00001", "12/10/2026", "Initial assessment", "1", "95.00"],
+        ])
+
+    def test_only_invoices_in_that_month(self):
+        path = export_invoices([
+            invoice("INV-HB-2026-00001", datetime.date(2026, 9, 30)),
+            invoice("INV-HB-2026-00002", datetime.date(2026, 10, 1)),
+            invoice("INV-HB-2026-00003", datetime.date(2026, 10, 31)),
+            invoice("INV-HB-2026-00004", datetime.date(2026, 11, 1)),
+            invoice("INV-HB-2025-00001", datetime.date(2025, 10, 5)),
+        ], 2026, 10, self.out_dir)
+        numbers = [row[1] for row in self.read_rows(path)[1:]]
+        self.assertEqual(numbers, ["INV-HB-2026-00002", "INV-HB-2026-00003"])
+
+    def test_rows_sorted_by_date_then_number(self):
+        path = export_invoices([
+            invoice("INV-HB-2026-00003", datetime.date(2026, 10, 12)),
+            invoice("INV-HB-2026-00001", datetime.date(2026, 10, 14)),
+            invoice("INV-HB-2026-00002", datetime.date(2026, 10, 12)),
+        ], 2026, 10, self.out_dir)
+        numbers = [row[1] for row in self.read_rows(path)[1:]]
+        self.assertEqual(numbers, ["INV-HB-2026-00002", "INV-HB-2026-00003", "INV-HB-2026-00001"])
+
+    def test_amounts_have_two_decimals_and_no_dollar_sign(self):
+        path = export_invoices([
+            invoice("N1", datetime.date(2026, 10, 1), amount_cents=7000, description="Follow-up session"),
+            invoice("N2", datetime.date(2026, 10, 2), amount_cents=0),
+            invoice("N3", datetime.date(2026, 10, 3), amount_cents=5),
+        ], 2026, 10, self.out_dir)
+        self.assertEqual([row[5] for row in self.read_rows(path)[1:]], ["70.00", "0.00", "0.05"])
+
+    def test_dates_are_day_first(self):
+        path = export_invoices([invoice("N1", datetime.date(2026, 3, 4))], 2026, 3, self.out_dir)
+        self.assertEqual(self.read_rows(path)[1][2], "04/03/2026")
+
+    def test_no_patient_names_or_treatments(self):
+        from kestrel.models import Appointment, Patient
+        from kestrel.invoices import make_invoice
+        patient = Patient("KP-004211", "Ana Silva", "+64211234567")
+        appt = Appointment("A1", "KP-004211", "T1", "HB", datetime.datetime(2026, 10, 12, 9, tzinfo=datetime.timezone.utc),
+                           "assessment", treatment="lower back pain")
+        path = export_invoices([make_invoice(appt, patient, "INV-HB-2026-00001", 9500)], 2026, 10, self.out_dir)
+        with open(path, encoding="utf-8") as f:
+            text = f.read()
+        self.assertNotIn("Ana", text)
+        self.assertNotIn("Silva", text)
+        self.assertNotIn("back pain", text)
+        self.assertNotIn("+64", text)
+
+    def test_empty_month_writes_header_only(self):
+        path = export_invoices([], 2026, 10, self.out_dir)
+        self.assertEqual(len(self.read_rows(path)), 1)
+
+    def test_bad_month_is_rejected(self):
+        with self.assertRaises(ValueError):
+            export_invoices([], 2026, 13, self.out_dir)
+        with self.assertRaises(ValueError):
+            export_invoices([], 2026, 0, self.out_dir)
+
+
+if __name__ == "__main__":
+    unittest.main()
