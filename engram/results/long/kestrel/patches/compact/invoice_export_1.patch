+"""Monthly invoice export for Xero, imported by Mere at Tui Accounting.
+
+Layout: CSV with a header row, DD/MM/YYYY dates, amounts as plain numbers with two
+decimals. Patient IDs only, no names or treatments (the file leaves the system).
+"""
+
+import csv
+import datetime
+import os
+
+HEADER = ["ContactName", "InvoiceNumber", "InvoiceDate", "Description", "Quantity", "UnitAmount"]
+
+
+def _amount(cents):
+    return f"{cents // 100}.{cents % 100:02d}"
+
+
+def _date(day):
+    return day.strftime("%d/%m/%Y")
+
+
+def export_invoices(invoices, year, month, out_dir):
+    """Write the invoices dated in year-month to kestrel-invoices-YYYY-MM.csv in out_dir.
+
+    Returns the path of the file written.
+    """
+    if not 1 <= month <= 12:
+        raise ValueError(f"month must be 1-12, not {month}")
+    chosen = sorted(
+        (i for i in invoices if i.date.year == year and i.date.month == month),
+        key=lambda i: (i.date, i.number),
+    )
+    path = os.path.join(out_dir, f"kestrel-invoices-{year:04d}-{month:02d}.csv")
+    with open(path, "w", encoding="utf-8", newline="") as f:
+        writer = csv.writer(f)
+        writer.writerow(HEADER)
+        for invoice in chosen:
+            writer.writerow([
+                invoice.patient_id, invoice.number, _date(invoice.date),
+                invoice.description, 1, _amount(invoice.amount_cents),
+            ])
+    return path
diff --git a/tests/test_export.py b/tests/test_export.py
