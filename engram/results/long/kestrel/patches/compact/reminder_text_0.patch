+++ b/tests/test_reminders.py
@@ -0,0 +1,40 @@
+import unittest
+
+from helpers import appt, utc
+from kestrel.reminders import reminder_text
+
+
+class ReminderTextTest(unittest.TestCase):
+    def test_gives_local_date_time_and_clinic(self):
+        # 20:00 UTC on 1 Mar is 09:00 NZDT on Tuesday 2 Mar.
+        text = reminder_text(appt("a1", utc(2027, 3, 1, 20), clinic="HB"))
+        self.assertIn("Kestrel Physio Harbour", text)
+        self.assertIn("Tuesday 2 March at 9:00am", text)
+
+    def test_afternoon_time_is_12_hour(self):
+        # 03:30 UTC on 2 Mar is 16:30 NZDT.
+        text = reminder_text(appt("a1", utc(2027, 3, 2, 3, 30), clinic="NG"))
+        self.assertIn("at 4:30pm", text)
+        self.assertIn("Kestrel Physio Northgate", text)
+
+    def test_midday_and_midnight_hours(self):
+        # 23:05 UTC on 1 Mar is 12:05 NZDT on 2 Mar; 11:00 UTC on 1 Mar is midnight.
+        self.assertIn("at 12:05pm", reminder_text(appt("a1", utc(2027, 3, 1, 23, 5))))
+        self.assertIn("at 12:00am", reminder_text(appt("a1", utc(2027, 3, 1, 11, 0))))
+
+    def test_uses_clinic_of_the_appointment(self):
+        self.assertIn("Kestrel Physio Westwick", reminder_text(appt("a1", utc(2027, 3, 1, 20), clinic="WK")))
+
+    def test_leaves_out_patient_name_and_treatment(self):
+        # Privacy rules: no patient name, no treatment, no patient ID.
+        a = appt("a1", utc(2027, 3, 1, 20), patient="KP-004211", treatment="ankle sprain")
+        text = reminder_text(a)
+        self.assertNotIn("ankle", text.lower())
+        self.assertNotIn("KP-004211", text)
+
+    def test_mentions_the_48_hour_notice(self):
+        self.assertIn("48 hours", reminder_text(appt("a1", utc(2027, 3, 1, 20))))
+
+
+if __name__ == "__main__":
+    unittest.main()
