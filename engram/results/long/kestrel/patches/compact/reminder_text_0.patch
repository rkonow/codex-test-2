+"""Text of the SMS reminder sent two days before an appointment."""
+
+from .calendar import LOCAL_TZ
+from .models import CLINICS
+
+
+def reminder_text(appointment):
+    """Reminder for an appointment, with the local date, time and clinic only.
+
+    Deliberately leaves out the patient's name and the treatment (privacy rules).
+    """
+    start = appointment.start.astimezone(LOCAL_TZ)
+    day = start.strftime("%A") + f" {start.day} " + start.strftime("%B")
+    hour = start.hour % 12 or 12
+    time = f"{hour}:{start.minute:02d}{'am' if start.hour < 12 else 'pm'}"
+    clinic = CLINICS[appointment.clinic].name
+    return (
+        f"Hi from {clinic}! Just a friendly reminder of your physio appointment "
+        f"on {day} at {time}. We look forward to seeing you. "
+        "If you can't make it, please let us know at least 48 hours ahead. Thanks!"
+    )
diff --git a/tests/test_reminders.py b/tests/test_reminders.py
