+"""Monthly invoice export for the accountant (imported into Xero).
+
+Leaves the system, so it carries patient IDs only: no names, no treatments.
+"""
+
+import csv
+import datetime
+import os
+
+HEADER = ["InvoiceNumber", "PatientID", "Clinic", "Date", "Description", "Amount"]
+
+
+def _amount(cents):
+    return f"{cents // 100}.{cents % 100:02d}"
+
+
+def export_invoices(invoices, year, month, out_dir):
+    """Write the invoices dated in that local (Auckland) month to kestrel-invoices-YYYY-MM.csv in out_dir.
+
+    Returns the path of the file written. Rows are ordered by date, then invoice number.
+    """
+    datetime.date(year, month, 1)  # raises ValueError for a month outside 1-12
+    chosen = sorted(
+        (i for i in invoices if i.date.year == year and i.date.month == month),
+        key=lambda i: (i.date, i.number),
+    )
+    path = os.path.join(out_dir, f"kestrel-invoices-{year:04d}-{month:02d}.csv")
+    with open(path, "w", encoding="utf-8", newline="") as f:
+        writer = csv.writer(f, lineterminator="\n")
+        writer.writerow(HEADER)
+        for invoice in chosen:
+            writer.writerow([
+                invoice.number,
+                invoice.patient_id,
+                invoice.clinic,
+                invoice.date.strftime("%d/%m/%Y"),
+                invoice.description,
+                _amount(invoice.amount_cents),
+            ])
+    return path
