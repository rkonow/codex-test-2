+class AppointmentPriceTest(unittest.TestCase):
+    def setUp(self):
+        self.ana = Patient("KP-000001", "Ana Silva", "+64211234567")
+        self.ben = Patient("KP-000002", "Ben Ito", "+64219999999", csc=True)
+
+    def test_standard_prices(self):
+        a = appt("a1", utc(2026, 10, 12, 20), kind=ASSESSMENT, patient="KP-000001")
+        f = appt("a2", utc(2026, 10, 12, 20), kind=FOLLOWUP, patient="KP-000001")
+        self.assertEqual(appointment_price(a, self.ana), 9500)
+        self.assertEqual(appointment_price(f, self.ana), 7000)
+
+    def test_price_follows_local_date_not_utc_date(self):
+        # 12:30 UTC on 31 Mar 2027 is 01:30 NZDT on 1 Apr 2027, so the new price applies.
+        f = appt("a1", utc(2027, 3, 31, 12, 30), kind=FOLLOWUP, patient="KP-000001")
+        self.assertEqual(appointment_price(f, self.ana), 7800)
+
+    def test_late_march_is_still_old_price(self):
+        # 11:30 UTC on 31 Mar 2027 is 00:30 NZDT on 31 Mar, so the old price applies.
+        f = appt("a1", utc(2027, 3, 30, 11, 30), kind=FOLLOWUP, patient="KP-000001")
+        self.assertEqual(appointment_price(f, self.ana), 7000)
+
+    def test_csc_gets_20_percent_off_followup(self):
+        f = appt("a1", utc(2026, 10, 12, 20), kind=FOLLOWUP, patient="KP-000002")
+        self.assertEqual(appointment_price(f, self.ben), 5600)
+
+    def test_csc_followup_from_1_april_2027(self):
+        f = appt("a1", utc(2027, 4, 1, 12), kind=FOLLOWUP, patient="KP-000002")
+        self.assertEqual(appointment_price(f, self.ben), 6240)
+
+    def test_csc_assessment_is_not_discounted(self):
+        a = appt("a1", utc(2026, 10, 12, 20), kind=ASSESSMENT, patient="KP-000002")
+        self.assertEqual(appointment_price(a, self.ben), 9500)
+
+    def test_patient_must_match_appointment(self):
+        f = appt("a1", utc(2026, 10, 12, 20), kind=FOLLOWUP, patient="KP-000001")
+        with self.assertRaises(ValueError):
