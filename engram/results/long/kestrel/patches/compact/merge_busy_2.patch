+"""Helpers for time intervals given as (start, end) pairs."""
+
+
+def merge_busy(intervals):
+    """Return (start, end) pairs sorted and merged so none overlap or touch."""
+    merged = []
+    for start, end in sorted(intervals):
+        if merged and start <= merged[-1][1]:
+            if end > merged[-1][1]:
+                merged[-1] = (merged[-1][0], end)
+        else:
+            merged.append((start, end))
+    return merged
