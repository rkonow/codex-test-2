+++ b/tests/test_reminders.py
@@ -0,0 +1,36 @@
+import unittest
+
+from helpers import appt, utc
+from kestrel.models import ASSESSMENT
+from kestrel.reminders import reminder_text
+
+
+class ReminderTextTest(unittest.TestCase):
+    def test_gives_local_date_time_and_clinic(self):
+        # 20:00 UTC on 1 Mar is 09:00 NZDT on Tuesday 2 Mar.
+        text = reminder_text(appt("a1", utc(2027, 3, 1, 20), clinic="HB"))
+        self.assertEqual(
+            text,
+            "Hi! Friendly reminder: you have an appointment at Kestrel Physio Harbour on Tuesday 2 March at 9:00am. See you then!",
+        )
+
+    def test_afternoon_time(self):
+        # 04:30 UTC on 1 Mar is 17:30 NZDT on 1 Mar.
+        text = reminder_text(appt("a1", utc(2027, 3, 1, 4, 30), clinic="NG"))
+        self.assertIn("Kestrel Physio Northgate on Monday 1 March at 5:30pm", text)
+
+    def test_noon_and_midnight(self):
+        # NZDT is UTC+13: local noon is 23:00 UTC the day before, local midnight is 11:00 UTC.
+        self.assertIn("at 12:00pm", reminder_text(appt("a1", utc(2027, 3, 1, 23))))
+        self.assertIn("at 12:00am", reminder_text(appt("a2", utc(2027, 3, 1, 11))))
+
+    def test_leaves_out_patient_name_treatment_and_kind(self):
+        a = appt("a1", utc(2027, 3, 1, 20), kind=ASSESSMENT, patient="KP-004211", therapist="T1",
+                 treatment="ankle sprain")
+        text = reminder_text(a)
+        for private in ("KP-004211", "ankle sprain", "assessment"):
+            self.assertNotIn(private, text)
+
+
+if __name__ == "__main__":
+    unittest.main()
