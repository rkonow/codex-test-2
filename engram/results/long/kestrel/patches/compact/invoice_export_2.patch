+"""Monthly invoice export for the accountant, imported into Xero.
+
+Format (see the Xero import notes): comma-separated with a header row, dates as
+DD/MM/YYYY, amounts as plain numbers with two decimals, file named
+kestrel-invoices-YYYY-MM.csv. Patient IDs only: no names or treatments leave the system.
+"""
+
+import csv
+import os
+
+HEADER = ["InvoiceNumber", "PatientID", "Date", "Description", "Amount"]
+
+
+def _amount(cents):
+    return f"{cents // 100}.{cents % 100:02d}"
+
+
+def export_invoices(invoices, year, month, out_dir):
+    """Write the invoices dated in year/month to out_dir and return the file's path."""
+    month_invoices = sorted(
+        (inv for inv in invoices if inv.date.year == year and inv.date.month == month),
+        key=lambda inv: (inv.date, inv.number),
+    )
+    path = os.path.join(out_dir, f"kestrel-invoices-{year:04d}-{month:02d}.csv")
+    with open(path, "w", encoding="utf-8", newline="") as f:
+        writer = csv.writer(f)
+        writer.writerow(HEADER)
+        for inv in month_invoices:
+            writer.writerow([
+                inv.number,
+                inv.patient_id,
+                inv.date.strftime("%d/%m/%Y"),
+                inv.description,
+                _amount(inv.amount_cents),
+            ])
+    return path
