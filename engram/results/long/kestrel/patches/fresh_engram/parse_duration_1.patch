+"""Reading durations as typed at reception."""
+
+import re
+
+_MINUTES = re.compile(r"([0-9]+)m")
+_HOURS = re.compile(r"([0-9]+)h(?:\s*([0-9]+)m?)?")
+
+
+def parse_duration(text):
+    """Turn a typed duration such as '45m', '1h', '1h30' or '1h 30m' into minutes.
+
+    Raises ValueError if the input isn't a duration, or isn't a positive one.
+    """
+    stripped = text.strip()
+    match = _MINUTES.fullmatch(stripped)
+    if match is not None:
+        minutes = int(match.group(1))
+    else:
+        match = _HOURS.fullmatch(stripped)
+        if match is None:
+            raise ValueError(f"not a duration: {text!r}")
+        hours, extra = match.group(1), match.group(2)
+        minutes = int(hours) * 60
+        if extra is not None:
+            if int(extra) >= 60:
+                raise ValueError(f"minutes out of range: {text!r}")
+            minutes += int(extra)
+    if minutes == 0:
+        raise ValueError(f"duration must be positive: {text!r}")
+    return minutes
