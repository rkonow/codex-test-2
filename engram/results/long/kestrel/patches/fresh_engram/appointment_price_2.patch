+class AppointmentPriceTest(unittest.TestCase):
+    def test_assessment_before_change(self):
+        start = datetime.datetime(2027, 3, 31, 10, 0, tzinfo=datetime.timezone.utc)
+        self.assertEqual(appointment_price(appointment(ASSESSMENT, start), patient()), 9500)
