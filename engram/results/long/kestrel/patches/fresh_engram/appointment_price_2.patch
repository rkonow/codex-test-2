+    def test_followup_before_change(self):
+        start = datetime.datetime(2027, 3, 31, 10, 0, tzinfo=datetime.timezone.utc)
+        self.assertEqual(appointment_price(appointment(FOLLOWUP, start), patient()), 7000)
+
+    def test_change_is_by_local_date(self):
+        # 2027-03-31 10:59 UTC is 23:59 on 31 March in Auckland (NZDT, UTC+13): still old prices.
+        before = datetime.datetime(2027, 3, 31, 10, 59, tzinfo=datetime.timezone.utc)
+        self.assertEqual(appointment_price(appointment(ASSESSMENT, before), patient()), 9500)
+        # 2027-03-31 11:30 UTC is 00:30 on 1 April in Auckland: new prices.
+        after = datetime.datetime(2027, 3, 31, 11, 30, tzinfo=datetime.timezone.utc)
+        self.assertEqual(appointment_price(appointment(ASSESSMENT, after), patient()), 10500)
+
+    def test_assessment_after_change(self):
+        start = datetime.datetime(2027, 4, 5, 9, 0, tzinfo=datetime.timezone.utc)
+        self.assertEqual(appointment_price(appointment(ASSESSMENT, start), patient()), 10500)
+
+    def test_followup_after_change(self):
