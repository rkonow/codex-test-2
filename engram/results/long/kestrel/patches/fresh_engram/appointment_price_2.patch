+        self.assertEqual(appointment_price(appointment(FOLLOWUP, start), patient()), 7800)
+
+    def test_csc_followup_gets_20_percent_off(self):
+        start = datetime.datetime(2027, 4, 5, 9, 0, tzinfo=datetime.timezone.utc)
+        self.assertEqual(appointment_price(appointment(FOLLOWUP, start), patient(csc=True)), 6240)
+
+    def test_csc_followup_before_change_gets_20_percent_off(self):
