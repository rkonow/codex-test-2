+        self.assertEqual(appointment_price(appointment(FOLLOWUP, start), patient(csc=True)), 5600)
+
+    def test_csc_assessment_is_not_discounted(self):
+        start = datetime.datetime(2027, 4, 5, 9, 0, tzinfo=datetime.timezone.utc)
