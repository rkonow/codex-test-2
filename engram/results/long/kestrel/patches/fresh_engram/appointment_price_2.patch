 """Session prices, in cents."""
 
+import datetime
+
+from kestrel.calendar import CLINIC_TZ
 from kestrel.models import ASSESSMENT, FOLLOWUP
 
+# Prices for appointments before PRICE_CHANGE_DATE.
 PRICES_CENTS = {
     ASSESSMENT: 9500,
     FOLLOWUP: 7000,
 }
 
+# Prices for appointments on or after PRICE_CHANGE_DATE.
+NEW_PRICES_CENTS = {
+    ASSESSMENT: 10500,
+    FOLLOWUP: 7800,
+}
+
+PRICE_CHANGE_DATE = datetime.date(2027, 4, 1)  # local (Auckland) date
+
+CSC_FOLLOWUP_DISCOUNT_PERCENT = 20  # CSC holders; initial assessments are not discounted
+
 
 def session_price(kind):
     """Return the price in cents for a session of the given kind."""
@@ -14,3 +28,17 @@ def session_price(kind):
         return PRICES_CENTS[kind]
     except KeyError:
         raise ValueError(f"unknown kind {kind!r}") from None
+
+
+def appointment_price(appointment, patient):
+    """Return what the patient pays for the appointment, in cents.
+
+    The price in force on the appointment's local (Auckland) date is used,
+    less the CSC discount on follow-ups for CSC holders.
+    """
+    local_date = appointment.start.astimezone(CLINIC_TZ).date()
+    prices = NEW_PRICES_CENTS if local_date >= PRICE_CHANGE_DATE else PRICES_CENTS
+    price = prices[appointment.kind]
+    if patient.csc and appointment.kind == FOLLOWUP:
+        price -= price * CSC_FOLLOWUP_DISCOUNT_PERCENT // 100
+    return price
