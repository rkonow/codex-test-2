+"""Monthly export of invoices for the accountant (imported into Xero)."""
+
+import csv
+import os
+
+HEADER = ["InvoiceNumber", "InvoiceDate", "Clinic", "PatientID", "Description", "Amount"]
+
+
+def export_invoices(invoices, year, month, out_dir):
+    """Write the invoices issued in year-month to out_dir and return the file's path.
+
+    The file is kestrel-invoices-YYYY-MM.csv: a header row, dates as DD/MM/YYYY,
+    amounts in dollars with two decimals. Patient names are never exported, only IDs.
+    """
+    chosen = [i for i in invoices if i.issued.year == year and i.issued.month == month]
+    chosen.sort(key=lambda i: (i.issued, i.number))
+
+    os.makedirs(out_dir, exist_ok=True)
+    path = os.path.join(out_dir, f"kestrel-invoices-{year:04d}-{month:02d}.csv")
+    with open(path, "w", newline="", encoding="utf-8") as f:
+        writer = csv.writer(f)
+        writer.writerow(HEADER)
+        for i in chosen:
+            writer.writerow([
+                i.number,
+                i.issued.strftime("%d/%m/%Y"),
+                i.clinic,
+                i.patient_id,
+                i.description,
+                f"{i.amount_cents / 100:.2f}",
+            ])
+    return path
diff --git a/tests/test_export.py b/tests/test_export.py
new file mode 100644
index 0000000..2a6c215
