+"""Checks run by the booking form before an appointment is saved."""
+
+import datetime
+
+from .calendar import CLINIC_TZ
+from .models import ASSESSMENT, CANCELLED, FOLLOWUP
+
+DURATIONS = {
+    ASSESSMENT: datetime.timedelta(minutes=45),
+    FOLLOWUP: datetime.timedelta(minutes=30),
+}
+MAX_PATIENTS_PER_DAY = 8  # therapists' union agreement
+
+
+def can_book(calendar, therapist, appointment):
+    """True if the appointment can be added to the calendar for that therapist.
+
+    Refuses a clash with another appointment for the same therapist (no overbooking),
+    and a therapist who already has MAX_PATIENTS_PER_DAY appointments on that local day.
+    """
+    try:
+        calendar.get(appointment.id)
+    except KeyError:
+        pass
+    else:
+        return False
+
+    start = appointment.start
+    end = start + DURATIONS[appointment.kind]
+    day = start.astimezone(CLINIC_TZ).date()
+    same_day = 0
+    for other in calendar.for_therapist(therapist.id):
+        if other.status == CANCELLED:
+            continue
+        other_start = other.start
+        other_end = other_start + DURATIONS[other.kind]
+        if other_start < end and start < other_end:
+            return False
+        if other.start.astimezone(CLINIC_TZ).date() == day:
+            same_day += 1
+    return same_day < MAX_PATIENTS_PER_DAY
diff --git a/tests/test_booking.py b/tests/test_booking.py
