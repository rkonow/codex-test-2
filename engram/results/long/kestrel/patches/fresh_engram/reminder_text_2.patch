+"""Text of the SMS reminders sent to patients."""
+
+from .calendar import CLINIC_TZ
+from .models import CLINICS, Appointment
+
+WEEKDAYS = ("Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday")
+MONTHS = (
+    "January", "February", "March", "April", "May", "June",
+    "July", "August", "September", "October", "November", "December",
+)
+
+
+def reminder_text(appointment: Appointment) -> str:
+    """Return the reminder sent two days before an appointment.
+
+    Privacy: the text names only the date, the time and the clinic. It never
+    says what the appointment is for (the treatment or the kind).
+    """
+    local = appointment.start.astimezone(CLINIC_TZ)
+    weekday = WEEKDAYS[local.weekday()]
+    month = MONTHS[local.month - 1]
+    hour = local.hour % 12 or 12
+    meridian = "am" if local.hour < 12 else "pm"
+    clinic = CLINICS[appointment.clinic].name
+    return (
+        f"Kia ora! This is a friendly reminder of your appointment at {clinic} "
+        f"on {weekday} {local.day} {month} at {hour}:{local.minute:02d}{meridian}. "
+        "See you then!"
+    )
diff --git a/tests/test_reminders.py b/tests/test_reminders.py
new file mode 100644
index 0000000..f0cbca5
--- /dev/null
+++ b/tests/test_reminders.py
@@ -0,0 +1,37 @@
+import unittest
+
+from helpers import appt, utc
+from kestrel.models import ASSESSMENT
+from kestrel.reminders import reminder_text
+
+
+class ReminderTextTest(unittest.TestCase):
+    def test_gives_local_date_time_and_clinic_name(self):
+        # 2026-10-14 22:30 UTC is 2026-10-15 11:30 in Auckland (NZDT, UTC+13).
+        a = appt("a1", utc(2026, 10, 14, 22, 30), clinic="HB")
+        self.assertEqual(
+            reminder_text(a),
+            "Kia ora! This is a friendly reminder of your appointment at Kestrel Physio Harbour "
+            "on Thursday 15 October at 11:30am. See you then!",
+        )
+
+    def test_afternoon_time_uses_pm_and_twelve_hour_clock(self):
+        # 2026-10-14 04:05 UTC is 17:05 in Auckland.
+        a = appt("a1", utc(2026, 10, 14, 4, 5), clinic="NG")
+        self.assertIn("at 5:05pm.", reminder_text(a))
+
+    def test_midnight_and_noon_are_twelve(self):
+        # 2026-10-13 12:00 UTC is 01:00 local; 2026-10-14 11:00 UTC is 00:00 local.
+        self.assertIn("at 1:00am.", reminder_text(appt("a1", utc(2026, 10, 13, 12, 0))))
+        self.assertIn("at 12:00am.", reminder_text(appt("a2", utc(2026, 10, 14, 11, 0))))
+
+    def test_does_not_mention_kind_or_treatment(self):
+        a = appt("a1", utc(2026, 10, 14, 22, 30), kind=ASSESSMENT, treatment="lower back pain")
+        text = reminder_text(a)
+        self.assertNotIn("lower back", text.lower())
+        self.assertNotIn("assessment", text.lower())
+        self.assertNotIn("follow", text.lower())
+
+
+if __name__ == "__main__":
+    unittest.main()
