 """Session prices, in cents."""
 
+import datetime
+import zoneinfo
+
+from kestrel.ids import normalize_patient_id
 from kestrel.models import ASSESSMENT, FOLLOWUP
 
-PRICES_CENTS = {
+CLINIC_TZ = zoneinfo.ZoneInfo("Pacific/Auckland")
+PRICE_RISE_DATE = datetime.date(2027, 4, 1)  # first local (Auckland) day at the new prices
+
+OLD_PRICES_CENTS = {
     ASSESSMENT: 9500,
     FOLLOWUP: 7000,
 }
+NEW_PRICES_CENTS = {
+    ASSESSMENT: 10500,
+    FOLLOWUP: 7800,
+}
+CSC_FOLLOWUP_DISCOUNT_PERCENT = 20  # CSC holders; follow-ups only
 
 
-def session_price(kind):
-    """Return the price in cents for a session of the given kind."""
+def session_price(kind, day):
+    """Return the price in cents for a session of the given kind on a local (Auckland) date."""
+    prices = NEW_PRICES_CENTS if day >= PRICE_RISE_DATE else OLD_PRICES_CENTS
     try:
-        return PRICES_CENTS[kind]
+        return prices[kind]
     except KeyError:
         raise ValueError(f"unknown kind {kind!r}") from None
+
+
+def appointment_price(appointment, patient):
+    """Return what the patient pays for the appointment, in cents.
+
+    The price depends on the appointment's local (Auckland) date. CSC holders get
+    20% off follow-ups but not assessments.
+    """
+    if normalize_patient_id(patient.id) != normalize_patient_id(appointment.patient_id):
+        raise ValueError(f"appointment {appointment.id!r} is not for patient {patient.id!r}")
+    day = appointment.start.astimezone(CLINIC_TZ).date()
+    price = session_price(appointment.kind, day)
+    if patient.csc and appointment.kind == FOLLOWUP:
+        price = price * (100 - CSC_FOLLOWUP_DISCOUNT_PERCENT) // 100
+    return price
