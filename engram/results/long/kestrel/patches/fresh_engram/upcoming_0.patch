         self.assertEqual([a.id for a in cal.for_day("T1", day)], ["a1", "a2"])
         self.assertEqual([a.id for a in cal.for_day("T2", day)], ["other"])
 
+    def test_upcoming_returns_booked_after_now_soonest_first(self):
+        cal = Calendar([
+            appt("late", utc(2027, 3, 3, 9), patient="KP-000002"),
+            appt("later", utc(2027, 3, 2, 9)),
+            appt("soon", utc(2027, 3, 1, 21)),
+            appt("past", utc(2027, 3, 1, 1)),
+            appt("cancelled", utc(2027, 3, 1, 22), status="cancelled"),
+        ])
+        now = utc(2027, 3, 1, 12)
+        self.assertEqual([a.id for a in cal.upcoming("KP-000001", now)], ["soon", "later"])
+
+    def test_upcoming_excludes_start_exactly_now(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 1, 12))])
+        self.assertEqual(cal.upcoming("KP-000001", utc(2027, 3, 1, 12)), [])
+
+    def test_upcoming_normalises_patient_id(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 1, 20), patient="KP-004211")])
+        self.assertEqual([a.id for a in cal.upcoming(" kp4211 ", utc(2027, 3, 1, 12))], ["a1"])
+
+    def test_upcoming_requires_aware_now(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 1, 20))])
+        with self.assertRaises(ValueError):
+            cal.upcoming("KP-000001", datetime.datetime(2027, 3, 1, 12))
+
     def test_booked(self):
         cal = Calendar([appt("a1", utc(2027, 3, 1, 20)), appt("a2", utc(2027, 3, 1, 21), status="cancelled")])
         self.assertEqual([a.id for a in cal.booked()], ["a1"])
