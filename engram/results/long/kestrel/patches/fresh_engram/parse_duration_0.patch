+"""Reading and writing appointment lengths as typed at reception."""
+
+import re
+
+_HOURS = re.compile(r"([0-9]+)h(?:\s*([0-9]+)m?)?")
+_MINUTES = re.compile(r"([0-9]+)m")
+
+
+def parse_duration(text):
+    """Turn a typed duration such as '45m', '1h', '1h30' or '1h 30m' into minutes.
+
+    Hours may be followed by minutes with or without an 'm'. Minutes after hours
+    must be under 60. Raises ValueError for anything else, including zero.
+    """
+    cleaned = text.strip().lower()
+    match = _HOURS.fullmatch(cleaned)
+    if match is not None:
+        hours = int(match.group(1))
+        minutes = int(match.group(2) or 0)
+        if minutes >= 60:
+            raise ValueError(f"not a duration: {text!r}")
+    else:
+        match = _MINUTES.fullmatch(cleaned)
+        if match is None:
+            raise ValueError(f"not a duration: {text!r}")
+        hours = 0
+        minutes = int(match.group(1))
+    total = hours * 60 + minutes
+    if total == 0:
+        raise ValueError(f"not a duration: {text!r}")
+    return total
diff --git a/tests/test_intervals.py b/tests/test_intervals.py
