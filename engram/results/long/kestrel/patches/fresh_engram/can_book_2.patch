+++ b/tests/test_booking.py
@@ -0,0 +1,74 @@
+import unittest
+
+from helpers import appt, utc
+from kestrel.booking import can_book
+from kestrel.calendar import Calendar
+from kestrel.models import ASSESSMENT, CANCELLED, Therapist
+
+T1 = Therapist("T1", "Ana", "HB")
+
+
+class CanBookTest(unittest.TestCase):
+    def test_empty_calendar(self):
+        self.assertTrue(can_book(Calendar(), T1, appt("new", utc(2027, 3, 1, 10))))
+
+    def test_overlapping_appointment_refused(self):
+        # Followup runs 10:00-10:30, so a 10:15 followup clashes.
+        cal = Calendar([appt("a1", utc(2027, 3, 1, 10))])
+        self.assertFalse(can_book(cal, T1, appt("new", utc(2027, 3, 1, 10, 15))))
+
+    def test_back_to_back_followups_allowed(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 1, 10))])
+        self.assertTrue(can_book(cal, T1, appt("new", utc(2027, 3, 1, 10, 30))))
+        self.assertTrue(can_book(cal, T1, appt("new", utc(2027, 3, 1, 9, 0))))
+
+    def test_gap_needed_after_assessment(self):
+        # Assessment runs 10:00-10:45, then 15 minutes for notes.
+        cal = Calendar([appt("a1", utc(2027, 3, 1, 10), kind=ASSESSMENT)])
+        self.assertFalse(can_book(cal, T1, appt("new", utc(2027, 3, 1, 10, 50))))
+        self.assertTrue(can_book(cal, T1, appt("new", utc(2027, 3, 1, 11, 0))))
+
+    def test_gap_needed_before_new_assessment(self):
+        # A new assessment 10:00-10:45 needs 15 minutes free before the 10:50 followup.
+        cal = Calendar([appt("a1", utc(2027, 3, 1, 10, 50))])
+        self.assertFalse(can_book(cal, T1, appt("new", utc(2027, 3, 1, 10), kind=ASSESSMENT)))
+        cal = Calendar([appt("a1", utc(2027, 3, 1, 11))])
+        self.assertTrue(can_book(cal, T1, appt("new", utc(2027, 3, 1, 10), kind=ASSESSMENT)))
+
+    def test_no_gap_needed_after_followup(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 1, 10))])
+        self.assertTrue(can_book(cal, T1, appt("new", utc(2027, 3, 1, 10, 30))))
+
+    def test_cancelled_appointment_does_not_block(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 1, 10))])
+        cal.cancel("a1", utc(2027, 2, 28, 9))
+        self.assertTrue(can_book(cal, T1, appt("new", utc(2027, 3, 1, 10))))
+
+    def test_other_therapist_does_not_block(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 1, 10), therapist="T2")])
+        self.assertTrue(can_book(cal, T1, appt("new", utc(2027, 3, 1, 10))))
+
+    def test_appointment_for_another_therapist_refused(self):
+        self.assertFalse(can_book(Calendar(), T1, appt("new", utc(2027, 3, 1, 10), therapist="T2")))
+
+    def test_duplicate_id_refused(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 1, 10))])
+        self.assertFalse(can_book(cal, T1, appt("a1", utc(2027, 3, 1, 14))))
+
+    def test_eight_per_day_limit(self):
+        # Eight followups, one hour apart, from 13:00 local on 2027-03-01 (NZDT is UTC+13).
+        cal = Calendar([appt(f"a{h}", utc(2027, 3, 1, h)) for h in range(8)])
+        self.assertFalse(can_book(cal, T1, appt("new", utc(2027, 3, 1, 8))))
+
+    def test_eight_per_day_limit_per_day(self):
+        cal = Calendar([appt(f"a{h}", utc(2027, 3, 1, h)) for h in range(8)])
+        self.assertTrue(can_book(cal, T1, appt("new", utc(2027, 3, 1, 23))))  # 2027-03-02 locally
+
+    def test_cancelled_appointments_do_not_count_towards_limit(self):
+        cal = Calendar([appt(f"a{h}", utc(2027, 3, 1, h)) for h in range(8)])
+        cal.cancel("a0", utc(2027, 2, 28, 9))
+        self.assertTrue(can_book(cal, T1, appt("new", utc(2027, 3, 1, 8))))
+
+
+if __name__ == "__main__":
+    unittest.main()
