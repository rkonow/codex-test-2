+"""Checks run by the booking form before an appointment is saved."""
+
+import datetime
+
+from .calendar import CLINIC_TZ
+from .models import ASSESSMENT, CANCELLED
+
+MAX_PER_DAY = 8  # therapists' union agreement: patient appointments per therapist per day
+ASSESSMENT_GAP = datetime.timedelta(minutes=15)  # notes-writing time after an assessment
+DURATIONS = {
+    ASSESSMENT: datetime.timedelta(minutes=45),
+    "followup": datetime.timedelta(minutes=30),
+}
+
+
+def _end(appointment):
+    return appointment.start + DURATIONS[appointment.kind]
+
+
+def _buffer_after(appointment):
+    return ASSESSMENT_GAP if appointment.kind == ASSESSMENT else datetime.timedelta(0)
+
+
+def can_book(calendar, therapist, appointment):
+    """Whether the new appointment can be added to the calendar for this therapist."""
+    if appointment.therapist_id != therapist.id:
+        return False
+    try:
+        calendar.get(appointment.id)
+    except KeyError:
+        pass
+    else:
+        return False
+
+    existing = [a for a in calendar.for_therapist(therapist.id) if a.status != CANCELLED]
+
+    new_end = _end(appointment)
+    new_buffer = _buffer_after(appointment)
+    for other in existing:
+        # Each pair needs the new one to start after the other one's end and gap,
+        # or the other one to start after the new one's end and gap. This also
+        # refuses any overlap.
+        other_ok_first = appointment.start >= _end(other) + _buffer_after(other)
+        other_ok_second = other.start >= new_end + new_buffer
+        if not (other_ok_first or other_ok_second):
+            return False
+
+    day = appointment.start.astimezone(CLINIC_TZ).date()
+    on_day = [a for a in existing if a.start.astimezone(CLINIC_TZ).date() == day]
+    if len(on_day) >= MAX_PER_DAY:
+        return False
+
+    return True
diff --git a/tests/test_booking.py b/tests/test_booking.py
