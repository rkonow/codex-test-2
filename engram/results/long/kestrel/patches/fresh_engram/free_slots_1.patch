+"""Finding the times a new appointment can be booked."""
+
+import datetime
+
+from .calendar import CLINIC_TZ
+from .models import ASSESSMENT, CANCELLED, FOLLOWUP, KINDS
+
+UTC = datetime.timezone.utc
+
+DAY_START = datetime.time(8, 0)  # assumed working day, local time
+DAY_END = datetime.time(17, 0)
+SLOT = datetime.timedelta(minutes=15)  # appointments start on a quarter hour
+DURATION = {
+    ASSESSMENT: datetime.timedelta(minutes=45),
+    FOLLOWUP: datetime.timedelta(minutes=30),
+}
+GAP_AFTER = {  # therapist's note-writing time after the appointment
+    ASSESSMENT: datetime.timedelta(minutes=15),
+    FOLLOWUP: datetime.timedelta(0),
+}
+MAX_PER_DAY = 8  # therapists' union agreement
+
+
+def _occupied(kind, start):
+    """The UTC interval an appointment of this kind blocks, gap included."""
+    start = start.astimezone(UTC)
+    return start, start + DURATION[kind] + GAP_AFTER[kind]
+
+
+def free_slots(calendar, therapist, day, kind):
+    """Local start times on a local (Auckland) date when a new appointment of this kind could be booked.
+
+    Returns a sorted list of datetime.time. Cancelled appointments are ignored.
+    A therapist already at MAX_PER_DAY gets no slots.
+    """
+    if kind not in KINDS:
+        raise ValueError(f"unknown appointment kind {kind!r}")
+    booked = [a for a in calendar.for_day(therapist.id, day) if a.status != CANCELLED]
+    if len(booked) >= MAX_PER_DAY:
+        return []
+    busy = [_occupied(a.kind, a.start) for a in booked]
+    needed = DURATION[kind] + GAP_AFTER[kind]
+
+    slots = []
+    local = datetime.datetime.combine(day, DAY_START)
+    latest = datetime.datetime.combine(day, DAY_END) - DURATION[kind]
+    while local <= latest:
+        start = local.replace(tzinfo=CLINIC_TZ).astimezone(UTC)
+        end = start + needed
+        if all(end <= busy_start or start >= busy_end for busy_start, busy_end in busy):
+            slots.append(local.time())
+        local += SLOT
+    return slots
diff --git a/tests/test_slots.py b/tests/test_slots.py
new file mode 100644
index 0000000..eb7d194
