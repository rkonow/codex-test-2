+import unittest
+
+from kestrel.intervals import merge_busy
+
+
+class MergeBusyTest(unittest.TestCase):
+    def test_empty_input_gives_empty_output(self):
+        self.assertEqual(merge_busy([]), [])
+
+    def test_disjoint_pairs_are_sorted_and_kept(self):
+        self.assertEqual(merge_busy([(13, 14), (9, 10)]), [(9, 10), (13, 14)])
+
+    def test_overlapping_pairs_merge(self):
+        self.assertEqual(merge_busy([(9, 11), (10, 12)]), [(9, 12)])
+
+    def test_touching_pairs_merge(self):
+        self.assertEqual(merge_busy([(9, 10), (10, 11)]), [(9, 11)])
+
+    def test_contained_pair_does_not_shrink_result(self):
+        self.assertEqual(merge_busy([(9, 12), (10, 11)]), [(9, 12)])
+
+    def test_any_order_gives_same_result(self):
+        pairs = [(13, 15), (9, 10), (14, 16), (10, 11)]
+        self.assertEqual(merge_busy(pairs), [(9, 11), (13, 16)])
+        self.assertEqual(merge_busy(list(reversed(pairs))), [(9, 11), (13, 16)])
+
+    def test_chain_merges_into_one(self):
+        self.assertEqual(merge_busy([(1, 2), (3, 4), (2, 3)]), [(1, 4)])
+
+    def test_input_is_not_modified(self):
+        pairs = [(10, 11), (9, 10)]
+        merge_busy(pairs)
+        self.assertEqual(pairs, [(10, 11), (9, 10)])
+
+
+if __name__ == "__main__":
+    unittest.main()
