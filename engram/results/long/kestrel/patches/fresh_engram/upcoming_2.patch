diff --git a/src/kestrel/calendar.py b/src/kestrel/calendar.py
index d0a45a7..4dbd1d6 100644
--- a/src/kestrel/calendar.py
+++ b/src/kestrel/calendar.py
@@ -65,6 +65,13 @@ class Calendar:
         patient_id = normalize_patient_id(patient_id)
         return [a for a in self.all() if a.patient_id == patient_id]
 
+    def upcoming(self, patient_id, now):
+        """A patient's booked appointments starting after a timezone-aware time, soonest first."""
+        if now.tzinfo is None:
+            raise ValueError("now must be timezone-aware")
+        patient_id = normalize_patient_id(patient_id)
+        return [a for a in self.booked() if a.patient_id == patient_id and a.start > now]
+
     def booked(self):
         return [a for a in self.all() if a.status == BOOKED]
 
diff --git a/tests/test_calendar.py b/tests/test_calendar.py
index 006a515..01a9939 100644
--- a/tests/test_calendar.py
+++ b/tests/test_calendar.py
@@ -140,6 +140,30 @@ class CalendarTest(unittest.TestCase):
             cal.move("a1", datetime.datetime(2027, 3, 2, 9))
         self.assertEqual(cal.get("a1").start, utc(2027, 3, 1, 20))
 
+    def test_upcoming_is_booked_future_appointments_of_patient_soonest_first(self):
+        cal = Calendar([
+            appt("late", utc(2027, 3, 3, 9), patient="KP-000002"),
+            appt("later", utc(2027, 3, 3, 8), patient="KP-000001"),
+            appt("soon", utc(2027, 3, 2, 8), patient="KP-000001"),
+            appt("past", utc(2027, 3, 1, 8), patient="KP-000001"),
+            appt("gone", utc(2027, 3, 2, 9), patient="KP-000001", status="cancelled"),
+        ])
+        now = utc(2027, 3, 1, 12)
+        self.assertEqual([a.id for a in cal.upcoming("KP-000001", now)], ["soon", "later"])
+
+    def test_upcoming_excludes_appointment_starting_exactly_now(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 1, 12), patient="KP-000001")])
+        self.assertEqual(cal.upcoming("KP-000001", utc(2027, 3, 1, 12)), [])
+
+    def test_upcoming_normalises_patient_id(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 2, 8), patient="KP-004211")])
+        self.assertEqual([a.id for a in cal.upcoming(" kp4211 ", utc(2027, 3, 1, 12))], ["a1"])
+
+    def test_upcoming_requires_aware_now(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 2, 8))])
+        with self.assertRaises(ValueError):
+            cal.upcoming("KP-000001", datetime.datetime(2027, 3, 1, 12))
+
 
 if __name__ == "__main__":
     unittest.main()
