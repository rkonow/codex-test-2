+"""Exports for the accountant."""
+
+import csv
+import os
+
+HEADER = ["Number", "Clinic", "Patient ID", "Date", "Description", "Amount"]
+
+
+def format_amount(cents):
+    """Format cents as dollars with two decimals and no dollar sign, e.g. 9500 -> "95.00"."""
+    sign = "-" if cents < 0 else ""
+    dollars, remainder = divmod(abs(cents), 100)
+    return f"{sign}{dollars}.{remainder:02d}"
+
+
+def export_invoices(invoices, year, month, out_dir):
+    """Write the invoices issued in year-month to kestrel-invoices-YYYY-MM.csv in out_dir.
+
+    Returns the path of the file written. Only patient IDs are written, never names.
+    """
+    selected = sorted(
+        (i for i in invoices if i.issued.year == year and i.issued.month == month),
+        key=lambda i: (i.issued, i.number),
+    )
+    path = os.path.join(out_dir, f"kestrel-invoices-{year:04d}-{month:02d}.csv")
+    with open(path, "w", newline="", encoding="utf-8") as f:
+        writer = csv.writer(f)
+        writer.writerow(HEADER)
+        for i in selected:
+            writer.writerow([
+                i.number,
+                i.clinic,
+                i.patient_id,
+                i.issued.strftime("%d/%m/%Y"),
+                i.description,
+                format_amount(i.amount_cents),
+            ])
+    return path
