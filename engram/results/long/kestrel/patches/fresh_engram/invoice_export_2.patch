@@ -0,0 +1,91 @@
+import csv
+import datetime
+import os
+import tempfile
+import unittest
+
+from kestrel.export import export_invoices, format_amount
+from kestrel.invoices import Invoice
+
+
+def invoice(number, issued, amount_cents, patient_id="KP-004211", description="Initial assessment"):
+    return Invoice(
+        number=number,
+        clinic="HB",
+        patient_id=patient_id,
+        patient_name="",
+        issued=issued,
+        amount_cents=amount_cents,
+        description=description,
+    )
+
+
+class FormatAmountTest(unittest.TestCase):
+    def test_whole_and_cents(self):
+        self.assertEqual(format_amount(9500), "95.00")
+        self.assertEqual(format_amount(7005), "70.05")
+        self.assertEqual(format_amount(0), "0.00")
+
+    def test_negative(self):
+        self.assertEqual(format_amount(-1250), "-12.50")
+
+
+class ExportInvoicesTest(unittest.TestCase):
+    def setUp(self):
+        self.dir = tempfile.TemporaryDirectory()
+        self.addCleanup(self.dir.cleanup)
+
+    def read_rows(self, path):
+        with open(path, newline="", encoding="utf-8") as f:
+            return list(csv.reader(f))
+
+    def test_writes_only_invoices_from_the_month(self):
+        invoices = [
+            invoice("INV-HB-2027-00001", datetime.date(2027, 3, 1), 9500),
+            invoice("INV-HB-2027-00002", datetime.date(2027, 2, 28), 7000),
+            invoice("INV-HB-2027-00003", datetime.date(2027, 4, 1), 7000),
+            invoice("INV-HB-2026-00004", datetime.date(2026, 3, 15), 7000),
+        ]
+        path = export_invoices(invoices, 2027, 3, self.dir.name)
+        rows = self.read_rows(path)
+        self.assertEqual(rows[1:], [["INV-HB-2027-00001", "HB", "KP-004211", "01/03/2027",
+                                     "Initial assessment", "95.00"]])
+
+    def test_file_name_and_return_value(self):
+        path = export_invoices([], 2027, 3, self.dir.name)
+        self.assertEqual(path, os.path.join(self.dir.name, "kestrel-invoices-2027-03.csv"))
+        self.assertTrue(os.path.exists(path))
+
+    def test_header_row_and_empty_month(self):
+        path = export_invoices([], 2027, 3, self.dir.name)
+        self.assertEqual(self.read_rows(path), [
+            ["Number", "Clinic", "Patient ID", "Date", "Description", "Amount"],
+        ])
+
+    def test_sorted_by_date_then_number(self):
+        invoices = [
+            invoice("INV-HB-2027-00003", datetime.date(2027, 3, 9), 7000),
+            invoice("INV-HB-2027-00002", datetime.date(2027, 3, 2), 7000),
+            invoice("INV-HB-2027-00001", datetime.date(2027, 3, 2), 7000),
+        ]
+        rows = self.read_rows(export_invoices(invoices, 2027, 3, self.dir.name))[1:]
+        self.assertEqual([r[0] for r in rows],
+                         ["INV-HB-2027-00001", "INV-HB-2027-00002", "INV-HB-2027-00003"])
+
+    def test_description_with_comma_is_quoted(self):
+        invoices = [invoice("INV-HB-2027-00001", datetime.date(2027, 3, 1), 7000,
+                            description="Follow-up, lower back")]
+        rows = self.read_rows(export_invoices(invoices, 2027, 3, self.dir.name))
+        self.assertEqual(rows[1][4], "Follow-up, lower back")
+
+    def test_patient_name_is_not_exported(self):
+        invoices = [Invoice(number="INV-HB-2027-00001", clinic="HB", patient_id="KP-004211",
+                            patient_name="Aroha Test", issued=datetime.date(2027, 3, 1),
+                            amount_cents=7000, description="Follow-up session")]
+        path = export_invoices(invoices, 2027, 3, self.dir.name)
+        with open(path, encoding="utf-8") as f:
+            self.assertNotIn("Aroha", f.read())
+
+
+if __name__ == "__main__":
+    unittest.main()
