 from .calendar import CLINIC_TZ
 from .models import ASSESSMENT, FOLLOWUP
@@ -11,6 +12,29 @@ DESCRIPTIONS = {
     FOLLOWUP: "Follow-up session",
 }
 
+SEQUENCE_LIMIT = 99999
+NUMBER_PATTERN = re.compile(r"^INV-([A-Za-z]+)-(\d{4})-(\d{5})$")
+
+
+def next_invoice_number(clinic, year, existing):
+    """Return the next invoice number for a clinic in a year, e.g. INV-HB-2027-00042.
+
+    The sequence is counted per clinic and restarts at 00001 each year, so only
+    numbers for the same clinic and year count towards it. `existing` may hold
+    numbers for any clinic and year; ones that do not match the format are ignored.
+    """
+    highest = 0
+    for number in existing:
+        match = NUMBER_PATTERN.match(number)
+        if match is None:
+            continue
+        number_clinic, number_year, sequence = match.groups()
+        if number_clinic == clinic and int(number_year) == year:
+            highest = max(highest, int(sequence))
+    if highest >= SEQUENCE_LIMIT:
+        raise ValueError(f"no invoice numbers left for {clinic} in {year}")
+    return f"INV-{clinic}-{year}-{highest + 1:05d}"
+
 
