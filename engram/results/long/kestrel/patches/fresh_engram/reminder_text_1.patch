+"""Text of the SMS reminders sent two days before an appointment."""
+
+from .calendar import CLINIC_TZ
+from .models import CLINICS
+
+
+def reminder_text(appointment):
+    # Privacy: never mention the kind or treatment, only when and where.
+    local = appointment.start.astimezone(CLINIC_TZ)
+    hour = local.hour % 12 or 12
+    meridiem = "am" if local.hour < 12 else "pm"
+    when = f"{hour}{meridiem}" if local.minute == 0 else f"{hour}:{local.minute:02d}{meridiem}"
+    date = f"{local:%A} {local.day} {local:%B}"
+    clinic = CLINICS[appointment.clinic].name
+    return (
+        f"Hi there, this is a friendly reminder of your appointment at {clinic} "
+        f"on {date} at {when}. We look forward to seeing you! "
+        f"If you need to change your booking, please contact the clinic as soon as you can."
+    )
diff --git a/tests/test_reminders.py b/tests/test_reminders.py
new file mode 100644
index 0000000..3877dc8
--- /dev/null
+++ b/tests/test_reminders.py
@@ -0,0 +1,39 @@
+import unittest
+
+from kestrel.calendar import CLINIC_TZ
+from kestrel.reminders import reminder_text
+from helpers import appt, utc
+
+
+class ReminderTextTest(unittest.TestCase):
+    def test_gives_local_date_time_and_clinic_name(self):
+        # 2026-10-14 21:30 UTC is 10:30am on 15 October in Auckland (NZDT, UTC+13)
+        text = reminder_text(appt("A1", utc(2026, 10, 14, 21, 30), clinic="HB"))
+        self.assertIn("Kestrel Physio Harbour", text)
+        self.assertIn("Thursday 15 October", text)
+        self.assertIn("at 10:30am", text)
+
+    def test_whole_hour_and_pm_format(self):
+        text = reminder_text(appt("A1", utc(2026, 10, 14, 3, 0), clinic="NG"))  # 4pm Auckland
+        self.assertIn("at 4pm", text)
+        self.assertIn("Kestrel Physio Northgate", text)
+
+    def test_midnight_and_noon_use_twelve(self):
+        self.assertIn("at 12pm", reminder_text(appt("A1", utc(2026, 10, 13, 23, 0))))  # 12pm Auckland, 14 Oct
+        self.assertIn("at 12am", reminder_text(appt("A1", utc(2026, 10, 13, 11, 0))))  # 12am Auckland, 14 Oct
+
+    def test_never_mentions_kind_or_treatment(self):
+        a = appt("A1", utc(2026, 10, 14, 1, 0), kind="assessment", treatment="lower back pain")
+        text = reminder_text(a)
+        self.assertNotIn("assessment", text.lower())
+        self.assertNotIn("back pain", text.lower())
+        self.assertNotIn("follow", text.lower())
+
+    def test_uses_clinic_timezone_not_utc(self):
+        start = utc(2026, 10, 14, 12, 0)
+        self.assertEqual(start.astimezone(CLINIC_TZ).day, 15)
+        self.assertIn("Thursday 15 October", reminder_text(appt("A1", start)))
+
+
+if __name__ == "__main__":
+    unittest.main()
