+"""Exports for the accountant."""
+
+import csv
+import pathlib
+
+HEADER = ["Invoice number", "Clinic", "Patient ID", "Date", "Description", "Amount"]
+
+
+def export_invoices(invoices, year, month, out_dir):
+    """Write the invoices issued in the given month to a CSV file in out_dir.
+
+    The file is named kestrel-invoices-YYYY-MM.csv and is imported into Xero:
+    dates are DD/MM/YYYY and amounts are dollars with two decimals. Only
+    patient IDs are written, never patient names. Returns the file's path.
+    """
+    rows = sorted(
+        (i for i in invoices if i.issued.year == year and i.issued.month == month),
+        key=lambda i: (i.issued, i.number),
+    )
+    path = pathlib.Path(out_dir) / f"kestrel-invoices-{year:04d}-{month:02d}.csv"
+    with open(path, "w", newline="", encoding="utf-8") as f:
+        writer = csv.writer(f)
+        writer.writerow(HEADER)
+        for i in rows:
+            writer.writerow([
+                i.number,
+                i.clinic,
+                i.patient_id,
+                i.issued.strftime("%d/%m/%Y"),
+                i.description,
+                f"{i.amount_cents // 100}.{i.amount_cents % 100:02d}",
+            ])
+    return path
diff --git a/tests/test_export.py b/tests/test_export.py
