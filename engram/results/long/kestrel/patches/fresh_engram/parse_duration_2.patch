--- /dev/null
+++ b/tests/test_intervals.py
@@ -0,0 +1,41 @@
+import unittest
+
+from kestrel.intervals import parse_duration
+
+
+class ParseDurationTest(unittest.TestCase):
+    def test_minutes(self):
+        self.assertEqual(parse_duration("45m"), 45)
+        self.assertEqual(parse_duration("5m"), 5)
+
+    def test_hours(self):
+        self.assertEqual(parse_duration("1h"), 60)
+        self.assertEqual(parse_duration("2h"), 120)
+
+    def test_hours_and_minutes(self):
+        self.assertEqual(parse_duration("1h30"), 90)
+        self.assertEqual(parse_duration("1h 30m"), 90)
+        self.assertEqual(parse_duration("1h30m"), 90)
+        self.assertEqual(parse_duration("1h 30"), 90)
+        self.assertEqual(parse_duration("1h0"), 60)
+
+    def test_trims_whitespace_and_accepts_capitals(self):
+        self.assertEqual(parse_duration(" 45m\n"), 45)
+        self.assertEqual(parse_duration("1H 30M"), 90)
+
+    def test_rejects_other_input(self):
+        for text in ["", "   ", "45", "m", "h", "45 mins", "1.5h", "-30m", "1h60", "1h 75m",
+                     "0m", "0h", "1 2h", "1h-30", "1:30", "2d", "1h30m5", "abc", "1h 30m 5"]:
+            with self.subTest(text=text):
+                with self.assertRaises(ValueError):
+                    parse_duration(text)
+
+    def test_rejects_non_strings(self):
+        for value in [None, 45, 1.5]:
+            with self.subTest(value=value):
+                with self.assertRaises(ValueError):
+                    parse_duration(value)
+
+
+if __name__ == "__main__":
+    unittest.main()
