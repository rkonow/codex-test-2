+"""Parsing durations as typed at reception."""
+
+import re
+
+_DURATION = re.compile(
+    r"""
+    \s*
+    (?:
+        (?P<hours>\d+)\s*h(?:\s*(?P<hour_minutes>\d+)\s*m?)?
+      | (?P<minutes>\d+)\s*m
+    )
+    \s*
+    """,
+    re.VERBOSE | re.IGNORECASE,
+)
+
+
+def parse_duration(text):
+    """Turn a typed duration such as '45m', '1h', '1h30' or '1h 30m' into minutes.
+
+    Raises ValueError if the input isn't a duration, or if the minutes part
+    after an hour is 60 or more.
+    """
+    if not isinstance(text, str):
+        raise ValueError(f"not a duration: {text!r}")
+    match = _DURATION.fullmatch(text)
+    if match is None:
+        raise ValueError(f"not a duration: {text!r}")
+    if match.group("minutes") is not None:
+        total = int(match.group("minutes"))
+    else:
+        hour_minutes = match.group("hour_minutes")
+        if hour_minutes is not None and int(hour_minutes) >= 60:
+            raise ValueError(f"minutes out of range in duration: {text!r}")
+        total = int(match.group("hours")) * 60 + int(hour_minutes or 0)
+    if total == 0:
+        raise ValueError(f"duration must be positive: {text!r}")
+    return total
diff --git a/tests/test_intervals.py b/tests/test_intervals.py
