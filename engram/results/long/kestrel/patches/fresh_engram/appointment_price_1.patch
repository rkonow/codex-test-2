 """Session prices, in cents."""
 
+import datetime
+
+from kestrel.calendar import CLINIC_TZ
 from kestrel.models import ASSESSMENT, FOLLOWUP
 
 PRICES_CENTS = {
@@ -7,6 +10,15 @@ PRICES_CENTS = {
     FOLLOWUP: 7000,
 }
 
+# New prices apply to appointments on or after this local (Auckland) date.
+NEW_PRICES_FROM = datetime.date(2027, 4, 1)
+NEW_PRICES_CENTS = {
+    ASSESSMENT: 10500,
+    FOLLOWUP: 7800,
+}
+
+CSC_FOLLOWUP_DISCOUNT_PERCENT = 20
+
 
 def session_price(kind):
     """Return the price in cents for a session of the given kind."""
@@ -14,3 +26,29 @@ def session_price(kind):
         return PRICES_CENTS[kind]
     except KeyError:
         raise ValueError(f"unknown kind {kind!r}") from None
+
+
+def _list_price(kind, day):
+    """Return the list price in cents for a kind on a local date."""
+    table = NEW_PRICES_CENTS if day >= NEW_PRICES_FROM else PRICES_CENTS
+    try:
+        return table[kind]
+    except KeyError:
+        raise ValueError(f"unknown kind {kind!r}") from None
+
+
+def appointment_price(appointment, patient):
+    """Return what the patient pays for the appointment, in cents.
+
+    The price is set by the appointment's local (Auckland) date. CSC holders
+    get a discount on follow-ups only.
+    """
+    if appointment.patient_id != patient.id:
+        raise ValueError(
+            f"appointment {appointment.id} is not for patient {patient.id}"
+        )
+    day = appointment.start.astimezone(CLINIC_TZ).date()
+    price = _list_price(appointment.kind, day)
+    if patient.csc and appointment.kind == FOLLOWUP:
+        price = price * (100 - CSC_FOLLOWUP_DISCOUNT_PERCENT) // 100
+    return price
