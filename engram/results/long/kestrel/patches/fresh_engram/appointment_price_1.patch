+from kestrel.models import ASSESSMENT, FOLLOWUP, Appointment, Patient
+from kestrel.pricing import appointment_price, session_price
+
+AUCKLAND = zoneinfo.ZoneInfo("Pacific/Auckland")
+
+
+def appt(kind, start, patient_id="KP-004211"):
+    return Appointment(
+        id="A1",
+        patient_id=patient_id,
+        therapist_id="T1",
+        clinic="HB",
+        start=start,
+        kind=kind,
+    )
+
+
+def patient(csc=False):
+    return Patient(id="KP-004211", name="Test", phone="+64211234567", csc=csc)
+
+
+class AppointmentPriceTest(unittest.TestCase):
+    def before_change(self):
+        return datetime.datetime(2027, 3, 31, 10, 0, tzinfo=AUCKLAND)
+
+    def after_change(self):
+        return datetime.datetime(2027, 4, 1, 10, 0, tzinfo=AUCKLAND)
+
+    def test_old_prices_before_1_april_2027(self):
+        self.assertEqual(appointment_price(appt(ASSESSMENT, self.before_change()), patient()), 9500)
+        self.assertEqual(appointment_price(appt(FOLLOWUP, self.before_change()), patient()), 7000)
+
+    def test_new_prices_from_1_april_2027(self):
+        self.assertEqual(appointment_price(appt(ASSESSMENT, self.after_change()), patient()), 10500)
+        self.assertEqual(appointment_price(appt(FOLLOWUP, self.after_change()), patient()), 7800)
+
+    def test_date_is_taken_in_auckland_time(self):
+        # 31 March 2027 22:00 UTC is already 1 April in Auckland (NZDT, UTC+13).
+        start = datetime.datetime(2027, 3, 31, 22, 0, tzinfo=datetime.timezone.utc)
+        self.assertEqual(appointment_price(appt(FOLLOWUP, start), patient()), 7800)
+
+    def test_csc_gets_20_percent_off_followup_only(self):
+        self.assertEqual(appointment_price(appt(FOLLOWUP, self.before_change()), patient(csc=True)), 5600)
+        self.assertEqual(appointment_price(appt(FOLLOWUP, self.after_change()), patient(csc=True)), 6240)
+        self.assertEqual(appointment_price(appt(ASSESSMENT, self.before_change()), patient(csc=True)), 9500)
+        self.assertEqual(appointment_price(appt(ASSESSMENT, self.after_change()), patient(csc=True)), 10500)
+
+    def test_appointment_for_another_patient_is_rejected(self):
+        with self.assertRaises(ValueError):
+            appointment_price(appt(FOLLOWUP, self.after_change(), patient_id="KP-000001"), patient())
+
+    def test_unknown_kind_is_rejected_by_model(self):
+        # Appointment validates its kind on construction, so pricing never sees one.
+        with self.assertRaises(ValueError):
+            appt("massage", self.after_change())
 
 
 class SessionPriceTest(unittest.TestCase):
