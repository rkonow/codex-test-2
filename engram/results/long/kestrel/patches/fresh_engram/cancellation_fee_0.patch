+"""Cancellation fees, in cents."""
+
+import datetime
+
+from kestrel.models import CANCELLED, NO_SHOW
+from kestrel.pricing import session_price
+
+LATE_CANCELLATION_WINDOW = datetime.timedelta(hours=48)
+
+
+def cancellation_fee(appointment, cancelled_at=None):
+    """Return the fee in cents owed for an appointment that was cancelled or missed.
+
+    A no-show pays the full session price. A cancellation made less than 48 hours
+    before the start pays half the session price; an earlier one pays nothing.
+    """
+    price = session_price(appointment.kind)
+    if appointment.status == NO_SHOW:
+        return price
+    if appointment.status != CANCELLED:
+        raise ValueError(f"no cancellation fee for status {appointment.status!r}")
+    if cancelled_at is None:
+        raise ValueError("cancelled_at is required for a cancelled appointment")
+    if cancelled_at.tzinfo is None:
+        raise ValueError("cancelled_at must be timezone-aware")
+    if appointment.start - cancelled_at < LATE_CANCELLATION_WINDOW:
+        return price // 2
+    return 0
diff --git a/tests/test_fees.py b/tests/test_fees.py
