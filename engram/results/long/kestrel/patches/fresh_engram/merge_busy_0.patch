+import unittest
+
+from kestrel.intervals import merge_busy
+
+
+class MergeBusyTest(unittest.TestCase):
+    def test_empty_input_gives_empty_output(self):
+        self.assertEqual(merge_busy([]), [])
+
+    def test_single_interval_is_returned_as_is(self):
+        self.assertEqual(merge_busy([(1, 2)]), [(1, 2)])
+
+    def test_disjoint_intervals_are_kept_separate(self):
+        self.assertEqual(merge_busy([(5, 6), (1, 2)]), [(1, 2), (5, 6)])
+
+    def test_overlapping_intervals_merge(self):
+        self.assertEqual(merge_busy([(1, 4), (3, 6)]), [(1, 6)])
+
+    def test_touching_intervals_merge(self):
+        self.assertEqual(merge_busy([(1, 3), (3, 5)]), [(1, 5)])
+
+    def test_contained_interval_does_not_shorten_result(self):
+        self.assertEqual(merge_busy([(1, 10), (3, 4)]), [(1, 10)])
+
+    def test_any_order_gives_same_result(self):
+        pairs = [(8, 9), (1, 2), (2, 4), (7, 8), (3, 5)]
+        self.assertEqual(merge_busy(pairs), [(1, 5), (7, 9)])
+        self.assertEqual(merge_busy(list(reversed(pairs))), [(1, 5), (7, 9)])
+
+    def test_input_is_not_modified(self):
+        pairs = [(3, 4), (1, 2)]
+        merge_busy(pairs)
+        self.assertEqual(pairs, [(3, 4), (1, 2)])
+
+
+if __name__ == "__main__":
+    unittest.main()
