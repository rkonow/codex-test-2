+"""Checks run by the booking form before an appointment is saved."""
+
+import datetime
+
+from .calendar import CLINIC_TZ
+from .models import ASSESSMENT, CANCELLED, FOLLOWUP
+
+# Planned booking-form lengths; the booking form is not built yet.
+DURATIONS = {
+    ASSESSMENT: datetime.timedelta(minutes=45),
+    FOLLOWUP: datetime.timedelta(minutes=30),
+}
+
+# Union agreement: at most this many patient appointments per therapist per day.
+MAX_PER_DAY = 8
+
+
+def can_book(calendar, therapist, appointment):
+    """True if the appointment can be added to the calendar for that therapist.
+
+    It must not overlap another live appointment for the same therapist, and the
+    therapist must have fewer than MAX_PER_DAY live appointments on that local
+    (Auckland) date. Cancelled appointments do not count.
+    """
+    if appointment.therapist_id != therapist.id:
+        raise ValueError(f"appointment is for therapist {appointment.therapist_id!r}, not {therapist.id!r}")
+
+    existing = [a for a in calendar.for_therapist(therapist.id) if a.status != CANCELLED]
+    if any(a.id == appointment.id for a in existing):
+        return False
+
+    start = appointment.start
+    end = start + DURATIONS[appointment.kind]
+    for other in existing:
+        other_end = other.start + DURATIONS[other.kind]
+        if other.start < end and start < other_end:
+            return False
+
+    day = start.astimezone(CLINIC_TZ).date()
+    on_day = [a for a in existing if a.start.astimezone(CLINIC_TZ).date() == day]
+    return len(on_day) < MAX_PER_DAY
diff --git a/tests/test_booking.py b/tests/test_booking.py
