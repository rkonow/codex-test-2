@@ -0,0 +1,79 @@
+import dataclasses
+import datetime
+import unittest
+
+from helpers import appt, utc
+from kestrel.booking import MAX_PER_DAY, can_book
+from kestrel.calendar import CLINIC_TZ, Calendar
+from kestrel.models import ASSESSMENT, CANCELLED, Therapist
+
+T1 = Therapist("T1", "Jo", "HB")
+
+
+def local(y, m, d, hh=0, mm=0):
+    return datetime.datetime(y, m, d, hh, mm, tzinfo=CLINIC_TZ)
+
+
+class CanBookTest(unittest.TestCase):
+    def test_empty_calendar(self):
+        self.assertTrue(can_book(Calendar(), T1, appt("new", utc(2027, 3, 1, 20))))
+
+    def test_rejects_exact_clash(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 1, 20))])
+        self.assertFalse(can_book(cal, T1, appt("new", utc(2027, 3, 1, 20))))
+
+    def test_rejects_overlap_with_existing_followup(self):
+        # Existing follow-up runs 20:00-20:30 UTC; a new one at 20:15 overlaps.
+        cal = Calendar([appt("a1", utc(2027, 3, 1, 20))])
+        self.assertFalse(can_book(cal, T1, appt("new", utc(2027, 3, 1, 20, 15))))
+
+    def test_rejects_new_assessment_overlapping_later_booking(self):
+        # New assessment 19:30-20:15 UTC overlaps a follow-up starting at 20:00.
+        cal = Calendar([appt("a1", utc(2027, 3, 1, 20))])
+        self.assertFalse(can_book(cal, T1, appt("new", utc(2027, 3, 1, 19, 30), kind=ASSESSMENT)))
+
+    def test_allows_back_to_back(self):
+        # Follow-up 20:00-20:30; a new one at 20:30 starts as the old one ends.
+        cal = Calendar([appt("a1", utc(2027, 3, 1, 20))])
+        self.assertTrue(can_book(cal, T1, appt("new", utc(2027, 3, 1, 20, 30))))
+        self.assertTrue(can_book(cal, T1, appt("new", utc(2027, 3, 1, 19, 15))))
+
+    def test_other_therapist_does_not_clash(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 1, 20), therapist="T2")])
+        self.assertTrue(can_book(cal, T1, appt("new", utc(2027, 3, 1, 20))))
+
+    def test_cancelled_appointment_does_not_clash(self):
+        cancelled = dataclasses.replace(appt("a1", utc(2027, 3, 1, 20)), status=CANCELLED, cancelled_at=utc(2027, 2, 28))
+        cal = Calendar([cancelled])
+        self.assertTrue(can_book(cal, T1, appt("new", utc(2027, 3, 1, 20))))
+
+    def test_rejects_appointment_already_in_calendar(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 1, 20))])
+        self.assertFalse(can_book(cal, T1, appt("a1", utc(2027, 3, 1, 21))))
+
+    def test_daily_limit(self):
+        # Eight follow-ups on 2027-03-02 local, one per hour from 09:00 with no overlaps.
+        booked = [appt(f"a{i}", local(2027, 3, 2, 9 + i)) for i in range(MAX_PER_DAY)]
+        cal = Calendar(booked)
+        self.assertFalse(can_book(cal, T1, appt("new", local(2027, 3, 2, 17))))
+
+    def test_under_daily_limit(self):
+        booked = [appt(f"a{i}", local(2027, 3, 2, 9 + i)) for i in range(MAX_PER_DAY - 1)]
+        cal = Calendar(booked)
+        self.assertTrue(can_book(cal, T1, appt("new", local(2027, 3, 2, 17))))
+
+    def test_daily_limit_is_per_local_day(self):
+        # Eight on 2027-03-02 local, so the next local day is still open.
+        booked = [appt(f"a{i}", local(2027, 3, 2, 9 + i)) for i in range(MAX_PER_DAY)]
+        cal = Calendar(booked)
+        self.assertTrue(can_book(cal, T1, appt("new", local(2027, 3, 3, 9))))
+
+    def test_cancelled_appointments_do_not_count_towards_daily_limit(self):
+        booked = [appt(f"a{i}", local(2027, 3, 2, 9 + i)) for i in range(MAX_PER_DAY)]
+        booked[0] = dataclasses.replace(booked[0], status=CANCELLED, cancelled_at=utc(2027, 2, 28))
+        cal = Calendar(booked)
+        self.assertTrue(can_book(cal, T1, appt("new", local(2027, 3, 2, 17))))
+
+    def test_rejects_other_therapists_appointment(self):
+        with self.assertRaises(ValueError):
+            can_book(Calendar(), T1, appt("new", utc(2027, 3, 1, 20), therapist="T2"))
