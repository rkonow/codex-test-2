diff --git a/src/kestrel/waitlist.py b/src/kestrel/waitlist.py
index cf8aa92..2673380 100644
--- a/src/kestrel/waitlist.py
+++ b/src/kestrel/waitlist.py
@@ -42,3 +42,13 @@ class Waitlist:
     def entries(self):
         """Every entry in offer order: urgent first, then by when each patient asked."""
         return sorted(self._entries.values(), key=lambda e: (not e.urgent, e.requested_at))
+
+    def next_for(self, kind):
+        """The entry to offer a freed slot of this kind to, or None if nobody is waiting for it.
+
+        The entry stays on the waitlist; call remove() once it is booked.
+        """
+        for entry in self.entries():
+            if entry.kind == kind:
+                return entry
+        return None
diff --git a/tests/test_waitlist.py b/tests/test_waitlist.py
index 7c59374..325baca 100644
--- a/tests/test_waitlist.py
+++ b/tests/test_waitlist.py
@@ -72,6 +72,27 @@ class WaitlistTest(unittest.TestCase):
         wl.add(entry("KP-004211", utc(2027, 3, 5, 8)))
         self.assertEqual([e.requested_at for e in wl.entries()], [utc(2027, 3, 5, 8)])
 
+    def test_next_for_picks_urgent_then_request_order_of_that_kind(self):
+        wl = Waitlist()
+        wl.add(entry("KP-000001", utc(2027, 3, 1, 8), kind="assessment"))
+        wl.add(entry("KP-000002", utc(2027, 3, 1, 7), kind="followup"))
+        wl.add(entry("KP-000003", utc(2027, 3, 1, 9), kind="assessment", urgent=True))
+        wl.add(entry("KP-000004", utc(2027, 3, 1, 6), kind="assessment"))
+        self.assertEqual(wl.next_for("assessment").patient_id, "KP-000003")
+        self.assertEqual(wl.next_for("followup").patient_id, "KP-000002")
+
+    def test_next_for_ignores_other_kinds_and_keeps_entry(self):
+        wl = Waitlist()
+        wl.add(entry("KP-000001", utc(2027, 3, 1, 8), kind="followup"))
+        self.assertEqual(wl.next_for("followup").patient_id, "KP-000001")
+        self.assertEqual(len(wl.entries()), 1)
+
+    def test_next_for_none_when_nobody_waiting_for_kind(self):
+        wl = Waitlist()
+        self.assertIsNone(wl.next_for("assessment"))
+        wl.add(entry("KP-000001", utc(2027, 3, 1, 8), kind="followup"))
+        self.assertIsNone(wl.next_for("assessment"))
+
     def test_entries_is_a_copy(self):
