+class NextInvoiceNumberTest(unittest.TestCase):
+    def test_first_invoice_of_year_is_00001(self):
+        self.assertEqual(next_invoice_number("HB", 2027, []), "INV-HB-2027-00001")
+
+    def test_increments_highest_sequence(self):
+        existing = ["INV-HB-2027-00001", "INV-HB-2027-00041", "INV-HB-2027-00002"]
+        self.assertEqual(next_invoice_number("HB", 2027, existing), "INV-HB-2027-00042")
+
+    def test_sequences_counted_per_clinic(self):
+        existing = ["INV-NG-2027-00007", "INV-WK-2027-00003"]
+        self.assertEqual(next_invoice_number("HB", 2027, existing), "INV-HB-2027-00001")
+
+    def test_sequence_restarts_each_year(self):
+        existing = ["INV-HB-2026-00150"]
+        self.assertEqual(next_invoice_number("HB", 2027, existing), "INV-HB-2027-00001")
+
+    def test_ignores_other_formats(self):
+        existing = ["INV-HB-2027-0042", "INV-HB-2027-000x1", "INV-HB-2027-00005 ", "HB-2027-00099"]
+        self.assertEqual(next_invoice_number("HB", 2027, existing), "INV-HB-2027-00001")
+
+    def test_does_not_match_clinic_code_prefix(self):
+        existing = ["INV-HBX-2027-00009"]
+        self.assertEqual(next_invoice_number("HB", 2027, existing), "INV-HB-2027-00001")
+
+    def test_raises_when_sequence_exhausted(self):
+        existing = ["INV-HB-2027-99999"]
+        with self.assertRaises(ValueError):
+            next_invoice_number("HB", 2027, existing)
+
+
 if __name__ == "__main__":
