+def next_invoice_number(clinic, year, existing):
+    """Return the next invoice number, INV-<clinic>-<year>-<sequence>.
+
+    The sequence is five digits, counted per clinic and restarting at 00001
+    each year. `existing` is every invoice number issued so far, for any
+    clinic and year; numbers for other clinics or years are ignored.
+    """
+    prefix = "INV-{}-{}-".format(clinic, year)
+    highest = 0
+    for number in existing:
+        if number.startswith(prefix) and re.fullmatch(r"[0-9]{5}", number[len(prefix):]):
+            highest = max(highest, int(number[len(prefix):]))
+    if highest >= 99999:
+        raise ValueError("invoice sequence for {} {} is exhausted".format(clinic, year))
+    return "{}{:05d}".format(prefix, highest + 1)
+
