+def next_invoice_number(clinic, year, existing):
+    """Return the next invoice number for a clinic in a year.
+
+    Numbers take the form INV-<clinic>-<year>-<sequence>, with a five-digit
+    sequence counted per clinic and restarting at 00001 each year. `existing`
+    holds every number issued so far, for any clinic and year; only those of
+    this clinic and year count, and anything not in the form is ignored.
+    """
+    pattern = re.compile(r"INV-%s-%s-(\d{5})" % (re.escape(clinic), re.escape(str(year))))
+    highest = 0
+    for number in existing:
+        match = pattern.fullmatch(number)
+        if match:
+            highest = max(highest, int(match.group(1)))
+    if highest >= 99999:
+        raise ValueError("invoice sequence for %s %s is exhausted" % (clinic, year))
+    return "INV-%s-%s-%05d" % (clinic, year, highest + 1)
+
