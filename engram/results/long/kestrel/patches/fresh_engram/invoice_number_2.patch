+class NextInvoiceNumberTest(unittest.TestCase):
+    def test_first_invoice_of_year_is_00001(self):
+        self.assertEqual(next_invoice_number("HB", 2027, []), "INV-HB-2027-00001")
+
+    def test_follows_highest_sequence_for_clinic_and_year(self):
+        existing = ["INV-HB-2027-00001", "INV-HB-2027-00042", "INV-HB-2027-00007"]
+        self.assertEqual(next_invoice_number("HB", 2027, existing), "INV-HB-2027-00043")
+
+    def test_other_clinics_do_not_count(self):
+        existing = ["INV-NG-2027-00009", "INV-WK-2027-00100"]
+        self.assertEqual(next_invoice_number("HB", 2027, existing), "INV-HB-2027-00001")
+
+    def test_restarts_at_00001_in_a_new_year(self):
+        existing = ["INV-HB-2026-00815"]
+        self.assertEqual(next_invoice_number("HB", 2027, existing), "INV-HB-2027-00001")
+
+    def test_ignores_numbers_not_in_the_form(self):
+        existing = ["INV-HB-2027-0004", "INV-HB-2027-000050", "INV-HBX-2027-00009", "INV-HB-27-00009", "xINV-HB-2027-00009"]
+        self.assertEqual(next_invoice_number("HB", 2027, existing), "INV-HB-2027-00001")
+
+    def test_accepts_year_as_string(self):
+        self.assertEqual(next_invoice_number("HB", "2027", ["INV-HB-2027-00002"]), "INV-HB-2027-00003")
+
+    def test_exhausted_sequence_raises(self):
+        with self.assertRaises(ValueError):
+            next_invoice_number("HB", 2027, ["INV-HB-2027-99999"])
+
+
 if __name__ == "__main__":
     unittest.main()
